# Copy to `.env` next to docker-compose.yml. Never commit `.env`.
# Скопировать в `.env` рядом с docker-compose.yml. `.env` в git не попадает.

# Random 32+ chars, signs sessions and tokens. Generate: openssl rand -hex 32
# Случайная строка от 32 символов, подписывает сессии. Генерация: openssl rand -hex 32
SECRET=

# Local: http://localhost:8055   VPS: https://admin.vkus-com.ru
PUBLIC_URL=http://localhost:8055
# Host port of the admin; change only if 8055 is taken / порт админки на хосте
DIRECTUS_PORT=8055

DB_PASSWORD=

# Admin user, created on the first boot only
# Администратор, создаётся только при первом запуске
ADMIN_EMAIL=admin@vkus-com.ru
ADMIN_PASSWORD=

# Mail for invites and password resets. Local dev: leave EMAIL_TRANSPORT=sendmail
# and the rest empty. VPS: EMAIL_TRANSPORT=smtp and fill in the SMTP block.
# Почта для приглашений и сброса пароля. Локаль: sendmail и пустые поля.
# VPS: EMAIL_TRANSPORT=smtp и заполненный блок SMTP.
EMAIL_FROM=noreply@vkus-com.ru
EMAIL_TRANSPORT=sendmail
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=false
