# Copy to `.env` next to docker-compose.yml. Never commit `.env`.
# Скопировать в `.env` рядом с docker-compose.yml. `.env` в git не попадает.

# Random 32+ chars, signs sessions and tokens. Generate: openssl rand -hex 32
# Случайная строка от 32 символов, подписывает сессии. Генерация: openssl rand -hex 32
SECRET=

# Local: http://localhost:8055   VPS: https://admin.vkus-com.ru
PUBLIC_URL=http://localhost:8055
# Host port of the admin; change only if 8055 is taken / порт админки на хосте
DIRECTUS_PORT=8055

DB_PASSWORD=

# Admin user, created on the first boot only
# Администратор, создаётся только при первом запуске
ADMIN_EMAIL=admin@vkus-com.ru
ADMIN_PASSWORD=

# Mail for invites and password resets. Local dev: leave EMAIL_TRANSPORT=sendmail
# and the rest empty. VPS: EMAIL_TRANSPORT=smtp and fill in the SMTP block.
# Почта для приглашений и сброса пароля. Локаль: sendmail и пустые поля.
# VPS: EMAIL_TRANSPORT=smtp и заполненный блок SMTP.
EMAIL_FROM=noreply@vkus-com.ru
EMAIL_TRANSPORT=sendmail
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=false

# Where the site's cart may send orders from (comma-separated). Empty = the
# production site (https://vkus-com.ru, https://www.vkus-com.ru).
# Local: CORS_ORIGIN=http://127.0.0.1:4321,http://localhost:4321
# Откуда корзина сайта может отправлять заказы (через запятую). Пусто — боевой
# сайт. Локально: CORS_ORIGIN=http://127.0.0.1:4321,http://localhost:4321
CORS_ORIGIN=

# Online payment (Alfa-Bank), optional: a value here beats the «Оплата» page of
# the admin. Secrets (password, token, callback key) are safer here than in the
# database. PAY_ENABLED=true|false, PAY_MODE=test|prod, PAY_PROVIDER=alfa|mock.
# Онлайн-оплата (Альфа-Банк), необязательно: значение здесь важнее страницы
# «Оплата» в админке. Секреты (пароль, токен, ключ уведомлений) надёжнее здесь,
# чем в базе. PAY_ENABLED=true|false, PAY_MODE=test|prod, PAY_PROVIDER=alfa|mock.
PAY_ENABLED=
PAY_MODE=
PAY_PROVIDER=
PAY_ALFA_LOGIN=
PAY_ALFA_PASSWORD=
PAY_ALFA_TOKEN=
# test https://alfa.rbsuat.com/payment/rest/ · prod https://pay.alfabank.ru/payment/rest/
# («r-» login: https://payment.alfabank.ru/payment/rest/)
PAY_ALFA_GATEWAY=
PAY_CALLBACK_KEY=
# where the bank returns the guest; empty = the «Адрес сайта» field (https://vkus-com.ru)
PAY_SITE_URL=

# Sign-in to the guest account by phone: the SMS Aero account (smsaero.ru →
# «Настройки» → «API»). Empty — the account page asks to call instead.
# Вход в личный кабинет по телефону: аккаунт SMS Aero (smsaero.ru →
# «Настройки» → «API»). Пусто — кабинет просит позвонить.
SMSAERO_EMAIL=
SMSAERO_API_KEY=
# Local stand only: codes go to the Directus log instead of SMS; with a code
# here every sign-in takes this code. Never `true` in production.
# Только для локального стенда: коды пишутся в лог Directus вместо SMS; с кодом
# здесь каждый вход принимает этот код. На боевом — никогда не `true`.
GUEST_AUTH_DEBUG=false
GUEST_AUTH_DEBUG_CODE=
