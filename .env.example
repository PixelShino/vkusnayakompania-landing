# Copy to .env. Without DIRECTUS_* the site builds from src/data/fixture.json.
# Скопировать в .env. Без DIRECTUS_* сайт собирается из фикстуры.
DIRECTUS_URL=http://localhost:8055
DIRECTUS_TOKEN=
# Yandex Maps JS API key (developer.tech.yandex.ru); empty = iframe widget fallback
# Ключ Яндекс Карт; пусто — запасной iframe-виджет
PUBLIC_YANDEX_MAPS_KEY=
SITE=https://vkus-com.ru