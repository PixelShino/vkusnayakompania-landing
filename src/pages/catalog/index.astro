---
/**
 * Delivery catalog: every section and dish from the admin, a cart kept in the
 * browser and a checkout that leaves an order in Directus for a call-back. The
 * page is static: cards, prices and the search markup are built here, the
 * page script (`catalog.ts`) only adds the cart, the dish window and the form.
 * With an empty catalog the page still builds and says where to order instead.
 * Каталог доставки: все разделы и блюда из админки, корзина в браузере и
 * оформление, которое оставляет заказ в Directus для обратного звонка.
 * Страница статическая: карточки, цены и разметка для поиска собираются
 * здесь, скрипт страницы (`catalog.ts`) только добавляет корзину, окно блюда и
 * форму. С пустым каталогом страница всё равно собирается и говорит, где
 * заказать.
 * The two venues cook different menus: the page shows one at a time (the
 * switch over the menu, `src/lib/venue.ts`), the HTML holds both, so search
 * engines and a page without scripts get the whole menu.
 * Две точки готовят разное меню: страница показывает одну за раз
 * (переключатель над меню, `src/lib/venue.ts`), в HTML — обе, поэтому поиск и
 * страница без скриптов получают всё меню.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import DishCard from '../../components/catalog/DishCard.astro';
import CatalogHelp from '../../components/catalog/CatalogHelp.astro';
import DeliveryFaq from '../../components/catalog/DeliveryFaq.astro';
import SectionTiles from '../../components/catalog/SectionTiles.astro';
import SectionsSheet from '../../components/catalog/SectionsSheet.astro';
import CartDrawer from '../../components/catalog/CartDrawer.astro';
import DishDialog from '../../components/catalog/DishDialog.astro';
import PlaceSwitch from '../../components/catalog/PlaceSwitch.astro';
import VenueText from '../../components/catalog/VenueText.astro';
import { BASE } from '../../lib/base.ts';
import { BRAND } from '../../data/site.ts';
import { getContent, typo } from '../../lib/content.ts';
import { positions, rub } from '../../lib/catalog.ts';
import { FREE_FROM } from '../../lib/delivery.ts';
import { buildDeliveryFaq, faqJsonLd, loadZones } from '../../lib/delivery-faq.ts';
import { DOC, docHref } from '../../lib/pages.ts';
import { CHECKOUT_KEY } from '../../lib/order.ts';
import { countsAt, placesAttr, sectionPlaces, venueCss, venueScript } from '../../lib/venue.ts';
import '../../styles/catalog.css';

const content = await getContent();
const { catalog, settings, places } = content;
const empty = catalog.count === 0;
// the conditions in full: zones, the minimum order, payment, returns
// условия целиком: зоны, минимальный заказ, оплата, возврат
const deliveryHref = docHref(content.pages, DOC.delivery);
// «Вопросы о доставке»: the zones are the ones the cart quotes from; with an
// empty catalog there is no cart to answer about
// «Вопросы о доставке»: зоны — те же, по которым считает корзина; у пустого
// каталога корзины нет, и отвечать не о чем
const faq = empty ? [] : buildDeliveryFaq(content, { zones: await loadZones(), deliveryHref });

const title = `Доставка еды в Самаре — каталог и цены | ${BRAND.name}`;
// the SEO core (23.10.2026): the query, the city and Novokuybyshevsk, 147 chars
// семантическое ядро (23.10.2026): запрос, город и Новокуйбышевск, 147 знаков
const description =
  'Завтраки, супы, горячее, паста, выпечка и торты «Вкусной компании» с доставкой по Самаре и Новокуйбышевску или самовывозом. Оплата онлайн на сайте.';

const site = Astro.site ?? new URL('https://vkus-com.ru');
const page = new URL(`${BASE}catalog/`, site);

// The dish photo search engines get is the card's own 720 px copy: the same
// file the page already ships, so the markup costs no extra encode.
// Фото блюда для поиска — та же копия 720 px, что у карточки: файл уже есть
// на странице, разметка не стоит лишнего кодирования.
const imageOf = async (product: (typeof catalog.categories)[number]['products'][number]) => {
  const photo = product.photo;
  if (!photo || photo.placeholder) return undefined;
  const width = Math.min(photo.width, 720);
  const image = await getImage({
    src: photo.src as ImageMetadata,
    width,
    height: Math.round((photo.height * width) / photo.width),
    format: 'webp',
    quality: 76,
  });
  return new URL(image.src, page).href;
};

let position = 0;
const itemList = await Promise.all(
  catalog.categories.flatMap((category) =>
    category.products.map(async (product) => {
      const url = `${page.href}#p-${product.slug}`;
      const availability = `https://schema.org/${product.available ? 'InStock' : 'OutOfStock'}`;
      const offers =
        product.variants.length > 1
          ? {
              '@type': 'AggregateOffer',
              priceCurrency: 'RUB',
              lowPrice: Math.min(...product.variants.map((v) => v.price)),
              highPrice: Math.max(...product.variants.map((v) => v.price)),
              offerCount: product.variants.length,
              availability,
              url,
            }
          : { '@type': 'Offer', priceCurrency: 'RUB', price: product.price, availability, url };
      return {
        '@type': 'ListItem',
        position: ++position,
        item: {
          '@type': 'Product',
          '@id': url,
          name: product.title,
          sku: String(product.id),
          category: category.title,
          ...(product.description && { description: product.description }),
          ...(product.weight && { weight: product.weight }),
          image: await imageOf(product),
          brand: { '@type': 'Brand', name: BRAND.name },
          offers,
        },
      };
    }),
  ),
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: new URL(BASE, site).href },
        { '@type': 'ListItem', position: 2, name: 'Доставка', item: page.href },
      ],
    },
    ...(empty
      ? []
      : [{ '@type': 'ItemList', name: 'Каталог доставки', numberOfItems: catalog.count, itemListElement: itemList }]),
    ...(faq.length ? [faqJsonLd(faq, page.href)] : []),
  ],
};

// The venues: their ids in the admin's order, what each one cooks. One venue
// (or none) is no choice — no switch, no hiding.
// Точки: id в порядке админки и что готовит каждая. Одна точка (или ни одной)
// — не выбор: нет ни переключателя, ни скрытия.
const venues = places.length > 1 ? places.map((place) => place.id) : [];
const allDishes = catalog.categories.flatMap((category) => category.products);
const say = (counts: Record<number, number>, word = positions) =>
  Object.fromEntries(Object.entries(counts).map(([id, n]) => [id, word(n)]));
const sections = catalog.categories.map((category) => ({
  category,
  where: placesAttr(sectionPlaces(category.products, venues)),
  counts: countsAt(category.products, venues),
}));

// What the page script needs to price the cart and fill the dish window. Image
// addresses are not here: the window borrows them from the card already on the page.
// Что нужно скрипту, чтобы посчитать корзину и заполнить окно блюда. Адресов
// картинок здесь нет: окно берёт их у карточки, которая уже на странице.
const data = {
  products: catalog.categories.flatMap((category) =>
    category.products.map((product) => ({
      id: product.id,
      slug: product.slug,
      title: product.title,
      category: category.title,
      description: product.description ?? null,
      composition: product.composition ?? null,
      weight: product.weight ?? null,
      price: product.price,
      oldPrice: product.oldPrice ?? null,
      variants: product.variants,
      fillings: product.fillings,
      available: product.available,
      badges: product.badges,
      places: product.places,
    })),
  ),
  // names for «Готовят только на …», dish counts for what the switch announces
  // имена для «Готовят только на …», число блюд — для того, что объявит переключатель
  places: venues.length
    ? places.map((place) => ({ id: place.id, name: place.name, dishes: countsAt(allDishes, venues)[place.id] ?? 0 }))
    : [],
};

// the first row of dishes is above the fold on a phone and a desktop alike
// первый ряд блюд виден сразу и на телефоне, и на десктопе
const firstEager = 6;
let rendered = 0;
---

<BaseLayout
  keywords={['доставка еды в самаре', 'доставка еды самара', 'доставка еды в самаре на дом', 'доставка готовой еды в самаре', 'заказать еду самара', 'доставка обедов самара', 'вкусная компания доставка']}
  content={content}
  title={title}
  description={description}
  noindex={empty}
  stickyBar={false}
  landing={false}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} is:inline />
  {/* the venue before the first paint: the other menu is hidden at once, not after the page script
      точка до первой отрисовки: чужое меню спрятано сразу, а не после скрипта страницы */}
  {venues.length > 0 && !empty && <style slot="head" is:inline set:html={venueCss(venues)} />}
  {venues.length > 0 && !empty && <script slot="head" is:inline set:html={venueScript(venues, CHECKOUT_KEY)} />}
  <Header content={content} over={false} cart={!empty} />

  <main id="main" class="cat" tabindex="-1">
    <section class="container cat-head" aria-labelledby="cat-title">
      <nav class="crumbs" aria-label="Вы здесь">
        <a href={BASE}>Главная</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Доставка</span>
      </nav>
      <div class="cat-head__row" data-reveal>
        <span class="mark cat-head__mark" aria-hidden="true"></span>
        <h1 class="display-caps cat-head__title" id="cat-title" tabindex="-1">Доставка еды по Самаре</h1>
        <p class="lead cat-head__lead">
          {
            typo(
              empty
                ? 'Каталог на сайте обновляется. Пока заказать можно по телефону.'
                : venues.length
                  ? 'Всё меню двух наших заведений, от завтраков до праздничных тортов, с доставкой по Самаре или самовывозом.'
                  : 'Всё меню, от завтраков до праздничных тортов, с доставкой по Самаре или самовывозом.',
            )
          }
        </p>
        {/* the venue first, the dishes after (Валерия, 26.10.2026): «сверху» on
            every width, under the lead; the sticky column has a copy for when this
            one is gone over the top
            сначала точка, потом блюда (Валерия, 26.10.2026): «сверху» на любой
            ширине, под лидом; у липкой колонки есть копия на случай, когда этот
            ушёл за верх экрана */}
        {venues.length > 0 && !empty && <PlaceSwitch places={places} id="head" />}

        <ul class="facts" aria-label="Как это работает">
          <li>
            <Icon name="phone" />
            <span><b>Подтверждаем звонком.</b> Перезвоним, уточним состав и время</span>
          </li>
          <li>
            <Icon name="delivery" />
            <span>
              <b>Доставка по Самаре.</b> Стоимость считается по адресу при оформлении, бесплатно от{'\u00a0'}{rub(FREE_FROM)}{
                deliveryHref && (
                  <>
                    {' '}— <a href={deliveryHref}>условия доставки и оплаты</a>
                  </>
                )
              }
            </span>
          </li>
          {
            !venues.length && places.length > 0 && (
              <li>
                <Icon name="pin" />
                <span>
                  <b>Самовывоз:</b> {places.map((place) => place.name).join(' и ')}
                </span>
              </li>
            )
          }
        </ul>
      </div>
    </section>

    {
      empty ? (
        <section class="container cat-empty" aria-label="Каталог пуст">
          <div class="cat-empty__panel">
            <Icon name="cloche" />
            <p class="display cat-empty__title">Каталог скоро появится</p>
            <p>Блюда и цены уже переносим. Заказать можно по телефону — менеджер подскажет, что есть сегодня.</p>
            <div class="cat-empty__actions">
              <a class="btn btn--primary" href={settings.phoneHref}>
                Позвонить {settings.phone}
              </a>
            </div>
          </div>
        </section>
      ) : (
        <SectionTiles catalog={catalog} places={venues} />
        <div class="container cat-layout">
          <aside class="cat-side">
            {/* the copy opens once the head switch is gone over the top: never two in view
                копия раскрывается, когда шапочный ушёл за верх экрана: двух в поле зрения нет */}
            {
              venues.length > 0 && (
                <div class="side-venue" data-side-venue>
                  <div class="side-venue__in">
                    <PlaceSwitch places={places} id="side" variant="side" />
                  </div>
                </div>
              )
            }
            <nav class="cat-nav" aria-label="Разделы каталога" data-cat-nav>
              <ul role="list">
                {sections.map(({ category, where, counts }, i) => (
                  <li data-places={where}>
                    <a href={`#${category.slug}`} data-nav={category.slug} aria-current={i === 0 ? 'true' : undefined}>
                      <span>{category.title}</span>
                      <span class="cat-nav__n tnum" aria-hidden="true">
                        <VenueText all={String(category.products.length)} at={say(counts, String)} />
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>

            <section class="minicart" aria-labelledby="minicart-title" data-minicart>
              <h2 class="label minicart__title" id="minicart-title">Ваш заказ</h2>
              <p class="minicart__empty" data-mc-empty>
                Пока пусто. Нажмите «В корзину» у блюда — оно появится здесь.
              </p>
              <div class="minicart__full" data-mc-full hidden>
                <p class="minicart__sum">
                  <span data-mc-count></span>
                  <b class="tnum" data-mc-total></b>
                </p>
                <button type="button" class="btn btn--primary btn--md btn--block" data-cart-open>
                  <Icon name="bag" />
                  Открыть корзину
                </button>
              </div>
            </section>
          </aside>

          <div class="cat-main">
            {sections.map(({ category, where, counts }) => (
              <section
                class="cat-sec"
                id={category.slug}
                aria-labelledby={`h-${category.slug}`}
                data-sec={category.slug}
                data-places={where}
              >
                <header class="cat-sec__head" data-reveal>
                  <h2 class="display-caps cat-sec__title" id={`h-${category.slug}`} tabindex="-1">
                    {category.title}
                  </h2>
                  <span class="tag cat-sec__n">
                    <VenueText all={positions(category.products.length)} at={say(counts)} />
                  </span>
                  {category.description && <p class="cat-sec__desc">{category.description}</p>}
                </header>
                <ul class="cat-grid" role="list">
                  {category.products.map((product) => (
                    <li data-places={venues.length ? placesAttr(product.places) : undefined}>
                      <DishCard product={product} eager={rendered++ < firstEager} />
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
      )
    }

    <DeliveryFaq items={faq} deliveryHref={deliveryHref} />
    <CatalogHelp content={content} />
    {/* «наверх» appears once the first screen is gone: this mark is where it ends
        «наверх» появляется, когда первый экран ушёл: эта метка — его конец */}
    <span class="totop-mark" aria-hidden="true" data-totop-mark></span>
  </main>

  <Footer content={content} base={BASE} />

  {
    !empty && (
      <>
        <div class="cartbar" data-cartbar hidden>
          <button type="button" class="btn btn--primary cartbar__btn" data-cart-open>
            <span class="cartbar__left">
              <Icon name="bag" />
              <span data-bar-count></span>
            </span>
            <span class="cartbar__right">
              <span class="tnum" data-bar-total></span>
              <span aria-hidden="true">→</span>
            </span>
          </button>
        </div>
        <div class="secbar" data-secbar>
          <button
            type="button"
            class="container secbar__btn"
            data-sheet-open
            aria-haspopup="dialog"
            aria-controls="sections"
            aria-label={`Все разделы. Сейчас: ${catalog.categories[0]?.title ?? ''}`}
          >
            <span class="secbar__now">
              <span class="secbar__mark" aria-hidden="true"></span>
              <span class="secbar__text">
                <span class="secbar__name" data-secbar-name>{catalog.categories[0]?.title}</span>
                {/* whose menu this is: the menus differ, the bar says it under the section
                    чьё это меню: меню разное, строка говорит это под разделом */}
                {
                  venues.length > 0 && (
                    <span class="secbar__venue">
                      <Icon name="pin" />
                      <span data-venue-name>{places[0]?.name}</span>
                    </span>
                  )
                }
              </span>
            </span>
            <span class="secbar__all" aria-hidden="true">
              Разделы
              <Icon name="widget" />
            </span>
          </button>
        </div>
        <button type="button" class="round-btn totop" data-totop aria-label="Наверх, к началу каталога">
          <Icon name="arrow-up" />
        </button>
        <SectionsSheet catalog={catalog} places={venues.length ? places : []} />
        <DishDialog />
        <CartDrawer content={content} />
        <p class="sr-only" aria-live="polite" data-announce></p>
        <script type="application/json" id="catalog-data" set:html={JSON.stringify(data)} is:inline />
      </>
    )
  }
</BaseLayout>

<script>
  import '../../scripts/catalog';
</script>
