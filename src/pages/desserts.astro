---
/**
 * «Корпусные десерты и пирожные в Самаре»: the confectionery's landing. The
 * shelves are the catalog's «Пирожные» (the mousse ones first, by «мусс» in
 * the description — they are the «корпусные» the search asks for),
 * «Конфеты» and the sets; «Где купить» is the showcases of both venues.
 * Texts and numbers come from `src/data/landings-shop.ts`.
 * «Корпусные десерты и пирожные в Самаре»: посадочная страница кондитерской.
 * Полки — разделы каталога «Пирожные» (муссовые первыми, по слову «мусс» в
 * описании — это и есть «корпусные», которые ищут), «Конфеты» и наборы; «Где
 * купить» — витрины обеих точек. Тексты и числа — из
 * `src/data/landings-shop.ts`.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LandingTop from '../components/landing/LandingTop.astro';
import DishShelf from '../components/landing/DishShelf.astro';
import InkBand from '../components/landing/InkBand.astro';
import PlaceRows from '../components/landing/PlaceRows.astro';
import FaqBand from '../components/landing/FaqBand.astro';
import RelatedLinks from '../components/landing/RelatedLinks.astro';
import { dishImages, pageSchema, urlsOf, warnMissing } from '../components/landing/schema.ts';
import { BASE } from '../lib/base.ts';
import { getContent } from '../lib/content.ts';
import {
  directionOf,
  faqLd,
  faqOf,
  introOf,
  itemListLd,
  landingOf,
  printsOf,
  relatedOf,
  seoOf,
  shelvesOf,
} from '../data/landings-shop.ts';
import '../styles/landing.css';

const content = await getContent();
const page = landingOf('desserts');
const seo = seoOf(page, content);
warnMissing(page, seo.missing);

const shelves = shelvesOf('desserts', content);
const faq = faqOf('desserts', content);
const urls = urlsOf(Astro.site, page.path);
const images = await dishImages(
  shelves.flatMap((shelf) => shelf.products),
  urls.url,
);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...(shelves.length ? [itemListLd(urls.url, urls.catalog, seo.h1, shelves, images)] : []),
    ...(faq.length ? [faqLd(urls.url, faq)] : []),
  ],
};
const schema = pageSchema(page, urls, shelves.length ? { mainEntity: { '@id': `${urls.url}#list` } } : {});
const order = shelves[0] ? `${BASE}catalog/#${shelves[0].section.slug}` : `${BASE}catalog/`;
// the print: one dessert from each shelf, the mousse ones first
// оттиск: по десерту с каждой полки, муссовые первыми
const prints = printsOf(shelves.map((shelf) => shelf.products));

// each venue's own words about its showcase: «витрина кондитерской весь день»
// свои слова точки о витрине: «витрина кондитерской весь день»
const notes = Object.fromEntries(
  content.places.map((place) => {
    const clause = (directionOf(place, content)?.text ?? '')
      .split(/[.;,]\s*/)
      .find((part) => /витрин/iu.test(part));
    return [place.id, clause && `${clause.trim().charAt(0).toUpperCase()}${clause.trim().slice(1)}`];
  }),
);
const half = Math.min(2, shelves.length);
---

<BaseLayout
  content={content}
  title={seo.title}
  keywords={page.keywords}
  description={seo.description}
  noindex={shelves.length === 0}
  landing={false}
  ogImage={prints[0]?.photo}
  schema={schema}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} is:inline />
  <Header content={content} over={false} />

  <main id="main" class="ld" tabindex="-1">
    <LandingTop crumb={page.crumb} title={seo.h1} lead={introOf('desserts', content)} dishes={prints}>
      <a class="btn btn--primary" href={order}>Заказать доставку</a>
      <a class="tlink tlink--go" href="#gde-kupit"><span>Где купить</span></a>
    </LandingTop>

    {shelves.slice(0, half).map((shelf, i) => <DishShelf shelf={shelf} eager={i === 0 ? 4 : 0} />)}

    {
      shelves.length > half && (
        <InkBand
          id="dostavka"
          title="Десерты с доставкой"
          text="Всё с этой страницы есть в каталоге: доставка по Самаре или самовывоз из кафе на Садовой и ресторана на Советской Армии."
        >
          <a class="btn btn--light" href={order}>
            Заказать доставку
          </a>
        </InkBand>
      )
    }

    {shelves.slice(half).map((shelf) => <DishShelf shelf={shelf} />)}

    <PlaceRows
      places={content.places}
      id="gde-kupit"
      title="Где купить"
      lead="Витрины кондитерской в обеих точках. Что есть сегодня, подскажут по телефону."
      notes={notes}
    />

    <FaqBand items={faq} title="Вопросы о десертах" />

    <RelatedLinks links={relatedOf('desserts')} />
  </main>

  <Footer content={content} base={BASE} />
</BaseLayout>
