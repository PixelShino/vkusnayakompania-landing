---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Bento from '../components/Bento.astro';
import Cakes from '../components/Cakes.astro';
import Sweets from '../components/Sweets.astro';
import Room from '../components/Room.astro';
import HowToOrder from '../components/HowToOrder.astro';
import Ecosystem from '../components/Ecosystem.astro';
import Reviews from '../components/Reviews.astro';
import About from '../components/About.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main id="main">
    <Hero />
    <Bento />
    <Cakes />
    <Sweets />
    <Room />
    <HowToOrder />
    <Ecosystem />
    <Reviews />
    <About />
    <Contacts />
  </main>
  <Footer />
</BaseLayout>
