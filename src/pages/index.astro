---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Directions from '../components/Directions.astro';
import Afisha from '../components/Afisha.astro';
import Promos from '../components/Promos.astro';
import Menus from '../components/Menus.astro';
import Cakes from '../components/Cakes.astro';
import Gallery from '../components/Gallery.astro';
import Delivery from '../components/Delivery.astro';
import Reviews from '../components/Reviews.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import { getContent } from '../lib/content.ts';

const content = await getContent();
const { afisha, promos, places } = content;
---

<BaseLayout content={content}>
  <Header content={content} />
  <main id="main">
    <Hero content={content} />
    <Directions content={content} />
    <Gallery content={content} />
    {afisha && <Afisha afisha={afisha} />}
    <Promos promos={promos} places={places} />
    <Menus content={content} />
    <Cakes content={content} />
    <Delivery content={content} />
    <Reviews content={content} />
    <Contacts content={content} />
  </main>
  <Footer content={content} />
</BaseLayout>
