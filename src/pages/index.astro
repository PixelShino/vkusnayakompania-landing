---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Bento from '../components/Bento.astro';
import Cakes from '../components/Cakes.astro';
import Sweets from '../components/Sweets.astro';
import Room from '../components/Room.astro';
import HowToOrder from '../components/HowToOrder.astro';
import Ecosystem from '../components/Ecosystem.astro';
import Reviews from '../components/Reviews.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import { getContent } from '../lib/content.ts';

const content = await getContent();
---

<BaseLayout content={content}>
  <Header content={content} />
  <main id="main">
    <Hero content={content} />
    <Bento content={content} />
    <Cakes content={content} />
    <Sweets content={content} />
    <Room content={content} />
    <HowToOrder content={content} />
    <Ecosystem content={content} />
    <Reviews content={content} />
    <Contacts content={content} />
  </main>
  <Footer content={content} />
</BaseLayout>
