---
/**
 * 404: nginx points here (`deploy/nginx/vkus-com.ru.conf`). One screen, the same
 * two actions as everywhere plus the phone — a dead end must still lead somewhere.
 * 404: сюда ведёт nginx. Один экран, те же два действия, что и везде, плюс
 * телефон: тупик всё равно обязан куда-то вести.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BASE } from '../lib/base.ts';
import { CATERING } from '../lib/nav.ts';
import { getContent } from '../lib/content.ts';

const content = await getContent();
const { settings, places } = content;
---

<BaseLayout content={content}>
  <Header content={content} over={false} />
  <main id="main" class="nf" tabindex="-1">
    <div class="container nf__in">
      <p class="kicker">Ошибка 404</p>
      <h1 class="nf__title">Такой страницы нет</h1>
      <p class="lead nf__lead">
        Возможно, адрес набран с опечаткой или страница переехала. Всё о кафе,
        ресторане и кондитерской — на главной, о банкетах и выездных праздниках —
        в разделе <a class="nf__link" href={CATERING}>«Кейтеринг»</a>.
      </p>

      <div class="nf__actions">
        <a class="btn btn--primary" href={BASE}>На главную</a>
        <a class="btn btn--secondary" href={settings.phoneHref}>Позвонить {settings.phone}</a>
      </div>

      <ul class="nf__places">
        {
          places.map((place) => (
            <li>
              <span class="nf__n" aria-hidden="true">
                {place.n}
              </span>
              <a href={`${BASE}#contacts`}>{place.name}</a>
              <span class="nf__kind">{place.kind}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
  <Footer content={content} base={BASE} />
</BaseLayout>

<style>
  /* the catering page used to be a site of its own: old links land here
     кейтеринг раньше был отдельным сайтом: старые ссылки приходят сюда */
  .nf__link {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  /* шапка липкая: без отступа заголовок уезжает под неё */
  .nf {
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--header-h) - 60px);
    padding-block: calc(var(--sec-pad) * 1.2);
  }

  /* 34rem вместе с полями контейнера оставляли ряду кнопок 400 px,
     а ему нужно 406: «На главную» 133 + «Позвонить …» 265 + зазор */
  .nf__in {
    max-width: 38rem;
  }

  .nf__title {
    margin: 6px 0 12px;
    font-size: var(--fs-h1);
    line-height: 1.04;
    letter-spacing: var(--ls-heading);
  }

  /* лид уже ограничен 46ch глобально — здесь только ряд кнопок,
     которому эти 46ch тесны: 133 + 265 + 8 не помещаются в 400 */
  .nf__actions {
    max-width: none;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 26px;
  }

  /* the two places as a short ledger: the number in display antiqua, the
     address underlined, the kind under it — the same row as the contacts
     and the priorities, not a circle badge the site no longer uses
     две точки коротким реестром: номер дисплейной антиквой, адрес
     подчёркнут, тип под ним — та же строка, что в контактах и приоритетах,
     а не кружок-бейдж, которого на сайте больше нет */
  .nf__places {
    margin-top: 34px;
    padding: 0;
    list-style: none;
  }

  .nf__places li {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    column-gap: 10px;
    align-items: baseline;
    padding-block: 14px;
    border-top: 1px solid var(--line);
  }

  .nf__places li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .nf__n {
    grid-row: 1 / span 2;
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1;
    color: var(--terracotta-text);
  }

  .nf__places a {
    grid-column: 2;
    justify-self: start;
    padding-block: 4px;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--line-4);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.16s ease;
  }

  .nf__kind {
    grid-column: 2;
    font-size: 12.5px;
    color: var(--text-4);
  }

  @media (min-width: 768px) {
    .nf__places li {
      grid-template-columns: 40px auto minmax(0, 1fr);
      column-gap: 12px;
    }

    .nf__n {
      grid-row: 1;
      font-size: 26px;
    }

    .nf__places a {
      grid-column: 2;
    }

    .nf__kind {
      grid-column: 3;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .nf__places a:hover {
      text-decoration-color: var(--text);
    }
  }
</style>
