---
/**
 * Menus as three shelf lines on an ink strip under a centred head: name in the
 * display serif, kind beside it, the honesty tag and the PDF button at the
 * right. No numbered circles — the line itself is the row's mark. A direction
 * without a published menu keeps its line.
 * Меню тремя строками-полками на чернильной полосе под заголовком по оси:
 * название антиквой, рядом тип, справа честный ярлык и кнопка PDF. Без
 * кружков-номеров — метка строки сама линия. Направление без меню сохраняет
 * свою строку.
 */
import { menuFor } from '../lib/select';
import { typo, type Content, type Direction } from '../lib/content';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { settings, home, directions, menus } = content;

const KEYS: Direction['key'][] = ['cafe', 'restaurant', 'confectionery'];

// dates come as YYYY-MM-DD; UTC keeps the day from sliding on a western builder
// даты приходят как YYYY-MM-DD; UTC не даёт дню съехать на сборке западнее
const day = (date: string) =>
  new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', timeZone: 'UTC' }).format(
    new Date(`${date}T00:00:00Z`),
  );

const cards = KEYS.map((key) => directions.find((item) => item.key === key))
  .filter((direction) => direction !== undefined)
  .map((direction) => ({ direction, menu: menuFor(menus, direction.id) }));
---

<section class="section strip-ink mn" id="menu">
  <div class="container">
    <div class="head">
      <span class="mark" aria-hidden="true"></span>
      <h2 class="display-caps">Меню</h2>
      {home.menu_text && <p class="lead mn__lead">{typo(home.menu_text)}</p>}
    </div>

    <ul class="mn__list">
      {
        cards.map(({ direction, menu }) => (
          <li class="mn__row">
            <span class="mn__name">
              <h3 class="mn__title display">{direction.title}</h3>
              <span class="mn__kind">{direction.place?.kind ?? 'Пирожные, торты, конфеты'}</span>
            </span>

            <span class="tag mn__tag">
              {/* дата у файла-заглушки соврала бы: под кнопкой пустой лист
                  a date on a stub file would lie: the sheet under the button is blank */}
              {!menu ? 'скоро' : menu.file.placeholder ? 'образец' : `обновлено ${day(menu.updated)}`}
            </span>

            {menu ? (
              <a
                class="btn btn--ghost-light btn--md mn__act"
                href={menu.file.href}
                target="_blank"
                rel="noopener"
              >
                Открыть PDF
              </a>
            ) : (
              <span class="mn__act mn__soon">Меню скоро появится</span>
            )}
          </li>
        ))
      }
    </ul>

    <div class="mn__cta">
      <a class="btn btn--light" href={settings.shop_url} target="_blank" rel="noopener">
        Заказать в приложении
      </a>
    </div>
  </div>
</section>

<style>
  /* hairline of the strip: derived from the cream text, never a hardcoded colour
     волосок полосы: считается от кремового текста, без хардкода цвета */
  .mn {
    --mn-line: color-mix(in srgb, var(--on-ink) 20%, transparent);
  }

  /* лид на чернилах идёт вторым тоном кремового, а не серым с бумаги
     the lead on ink takes the second cream tone, not the paper grey */
  .mn__lead {
    color: var(--on-ink-2);
  }

  .mn__list {
    max-width: 880px;
    margin: 28px auto 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--mn-line);
  }

  /* Phone: name and kind stack, the tag and the button share the second line.
     A grid, not a wrapping flex — on wrap the button fell to the container edge.
     Телефон: название и тип столбиком, ярлык и кнопка делят вторую строку.
     Сетка, а не переносимый flex — на переносе кнопка падала к краю. */
  .mn__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--mn-line);
  }

  .mn__name {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  /* 22 px — нижняя граница Prata: мельче антиква теряет характер
     22 px is the floor for Prata: smaller, the serif loses its character */
  .mn__title {
    font-size: 22px;
    line-height: 1.15;
    color: var(--on-ink);
  }

  .mn__kind {
    font-size: var(--fs-body);
    color: var(--on-ink-2);
  }

  .mn__tag {
    justify-self: start;
  }

  .mn__act {
    justify-self: end;
  }

  /* пустое состояние держит высоту кнопки: строки не пляшут
     the empty state keeps the button's height: rows do not jump */
  .mn__soon {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
    font-weight: 600;
    color: var(--on-ink-2);
  }

  .mn__cta {
    display: flex;
    justify-content: center;
    margin-top: 28px;
  }

  @media (min-width: 768px) {
    /* one line per menu: name and kind on a baseline, tag and button at the right
       одна строка на меню: название и тип по базовой линии, ярлык и кнопка справа */
    .mn__row {
      grid-template-columns: minmax(0, 1fr) auto auto;
      gap: 24px;
      padding: 20px 0;
    }

    .mn__name {
      grid-column: auto;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 2px 14px;
    }

    .mn__title {
      font-size: 24px;
    }

    .mn__tag {
      justify-self: auto;
    }
  }

  @media (min-width: 1200px) {
    .mn__list {
      margin-top: 36px;
    }

    .mn__title {
      font-size: 26px;
    }
  }
</style>
