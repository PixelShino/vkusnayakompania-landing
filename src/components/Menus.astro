---
/**
 * Menus as a split spread (Ballena): the left half is an olive panel with the
 * head pressed to its top-left corner and the shop stamp at its foot, the
 * right half a paper panel that carries the three menus as a printed carte —
 * name in the display face, the kind beside it, the honesty tag and the PDF
 * as an underlined text link. Both halves bleed to the viewport edge; their
 * inner padding lines the content up with the page container. A direction
 * without a published menu keeps its line.
 * Меню разворотом из двух половин (Ballena): слева оливковая панель с
 * заголовком, прижатым к верхнему левому углу, и оттиском магазина у низа,
 * справа бумажная панель с тремя меню печатной картой — название антиквой,
 * рядом тип, честный ярлык и PDF подчёркнутой текстовой ссылкой. Обе половины
 * идут до края окна; внутренний отступ выравнивает содержимое по контейнеру
 * страницы. Направление без меню сохраняет свою строку.
 */
import { menuFor } from '../lib/select';
import Icon from './Icon.astro';
import { typo, type Content, type Direction } from '../lib/content';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { settings, home, directions, menus } = content;

const KEYS: Direction['key'][] = ['cafe', 'restaurant', 'confectionery'];

// dates come as YYYY-MM-DD; UTC keeps the day from sliding on a western builder
// даты приходят как YYYY-MM-DD; UTC не даёт дню съехать на сборке западнее
const day = (date: string) =>
  new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', timeZone: 'UTC' }).format(
    new Date(`${date}T00:00:00Z`),
  );

const cards = KEYS.map((key) => directions.find((item) => item.key === key))
  .filter((direction) => direction !== undefined)
  .map((direction) => ({ direction, menu: menuFor(menus, direction.id) }));
---

<section class="section mn" id="menu">
  <div class="mn__side" data-reveal>
    <span class="mark mn__mark" aria-hidden="true"></span>
    <h2 class="display-caps mn__h">Меню</h2>
    {home.menu_text && <p class="mn__lead">{typo(home.menu_text)}</p>}
    <div class="mn__cta">
      <a class="btn btn--light" href={settings.shop_url} target="_blank" rel="noopener">
        <Icon name="app" class="ico--tilt" />
        Заказать в приложении
      </a>
    </div>
  </div>

  <div class="mn__sheet">
    <ul class="mn__list" data-reveal>
      {
        cards.map(({ direction, menu }) => (
          <li class="mn__row">
            <div class="mn__name">
              <h3 class="mn__title display">{direction.title}</h3>
              <span class="mn__kind">{direction.place?.kind ?? 'Пирожные, торты, конфеты'}</span>
            </div>

            <div class="mn__side-col">
              <span class="tag mn__tag">
                {/* дата у файла-заглушки соврала бы: под кнопкой пустой лист
                    a date on a stub file would lie: the sheet under the link is blank */}
                {!menu ? 'скоро' : menu.file.placeholder ? 'образец' : `обновлено ${day(menu.updated)}`}
              </span>

              {menu ? (
                <a
                  class="tlink tlink--go tlink--out mn__act"
                  href={menu.file.href}
                  target="_blank"
                  rel="noopener"
                >
                  <span>Открыть PDF</span>
                </a>
              ) : (
                <span class="mn__soon">Меню скоро появится</span>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Two halves edge to edge. `--edge` is the distance from the section's edge
     to the page container: each half pads by it so the copy sits on the grid.
     `cqw` — the section is the container, so the unit is its own width and not
     `100vw`, which counts the scrollbar in.
     Две половины от края до края. `--edge` — расстояние от края секции до
     контейнера страницы: каждая половина отступает на него, и текст стоит по
     сетке. `cqw` — контейнер сама секция, единица равна её ширине, а не
     `100vw`, который считает и полосу прокрутки. */
  .mn {
    --edge: max(var(--pad), calc((100cqw - var(--content)) / 2));
    container-type: inline-size;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-block: 0;
  }

  /* the olive panel: the client's olive as one large surface, cream on it 4,65:1
     оливковая панель: олива заказчика одной большой плоскостью, крем на ней 4,65:1 */
  .mn__side {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--sec-pad) var(--pad);
    background: var(--olive);
    color: var(--bg);
    text-align: center;
  }

  .mn__mark {
    color: var(--bg);
  }

  .mn__h {
    margin-top: 18px;
    color: var(--bg);
  }

  .mn__lead {
    max-width: 44ch;
    margin-top: 12px;
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--bg);
  }

  .mn__cta {
    margin-top: 24px;
  }

  /* the paper sheet with the carte; its hairline is the surface's own line
     бумажный лист с картой; волосок — линия самой поверхности */
  .mn__sheet {
    display: flex;
    align-items: center;
    padding: calc(var(--sec-pad) - 8px) var(--pad) var(--sec-pad);
    background: var(--surface);
  }

  .mn__list {
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-4);
  }

  /* Phone: name and kind stack, the tag and the link share the second line.
     Телефон: название и тип столбиком, ярлык и ссылка делят вторую строку. */
  .mn__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line-4);
  }

  .mn__name {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  /* 22 px — нижняя граница Prata: мельче антиква теряет характер
     22 px is the floor for Prata: smaller, the serif loses its character */
  .mn__title {
    font-size: 22px;
    line-height: 1.15;
  }

  .mn__kind {
    font-size: var(--fs-body);
    color: var(--text-2);
  }

  .mn__side-col {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  /* the empty state keeps the link's line height: rows do not jump
     пустое состояние держит высоту строки ссылки: строки не пляшут */
  .mn__soon {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-3);
  }

  @media (min-width: 768px) {
    /* the spread: olive 5 parts, paper 7; the olive copy pressed to its corner
       разворот: олива 5 частей, бумага 7; текст на оливе прижат к своему углу */
    .mn {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .mn__side {
      align-items: flex-start;
      padding: var(--sec-pad) 40px var(--sec-pad) var(--edge);
      text-align: left;
    }

    .mn__mark {
      margin-inline: 0;
    }

    .mn__h {
      margin-top: 16px;
    }

    .mn__lead {
      max-width: 30ch;
    }

    /* the stamp at the foot of the panel: what is left of the height goes above it
       оттиск у низа панели: остаток высоты уходит над ним */
    .mn__cta {
      margin-top: auto;
      padding-top: 40px;
    }

    .mn__sheet {
      padding: var(--sec-pad) var(--edge) var(--sec-pad) 40px;
    }

    /* one line per menu: name and kind on a baseline, the tag and the link right
       одна строка на меню: название и тип по базовой линии, ярлык и ссылка справа */
    .mn__row {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 20px;
      padding: 20px 0;
    }

    .mn__title {
      font-size: 24px;
    }

    .mn__side-col {
      justify-content: flex-end;
      gap: 22px;
    }
  }

  @media (min-width: 1200px) {
    .mn__side {
      padding-right: 64px;
    }

    .mn__sheet {
      padding-left: 64px;
    }

    .mn__row {
      padding: 24px 0;
    }

    .mn__title {
      font-size: 26px;
    }

    .mn__name {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 2px 14px;
    }
  }
</style>
