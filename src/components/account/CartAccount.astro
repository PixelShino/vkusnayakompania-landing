---
/**
 * «Вкусные баллы» in the cart drawer, in four places of it: at the top of the
 * checkout (signed in — who and how many points, the slider «Списать баллы»;
 * signed out — «Войти по номеру, чтобы копить баллы»), in the footer's bill
 * (points, birthday discount; what will be earned under it), as a step of its
 * own (the sign-in without leaving the cart) and on «Заказ принят». Around
 * the delivery address: the saved addresses as chips above the street and
 * «Сохранить адрес в кабинете» under the courier fields (and on «Заказ
 * принят» the line that it was saved). The drawer places each `part` where
 * it belongs; `src/scripts/account-cart.ts` drives them. Without the account
 * (no `PUBLIC_DIRECTUS_URL`, the programme switched off) nothing is drawn
 * and the cart is the plain one.
 * «Вкусные баллы» в выдвижной корзине, в четырёх её местах: вверху
 * оформления (вошёл — кто и сколько баллов, ползунок «Списать баллы»; не
 * вошёл — «Войти по номеру, чтобы копить баллы»), в счёте подвала (баллы,
 * скидка именинника; под счётом — что начислим), отдельным шагом (вход, не
 * выходя из корзины) и на «Заказ принят». Вокруг адреса доставки:
 * сохранённые адреса чипами над улицей и «Сохранить адрес в кабинете» под
 * полями для курьера (и на «Заказ принят» — строка, что адрес сохранён).
 * Корзина ставит каждую `part` на своё место; ведёт их
 * `src/scripts/account-cart.ts`. Без кабинета (нет
 * `PUBLIC_DIRECTUS_URL`, программа выключена) ничего не рисуется — корзина
 * обычная.
 */
import Icon from '../Icon.astro';
import LoginForm from './LoginForm.astro';
import { points } from '../../lib/loyalty.ts';
import { LABEL_PRESETS, LIMIT_MESSAGE } from '../../lib/addresses.ts';
import { NEW_ADDRESS, OWN_LABEL } from '../../lib/cart-addresses.ts';
import type { Content } from '../../lib/content.ts';
import '../../styles/cart-account.css';

interface Props {
  content: Content;
  part: 'checkout' | 'addresses' | 'save-address' | 'summary' | 'earn' | 'login' | 'done' | 'done-address';
}

const { content, part } = Astro.props;
const { loyalty, settings } = content;
const api = (import.meta.env.PUBLIC_DIRECTUS_URL as string | undefined)?.replace(/\/+$/, '') ?? '';
const on = Boolean(api) && loyalty.enabled;
const low = loyalty.tiers[0]?.percent ?? 0;
---

{
  on && part === 'checkout' && (
    <div class="ca" data-cart-account data-api={api} data-program={JSON.stringify(loyalty)}>
      <div class="ca__out" data-ca-out>
        <p class="ca__pitch">
          <Icon name="gift" />
          <span data-ca-pitch>
            {`Войдите по номеру, чтобы копить баллы: ${low} % заказа вернутся на счёт${
              loyalty.signupBonus ? `, а за первый вход — ${points(loyalty.signupBonus)}` : ''
            }.`}
          </span>
        </p>
        <button type="button" class="btn btn--secondary btn--md btn--block" data-ca-login>
          <Icon name="user" />
          Войти по номеру
        </button>
      </div>

      <div class="ca__in" data-ca-in hidden>
        <p class="ca__who">
          <span class="ca__name" data-ca-name></span>
          <span class="ca__bal tnum" data-ca-balance></span>
          <button type="button" class="tlink ca__not-me" data-ca-logout>Не вы?</button>
        </p>
        <p class="ca__loading" data-ca-loading hidden>Загружаем баллы…</p>
        <p class="ca__note" data-ca-discount hidden>
          <Icon name="gift" />
          <span data-ca-discount-text></span>
        </p>

        <div class="ca__spend" data-ca-spend hidden>
          <div class="ca__spend-head">
            <label class="ca__label" for="ca-range">Списать баллы</label>
            <button type="button" class="tlink ca__all" data-ca-all>Все, что можно</button>
          </div>
          <div class="ca__controls">
            <input
              class="ca__range"
              id="ca-range"
              type="range"
              min="0"
              max="0"
              step="1"
              value="0"
              data-ca-range
              aria-describedby="ca-limit"
            />
            <input
              class="ca__num tnum"
              id="ca-num"
              type="number"
              inputmode="numeric"
              min="0"
              max="0"
              step="1"
              value="0"
              data-ca-num
              aria-label="Сколько баллов списать"
              aria-describedby="ca-limit"
            />
          </div>
          <p class="ca__limit" id="ca-limit" data-ca-limit></p>
        </div>
        <p class="ca__note ca__note--quiet" data-ca-zero hidden></p>
      </div>

      <p class="ca__error" data-ca-error role="alert" hidden></p>
    </div>
  )
}

{
  /* the saved addresses above the street: one tap fills the street and the
     courier fields and counts the delivery; «Новый адрес» empties them. The
     chips are drawn by the script once `/me` has come (nothing is saved —
     nothing is shown); native radios with one name walk with the arrows.
     сохранённые адреса над улицей: одно касание ставит улицу и поля для
     курьера и считает доставку; «Новый адрес» их очищает. Чипы рисует
     скрипт, когда пришёл `/me` (ничего не сохранено — ничего не видно);
     нативные радио с одним именем ходят стрелками. */
  on && part === 'addresses' && (
    <div class="ca-addrs" data-ca-addrs hidden>
      <p class="ca-addrs__title" id="ca-addrs-title">Сохранённые адреса</p>
      <div class="ca-addrs__list" role="radiogroup" aria-labelledby="ca-addrs-title" data-ca-addrs-list>
        <label class="ca-addr ca-addr--new">
          <input type="radio" name="saved_address" value={NEW_ADDRESS} />
          <span class="ca-addr__name">
            <Icon name="plus" />
            Новый адрес
          </span>
        </label>
      </div>
    </div>
  )
}

{
  /* under the courier fields, for an address that is not saved yet: the tick,
     then the label chips; five saved — the line where to make room
     под полями для курьера, для ещё не сохранённого адреса: галочка, под ней
     чипы меток; сохранено пять — строка, где освободить место */
  on && part === 'save-address' && (
    <div class="ca-save" data-ca-save hidden>
      <label class="ca-save__check" data-ca-save-row>
        <input type="checkbox" name="save_address" data-ca-save-check />
        <span>Сохранить адрес в кабинете</span>
      </label>
      <div class="ca-save__labels" data-ca-save-labels hidden>
        <p class="ca-save__caption" id="ca-save-caption">Как назвать</p>
        <div class="ca-save__chips" role="radiogroup" aria-labelledby="ca-save-caption">
          {LABEL_PRESETS.map((preset) => (
            <label class="ca-chip" data-ca-preset={preset}>
              <input type="radio" name="save_label" value={preset} />
              <span>{preset}</span>
            </label>
          ))}
          <label class="ca-chip">
            <input type="radio" name="save_label" value={OWN_LABEL} />
            <span>Своя</span>
          </label>
        </div>
        <div class="field ca-save__own" data-ca-save-own hidden>
          <label class="sr-only" for="ca-save-own">Своё название адреса</label>
          <input id="ca-save-own" name="save_label_own" maxlength="24" autocomplete="off" placeholder="Например: Дача, Мама" />
        </div>
      </div>
      <p class="ca-save__limit" data-ca-save-limit hidden>
        <Icon name="info" />
        <span>{LIMIT_MESSAGE}</span>
      </p>
    </div>
  )
}

{
  /* the rows of the bill the points and the birthday take off; the bill
     itself (dishes, delivery, to pay) is the drawer's
     строки счёта, которые снимают баллы и скидка именинника; сам счёт
     (блюда, доставка, к оплате) — у корзины */
  on && part === 'summary' && (
    <>
      <p class="bill__row bill__row--off" data-ca-row="discount" hidden>
        <span>Скидка именинника</span>
        <b class="tnum" data-ca-discount-sum></b>
      </p>
      <p class="bill__row bill__row--off" data-ca-row="points" hidden>
        <span>Баллами</span>
        <b class="tnum" data-ca-points-sum></b>
      </p>
    </>
  )
}

{
  on && part === 'earn' && <p class="ca-earn" data-ca-earn hidden />
}

{
  on && part === 'login' && (
    <section class="drawer__step ca-login" data-step="login" hidden aria-label="Вход по номеру телефона">
      <div class="drawer__scroll">
        <p class="ca-login__lead">
          {`Код придёт на телефон — пароль не нужен. После входа вернём вас к заказу: имя и телефон подставим, баллы можно будет списать.`}
        </p>
        <LoginForm id="cart-login" settings={settings} submitLabel="Войти и вернуться к заказу" />
      </div>
    </section>
  )
}

{
  /* «Заказ принят», under «Куда»: the address went to the account
     «Заказ принят», под «Куда»: адрес ушёл в кабинет */
  on && part === 'done-address' && (
    <span class="done__saved" data-ca-addr-done hidden>
      <Icon name="check" />
      <span data-ca-addr-done-text></span>
    </span>
  )
}

{
  on && part === 'done' && (
    <p class="done__pts" data-ca-done hidden>
      <Icon name="gift" />
      <span data-ca-done-text></span>
    </p>
  )
}
