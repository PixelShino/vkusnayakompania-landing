---
/**
 * Полноэкранный просмотр фото на нативном `<dialog>`: Esc, ловушка фокуса и
 * возврат фокуса на кнопку-источник достаются бесплатно от платформы.
 * Открывается кликом по любому элементу с `data-zoom` (см. `Photo.astro`).
 */
---

<dialog class="lightbox" aria-label="Просмотр фотографии">
  <img class="lightbox__img" alt="" />
  <button type="button" class="lightbox__close" data-lightbox-close aria-label="Закрыть просмотр">
    ×
  </button>
</dialog>

<style>
  .lightbox {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 24px;
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: rgba(24, 21, 18, 0.93);
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox__img {
    width: auto;
    max-width: min(92vw, 1100px);
    max-height: 86vh;
    border-radius: 14px;
    object-fit: contain;
    cursor: zoom-out;
  }

  .lightbox__close {
    position: fixed;
    top: 14px;
    right: 16px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.14);
    color: #f3ede0;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox__close:hover {
    background: rgba(255, 255, 255, 0.24);
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const image = dialog?.querySelector<HTMLImageElement>('.lightbox__img');

  if (dialog && image) {
    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-zoom]');
      if (!trigger) return;
      image.src = trigger.dataset.zoom ?? '';
      image.alt = trigger.dataset.zoomAlt ?? '';
      dialog.showModal();
    });

    // клик по фону или по самому снимку закрывает просмотр
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog || target.closest('[data-lightbox-close]') || target === image) {
        dialog.close();
      }
    });

    // не держим большой файл в памяти после закрытия
    dialog.addEventListener('close', () => image.removeAttribute('src'));
  }
</script>
