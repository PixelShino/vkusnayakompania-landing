---
import Photo from './Photo.astro';
import type { Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { settings } = content;
// витрины десертов в контенте пока нет: секцию закрывают первые торты
const sweets = content.cakes.slice(0, 6);
---

<section class="section" id="sweets">
  <div class="container">
    <div class="section-head">
      <div>
        <h2>Пирожные, конфеты, наборы</h2>
        <p class="lead">
          Витрина обновляется каждое утро. То, что стоит на прилавке, можно просто забрать — или
          привезём.
        </p>
      </div>
      <a
        class="btn btn--secondary btn--sm"
        href={settings.shop_pastry ?? settings.shop_url}
        target="_blank"
        rel="noopener"
      >
        Весь ассортимент
      </a>
    </div>

    <div class="sweets">
      {
        sweets.map((item) => (
          <article>
            <Photo
              photo={item.photo}
              ratio="1 / 1"
              sizes="(min-width: 1200px) 420px, (min-width: 768px) 33vw, 45vw"
            />
            <h3 class="sweets__name">{item.title}</h3>
            <p class="sweets__meta">{item.note}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .sweets {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap);
    margin-top: 26px;
  }

  .sweets__name {
    margin-top: 12px;
    font-size: calc(var(--fs-h3) - 1px);
    line-height: 1.2;
  }

  .sweets__meta {
    margin-top: 4px;
    font-size: 12.5px;
    color: var(--text-4);
  }

  @media (min-width: 768px) {
    .sweets {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
