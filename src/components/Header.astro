---
/**
 * Sticky header. The nav list and both CTAs are written once: on desktop
 * `display: contents` unpacks them into the bar, under 768 the same node
 * becomes the drop-down panel. `header--over` is the desktop-only state where
 * the bar floats over the first screen with no background of its own.
 * Липкая шапка. Список навигации и обе кнопки написаны один раз: на десктопе
 * `display: contents` раскладывает их в строку шапки, под 768 тот же узел
 * становится выпадающей панелью. `header--over` — десктопное состояние, когда
 * шапка лежит поверх первого экрана без собственного фона.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { BRAND } from '../data/site';
import { navFor } from '../lib/nav.ts';
import Icon from './Icon.astro';
import type { Content } from '../lib/content.ts';

interface Props {
  /** `false` там, где под шапкой нет фото: иначе белые буквы лягут на кремовый */
  over?: boolean;
  content: Content;
}

const { content, over = true } = Astro.props;
const { settings } = content;
const nav = navFor(content, over ? '' : '/');
---

<header class:list={['header', { 'header--over': over, 'is-solid': !over }]}>
  <div class="container header__bar">
    <a class="header__logo" href="#top" aria-label={`${BRAND.name} — на главную`}>
      <Image
        src={logo}
        alt={BRAND.name}
        widths={[132, 264]}
        sizes="132px"
        format="avif"
        quality={60}
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <div class="header__panel" id="header-menu">
      <nav class="header__nav" aria-label="Основная навигация">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <div class="header__actions">
        <a class="header__phone" href={settings.phoneHref}>{settings.phone}</a>
        <button type="button" class="btn btn--secondary btn--sm header__book" data-book="Бронь стола">
          <Icon name="chair" class="ico--pop" />
          Забронировать стол
        </button>
        <a
          class="btn btn--primary btn--sm"
          href={settings.shop_url}
          target="_blank"
          rel="noopener"
        >
          <Icon name="delivery" class="ico--go" />
          Заказать доставку
        </a>
      </div>
    </div>

    <a
      class="header__call"
      href={settings.phoneHref}
      aria-label={`Позвонить ${settings.phone}`}
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path
          d="M6.3 3.5h3l1.4 3.6-1.9 1.4a11.5 11.5 0 0 0 5.7 5.7l1.4-1.9 3.6 1.4v3a1.8 1.8 0 0 1-2 1.8A16.3 16.3 0 0 1 4.5 5.5a1.8 1.8 0 0 1 1.8-2Z"
        ></path>
      </svg>
    </a>

    <button
      type="button"
      class="header__burger"
      aria-label="Открыть меню"
      aria-expanded="false"
      aria-controls="header-menu"
    >
      {/* three separate lines, not one `path`: only then do the outer two turn
          into a cross and the middle one leave / три отдельные линии, а не один
          `path`: только так крайние складываются в крест, а средняя уходит */}
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="20" y2="17"></line>
      </svg>
    </button>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--line-3);
  }

  .header__bar {
    display: flex;
    align-items: center;
    gap: 10px;
    height: var(--header-h);
  }

  .header__logo {
    flex: none;
    display: block;
    width: 104px;
    margin-right: auto;
  }

  .header__logo :global(img) {
    width: 100%;
    height: auto;
  }

  /* панель под шапкой; на десктопе её разбирает `display: contents` ниже */
  .header__panel {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100dvh - var(--header-h));
    overflow: auto;
    overscroll-behavior: contain;
    padding: 6px var(--pad) calc(18px + env(safe-area-inset-bottom));
    background: var(--bg);
    border-bottom: 1px solid var(--line-3);
  }

  .header.is-open .header__panel {
    display: block;
  }

  .header__nav {
    display: flex;
    flex-direction: column;
  }

  .header__nav a {
    padding-block: 12px;
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--line-3);
    transition: color 0.16s ease;
  }

  .header__actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 16px;
  }

  .header__actions .btn {
    width: 100%;
    height: 46px;
    font-size: 14px;
  }

  /* на телефоне номер живёт в кнопке-трубке слева от бургера */
  /* цель нажатия 34 px: сам текст 22, паддинг растит зону, не сдвигая строку */
  .header__phone {
    display: none;
    padding-block: 6px;
    margin-block: -6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }

  .header__call,
  .header__burger {
    flex: none;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition-property: scale, background-color;
    transition-duration: 120ms, 0.16s;
    transition-timing-function: var(--ease-out), ease;
  }

  .header__call:active,
  .header__burger:active {
    scale: 0.96;
  }

  /* Open: the outer lines meet in the middle and cross, the middle one goes.
     `transform-box` pins the origin to the `viewBox`, not to each line's own
     bounding box, which is a hairline and would turn them around themselves.
     Раскрыто: крайние линии сходятся в середину и складываются крестом,
     средняя уходит. `transform-box` привязывает начало координат к `viewBox`,
     а не к рамке самой линии — та толщиной в волосок, и линии крутились бы
     вокруг себя. */
  .header__burger line {
    transform-box: view-box;
    transform-origin: 12px 12px;
    transition-property: transform, opacity;
    transition-duration: 220ms;
    transition-timing-function: var(--ease-out);
  }

  .header.is-open .header__burger line:first-child {
    transform: translateY(5px) rotate(45deg);
  }

  .header.is-open .header__burger line:nth-child(2) {
    opacity: 0;
  }

  .header.is-open .header__burger line:last-child {
    transform: translateY(-5px) rotate(-45deg);
  }

  @media (hover: hover) and (pointer: fine) {
    .header__nav a:hover {
      color: var(--terracotta-text);
    }

    .header__call:hover,
    .header__burger:hover {
      background: color-mix(in srgb, var(--text) 6%, transparent);
    }
  }

  @media (min-width: 768px) {
    .header__logo {
      width: 108px;
      margin-right: 0;
    }

    /* оба селектора — чтобы открытое на телефоне меню не осталось панелью
       после поворота или растягивания окна до десктопа */
    .header .header__panel,
    .header.is-open .header__panel {
      display: contents;
    }

    /* Centred between the logo and the actions, caps with tracking: that is
       how the references set navigation (Green Park, Levantine); small text
       pressed to the logo read as a page builder.
       По центру между логотипом и действиями, прописными вразрядку: так
       навигацию ставят референсы (Green Park, Levantine); мелкие пункты,
       прижатые к логотипу, читались конструктором. */
    .header__nav {
      flex-direction: row;
      gap: 14px;
      margin-inline: auto;
    }

    .header__nav a {
      padding-block: 4px;
      font-size: 10.5px;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      white-space: nowrap;
      border-bottom: 1px solid transparent;
      transition: border-color 0.16s ease;
    }

    /* до 1024 в строку не входит: «Главная» дублирует логотип и уходит первой
       under 1024 the row is full: «Главная» duplicates the logo and goes first */
    .header__nav a:first-child {
      display: none;
    }

    .header__actions {
      flex-direction: row;
      align-items: center;
      gap: 10px;
      margin-top: 0;
    }

    /* квадратные, как на первом экране: пилюля здесь единственная выдавала бы
       конструктор
       squared like the first screen's: a pill here would be the one giveaway */
    .header__actions .btn {
      width: auto;
      height: 36px;
      padding-inline: 14px;
      border-radius: var(--r-sq);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .header__book {
      display: none;
    }

    /* до 1200 в строку помещаются логотип, навигация и одно действие,
       поэтому телефон остаётся трубкой: без неё с ноутбука 1024-1199
       позвонить из шапки было нечем */
    .header__burger {
      display: none;
    }

    @media (hover: hover) and (pointer: fine) {
      .header__nav a:hover {
        color: var(--text);
        border-bottom-color: var(--olive);
      }
    }
  }

  @media (min-width: 1024px) {
    .header__logo {
      width: 116px;
    }

    .header__nav {
      gap: 20px;
    }

    .header__nav a {
      display: block;
      font-size: 11px;
      letter-spacing: 0.12em;
    }
  }

  @media (min-width: 1200px) {
    .header__logo {
      width: 132px;
    }

    /* Own left margin, not the row gap: at 1200 the row tightens and the number
       runs straight into «Контакты», reading as one string.
       Собственный отступ слева, а не зазор строки: на 1200 строка ужимается и
       номер упирается в «Контакты», читаясь с ним одной строкой. */
    .header__phone {
      display: block;
      margin-inline: 22px 6px;
    }

    /* с 1200 номер стоит текстом — трубка становится лишней */
    .header__call {
      display: none;
    }

    .header__book {
      display: inline-flex;
    }

    /* с 1200 в строку входит и «Главная» — при чуть меньшем шаге между пунктами
       from 1200 the row has room for «Главная» too, at a slightly tighter step */
    .header__nav {
      gap: 16px;
      margin-inline: 12px auto;
    }

    .header__nav a:first-child {
      display: block;
    }

    .header__actions .btn {
      padding-inline: 12px;
    }
  }

  /* ── прозрачная шапка поверх первого экрана (только десктоп) ───────────── */
  /* The bar floats over the hero photo until the page is scrolled; under 768
     it stays the cream sticky bar, because there the photo starts below it.
     `scripting: enabled` — не украшение: непрозрачной шапку делает скрипт, а без
     него кремовые подписи повисли бы над кремовыми секциями.
     Without scripting nothing would repaint the bar, so the whole state is
     gated on it and the header stays the plain cream one. */
  @media (min-width: 768px) and (scripting: enabled) {
    .header--over {
      position: fixed;
      inset: 0 0 auto;
      transition-property: background-color, border-color;
      transition-duration: 160ms;
      transition-timing-function: ease;
    }

    .header--over .header__logo :global(img) {
      transition: filter 160ms ease;
    }

    /* цвет тоже переходит: без него подписи меняются рывком раньше фона */
    .header--over .header__nav a {
      transition-property: border-color, color;
      transition-duration: 0.16s;
    }

    /* пока первый экран не тронут: фона нет, содержимое живёт по правилам фото */
    .header--over:not(.is-solid) {
      background: transparent;
      border-bottom-color: transparent;
    }

    .header--over:not(.is-solid) .header__nav a,
    .header--over:not(.is-solid) .header__phone {
      color: var(--bg);
    }

    /* логотип — тёмный PNG: на фото белый и кремовый неразличимы */
    .header--over:not(.is-solid) .header__logo :global(img) {
      filter: brightness(0) invert(1);
    }

    /* `btn--ghost-light` и `btn--light` повторены здесь, а не подставлены
       классами: состояние переключает скролл, а не разметка */
    .header--over:not(.is-solid) .header__book {
      background: rgb(255 250 237 / 0.16);
      border-color: rgb(255 250 237 / 0.5);
      color: var(--bg);
    }

    .header--over:not(.is-solid) .header__book:active {
      background: rgb(255 250 237 / 0.3);
    }

    .header--over:not(.is-solid) .header__actions .btn--primary {
      background: var(--bg);
      color: var(--text);
    }

    .header--over:not(.is-solid) .header__actions .btn--primary:active {
      background: var(--surface);
    }

    @media (hover: hover) and (pointer: fine) {
      .header--over:not(.is-solid) .header__nav a:hover {
        color: var(--bg);
        border-bottom-color: var(--bg);
      }

      .header--over:not(.is-solid) .header__book:hover {
        background: rgb(255 250 237 / 0.26);
      }

      .header--over:not(.is-solid) .header__actions .btn--primary:hover {
        background: var(--surface);
      }
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.header');
  const burger = header?.querySelector<HTMLButtonElement>('.header__burger');
  const panel = document.getElementById('header-menu');

  // Порог вместо IntersectionObserver по `#top`: наблюдатель держал бы шапку
  // прозрачной весь первый экран, а верхний скрим героя к тому времени уже
  // уезжает вверх — контраст подписей становится непроверяемым.
  // A threshold, not an observer on `#top`: the hero's top scrim scrolls away
  // long before the section does, and the labels lose their measured contrast.
  if (header) {
    const paint = () => header.classList.toggle('is-solid', window.scrollY > 40);
    paint();
    window.addEventListener('scroll', paint, { passive: true });
  }

  if (header && burger && panel) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
      // страница под раскрытым меню не должна уезжать
      // the page must not scroll under the open menu
      document.body.style.overflow = open ? 'hidden' : '';
      // панель лежит в DOM до бургера: без переноса фокуса Tab пролетает мимо неё
      if (open) panel.querySelector<HTMLElement>('a, button')?.focus();
      else burger.focus();
    };

    // пока меню раскрыто, Tab ходит по кругу внутри панели и бургера
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab' || !header.classList.contains('is-open')) return;
      const stops = [
        ...panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      ].filter((node) => node.offsetParent !== null);
      if (!stops.length) return;
      const ring = [burger, ...stops];
      const i = ring.indexOf(document.activeElement as HTMLElement);
      if (i < 0) return;
      const next = ring[(i + (event.shiftKey ? -1 : 1) + ring.length) % ring.length];
      event.preventDefault();
      next.focus();
    });

    burger.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));

    panel.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest('a, button')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !header.classList.contains('is-open')) return;
      setOpen(false);
      burger.focus();
    });

    // на десктопе панель раскладывается в строку — снимаем блокировку прокрутки
    // the panel unpacks into the bar on desktop — release the scroll lock
    matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
