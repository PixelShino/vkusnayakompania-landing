---
/**
 * Фото витрины. Плейсхолдеры Unsplash отдают любой размер параметром `w`,
 * поэтому srcset собирается из URL — без скачивания и оптимизации на сборке.
 * Когда приедут реальные снимки, здесь меняется только источник: файл из
 * `src/assets/` и `<Image />` из `astro:assets`.
 */
import type { Photo } from '../data/catalog';

interface Props {
  photo: Photo;
  ratio?: string;
  /** пропорция с 768px, если на планшете и десктопе кадр другой */
  ratioMd?: string;
  radius?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const {
  photo,
  ratio = '3 / 4',
  ratioMd,
  radius,
  sizes = '(min-width: 1200px) 320px, (min-width: 768px) 240px, 50vw',
  eager = false,
  class: className = '',
} = Astro.props;

const WIDTHS = [400, 640, 900, 1300, 1800];
const url = (w: number) =>
  `https://images.unsplash.com/photo-${photo.id}?auto=format&fit=crop&q=70&w=${w}`;
const srcset = WIDTHS.map((w) => `${url(w)} ${w}w`).join(', ');
---

<figure
  class:list={['media', className]}
  style={`--ratio:${ratio};${ratioMd ? `--ratio-md:${ratioMd};` : ''}${radius ? `--radius:${radius};` : ''}`}
>
  <img
    src={url(900)}
    srcset={srcset}
    sizes={sizes}
    alt={photo.alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
  <slot />
</figure>
