---
/**
 * Фото витрины. Плейсхолдеры Unsplash отдают любой размер параметром `w`,
 * поэтому srcset собирается из URL — без скачивания и оптимизации на сборке.
 * Если у снимка есть `file` (реальное фото из `src/assets`), рисуем его через
 * `astro:assets`: свой домен, avif и пережатие на сборке.
 */
import { Image } from 'astro:assets';
import { PHOTO_WIDTHS, photoSrcset, photoUrl, type Photo } from '../data/catalog';

interface Props {
  photo: Photo;
  ratio?: string;
  /** пропорция с 768px, если на планшете и десктопе кадр другой */
  ratioMd?: string;
  radius?: string;
  sizes?: string;
  eager?: boolean;
  /** приоритет загрузки: `low` — для кадра, который виден сразу, но не главный */
  priority?: 'high' | 'low';
  class?: string;
}

const {
  photo,
  ratio = '3 / 4',
  ratioMd,
  radius,
  sizes = '(min-width: 1200px) 320px, (min-width: 768px) 240px, 50vw',
  eager = false,
  priority = eager ? 'high' : 'low',
  class: className = '',
} = Astro.props;
---

<figure
  class:list={['media', className]}
  style={`--ratio:${ratio};${ratioMd ? `--ratio-md:${ratioMd};` : ''}${radius ? `--radius:${radius};` : ''}`}
>
  {
    photo.file ? (
      <Image
        src={photo.file}
        alt={photo.alt}
        widths={PHOTO_WIDTHS}
        sizes={sizes}
        format="avif"
        quality={52}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority}
      />
    ) : (
      <img
        src={photoUrl(photo.id, 800)}
        srcset={photoSrcset(photo.id)}
        sizes={sizes}
        alt={photo.alt}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority}
      />
    )
  }
  <slot />
</figure>
