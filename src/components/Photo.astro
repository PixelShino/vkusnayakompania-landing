---
/**
 * Frame from the content: a local file or a Directus URL, both through
 * `astro:assets` — the build resizes them and serves copies from our domain.
 * Кадр из контента: свой файл или адрес Directus — оба идут через
 * `astro:assets`, сборка режет их и отдаёт копии со своего домена.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Img } from '../lib/content.ts';
import { widthsFor } from '../lib/hero.ts';
import { lqip } from '../lib/lqip.ts';

interface Props {
  photo: Img;
  ratio?: string;
  /** пропорция с 768px, если на планшете и десктопе кадр другой */
  ratioMd?: string;
  radius?: string;
  sizes?: string;
  eager?: boolean;
  /** приоритет загрузки: `low` — для кадра, который виден сразу, но не главный */
  priority?: 'high' | 'low';
  class?: string;
}

const {
  photo,
  ratio = '3 / 4',
  ratioMd,
  radius,
  sizes = '(min-width: 1200px) 320px, (min-width: 768px) 240px, 50vw',
  eager = false,
  priority = eager ? 'high' : 'low',
  class: className = '',
} = Astro.props;

// <Image> принимает и адрес, и файл, но типы у него — размеченное объединение:
// при заданных width/height строка безопасна, поэтому сужаем один раз здесь
const src = photo.src as ImageMetadata;

// The blurred preview goes under the frame as a background of the figure: it is
// already in the HTML, so the first paint shows the photo, not the plate.
// Размытое превью уходит фоном самой фигуры: оно уже в HTML, поэтому первая
// отрисовка показывает кадр, а не плашку.
const preview = await lqip(photo.src);
---

<figure
  class:list={['media', className]}
  style={`--ratio:${ratio};${ratioMd ? `--ratio-md:${ratioMd};` : ''}${radius ? `--radius:${radius};` : ''}${preview ? `--lqip:url("${preview}");` : ''}`}
>
  <Image
    src={src}
    alt={photo.alt}
    width={photo.width}
    height={photo.height}
    widths={widthsFor(photo.width)}
    sizes={sizes}
    format="avif"
    quality={52}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority}
  />
  <slot />
</figure>
