---
/**
 * Перелинковка с соседними ресурсами «Вкусной компании»: магазин доставки,
 * сайт кейтеринга и мобильное приложение. Все адреса реальные — см. `site.ts`.
 */
import { ecosystem, site } from '../data/site';
---

<section class="section eco" id="apps">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="kicker">Одна кухня — три способа заказать</p>
        <h2>Что у нас ещё есть</h2>
        <p class="lead">
          Кондитерская — только часть. Ежедневное меню уехало в отдельный магазин, а праздники
          целиком — в кейтеринг.
        </p>
      </div>
    </div>

    <div class="eco__grid">
      {
        ecosystem.map((card) => (
          <article class="eco__card">
            <div class="card-top">
              <span class="eco__kicker">{card.kicker}</span>
              <span class="card-dash" />
              <span class="eco__domain">{card.domain}</span>
            </div>

            <h3 class="eco__title">{card.title}</h3>
            <p class="eco__text">{card.text}</p>

            <ul class="eco__links">
              {card.links.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>

            <div class="eco__foot">
              <a class="btn btn--primary btn--md" href={card.href} target="_blank" rel="noopener">
                {card.cta}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }

      <article class="eco__card eco__card--app">
        <div class="blob" aria-hidden="true"></div>
        <div class="card-top">
          <span class="eco__kicker eco__kicker--light">Приложение</span>
          <span class="card-dash card-dash--light"></span>
          <span class="eco__domain eco__domain--light">iOS · Android</span>
        </div>

        <h3 class="eco__title eco__title--light">Заказывать в два тапа</h3>
        <p class="eco__text eco__text--light">
          История заказов, любимые позиции и статус доставки — в приложении «Вкусная компания».
        </p>

        <div class="eco__foot">
          <div class="eco__stores">
            <a class="btn btn--light btn--md" href={site.links.appIos} target="_blank" rel="noopener">
              App Store
            </a>
            <a
              class="btn btn--light btn--md"
              href={site.links.appAndroid}
              target="_blank"
              rel="noopener"
            >
              Google Play
            </a>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .eco__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--gap) + 2px);
    margin-top: 26px;
    align-items: stretch;
  }

  .eco__card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: calc(var(--gap) + 10px);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--surface);
  }

  .eco__card--app {
    border-color: #7c8250;
    background: var(--olive);
  }

  .eco__kicker {
    padding: 7px 13px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-pill);
    background: var(--bg);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--terracotta-text);
    white-space: nowrap;
  }

  .eco__kicker--light {
    background: rgba(255, 250, 237, 0.18);
    border-color: transparent;
    color: var(--bg);
  }

  .eco__domain {
    font-size: 12px;
    color: var(--text-4);
    white-space: nowrap;
  }

  .eco__domain--light {
    color: rgba(255, 250, 237, 0.72);
  }

  .eco__title {
    position: relative;
    z-index: 1;
    margin: 20px 0 8px;
    font-size: calc(var(--fs-h3) + 3px);
    line-height: 1.12;
  }

  .eco__title--light,
  .eco__text--light {
    color: var(--bg);
  }

  .eco__text {
    position: relative;
    z-index: 1;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--text-2);
  }

  .eco__text--light {
    color: rgba(255, 250, 237, 0.86);
  }

  .eco__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  .eco__links a {
    display: inline-block;
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--bg);
    font-size: 12.5px;
    text-decoration: none;
    transition: border-color 0.16s ease;
  }

  .eco__links a:hover {
    border-color: var(--text);
  }

  .eco__foot {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: 20px;
  }

  .eco__stores {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .eco__stores .btn {
    flex: 1 1 0;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .eco__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
