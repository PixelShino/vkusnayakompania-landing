---
import type { Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

const { settings } = Astro.props.content;

// соседние проекты: ссылки из админки, тексты живут здесь до этапа 4.5
const ecosystem = [
  {
    kicker: 'Доставка',
    title: 'Магазин на каждый день',
    text: 'Завтраки, супы, паста, торты в наличии и пирожные — с доставкой по Самаре или самовывозом. Оплата на сайте.',
    href: settings.shop_url,
    cta: 'Открыть меню',
    domain: 'vkusdostavka.shop',
    links: [
      { label: 'Торты в наличии', href: settings.shop_cakes_ready },
      { label: 'Пирожные', href: settings.shop_pastry },
      { label: 'Завтраки', href: settings.shop_breakfasts },
    ].filter((link) => Boolean(link.href)),
  },
  {
    kicker: 'События',
    title: 'Кейтеринг и банкеты',
    text: 'Фуршет, банкет или праздник под ключ: блюда, обслуживание, оформление и программа. Шесть лет и сотни мероприятий.',
    href: settings.catering_url,
    cta: 'Смотреть услуги',
    domain: 'vkusnayakompania.ru',
    links: [{ label: 'Услуги и форматы', href: settings.catering_services_url }].filter((link) =>
      Boolean(link.href),
    ),
  },
];
---

<section class="section eco" id="apps">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="kicker">Одна кухня — три способа заказать</p>
        <h2>Что у нас ещё есть</h2>
        <p class="lead">
          Кондитерская — только часть. Ежедневное меню уехало в отдельный магазин, а праздники
          целиком — в кейтеринг.
        </p>
      </div>
    </div>

    <div class="eco__grid">
      {
        ecosystem.map((card) => (
          <article class="eco__card">
            <div class="card-top">
              <span class="eco__kicker">{card.kicker}</span>
              <span class="card-dash" />
              <span class="eco__domain">{card.domain}</span>
            </div>

            <h3 class="eco__title">{card.title}</h3>
            <p class="eco__text">{card.text}</p>

            <ul class="eco__links">
              {card.links.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>

            <div class="eco__foot">
              <a class="btn btn--primary btn--md" href={card.href} target="_blank" rel="noopener">
                {card.cta}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }

      <article class="eco__card eco__card--app">
        <div class="blob" aria-hidden="true"></div>
        <div class="card-top">
          <span class="eco__kicker eco__kicker--light">Приложение</span>
          <span class="card-dash card-dash--light"></span>
          <span class="eco__domain eco__domain--light">iOS · Android</span>
        </div>

        <h3 class="eco__title eco__title--light">Заказывать в два тапа</h3>
        <p class="eco__text eco__text--light">
          История заказов, любимые позиции и статус доставки — в приложении «Вкусная компания».
        </p>

        <div class="eco__foot">
          <div class="eco__stores">
            <a class="btn btn--light btn--md" href={settings.app_ios} target="_blank" rel="noopener">
              App Store
            </a>
            <a
              class="btn btn--light btn--md"
              href={settings.app_android}
              target="_blank"
              rel="noopener"
            >
              Google Play
            </a>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .eco__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--gap) + 2px);
    margin-top: 26px;
    align-items: stretch;
  }

  .eco__card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: calc(var(--gap) + 10px);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--surface);
  }

  .eco__card--app {
    border-color: var(--olive);
    background: var(--olive);
  }

  /* киккер и домен не переносятся внутри себя — при нехватке места домен уходит строкой ниже */
  .eco__card .card-top {
    flex-wrap: wrap;
    row-gap: 8px;
  }

  .eco__kicker {
    padding: 7px 13px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-pill);
    background: var(--bg);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--terracotta-text);
    white-space: nowrap;
  }

  .eco__kicker--light {
    background: rgba(28, 25, 22, 0.24);
    border-color: transparent;
    color: var(--bg);
  }

  .eco__domain {
    margin-inline-start: auto;
    font-size: 12px;
    color: var(--text-4);
    white-space: nowrap;
  }

  .eco__domain--light {
    color: var(--bg);
  }

  .eco__title {
    position: relative;
    z-index: 1;
    margin: 20px 0 8px;
    font-size: calc(var(--fs-h3) + 3px);
    line-height: 1.12;
  }

  .eco__title--light {
    color: var(--bg);
  }

  .eco__text {
    position: relative;
    z-index: 1;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--text-2);
  }

  .eco__text--light {
    color: var(--bg);
  }

  .eco__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  .eco__links a {
    display: inline-block;
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--bg);
    font-size: 12.5px;
    text-decoration: none;
    transition: border-color 0.16s ease;
  }

  .eco__links a:hover {
    border-color: var(--text);
  }

  .eco__foot {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: 20px;
  }

  .eco__stores {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .eco__stores .btn {
    flex: 1 1 0;
    min-width: 0;
  }

  /* три колонки душат текст: два ресурса в ряд, приложение — широкой карточкой под ними */
  @media (min-width: 768px) {
    .eco__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .eco__card--app {
      grid-column: span 2;
    }

    .eco__card--app .eco__stores {
      max-width: 420px;
    }
  }

  @media (min-width: 1100px) {
    .eco__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .eco__card--app {
      grid-column: auto;
    }

    .eco__card--app .eco__stores {
      max-width: none;
    }
  }
</style>
