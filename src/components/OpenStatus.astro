---
/**
 * Статус точки: «Открыто до 21:00» / «Откроется в 8:00». Считается в браузере
 * по `Europe/Samara` — на сборке значение протухло бы. До расчёта элемент
 * скрыт, без JS плашки нет.
 *
 * `mode="today"` выводит часы сегодняшнего дня; в HTML лежит будний диапазон,
 * чтобы место было занято до инициализации.
 */
import type { Schedule } from '../data/site';
import { shortTime } from '../data/site';

interface Props {
  schedule: Schedule;
  /** `pill` — плашка статуса, `today` — часы сегодняшнего дня */
  mode?: 'pill' | 'today';
  class?: string;
}

const { schedule, mode = 'pill', class: className = '' } = Astro.props;
const weekday = schedule[1];
---

{
  mode === 'pill' ? (
    <span
      class:list={['card-pill', 'open-pill', className]}
      data-schedule={JSON.stringify(schedule)}
      hidden
    />
  ) : (
    <span class={className} data-schedule={JSON.stringify(schedule)} data-today>
      {shortTime(weekday[0])} — {shortTime(weekday[1])}
    </span>
  )
}

<style>
  .open-pill:not([hidden]) {
    display: inline-block;
  }

  .open-pill.is-open {
    background: var(--olive-tint);
    border-color: var(--olive-tint-line);
    color: var(--olive-dark);
  }
</style>

<script>
  import { openState, shortTime, type Schedule } from '../data/site';

  const WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

  const nodes = document.querySelectorAll<HTMLElement>('[data-schedule]');

  if (nodes.length) {
    // время самой Самары, а не браузера гостя: гость может смотреть из Москвы
    const parts = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Europe/Samara',
      weekday: 'short',
      hour: '2-digit',
      minute: '2-digit',
      hourCycle: 'h23',
    }).formatToParts(new Date());

    const part = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
    const day = WEEKDAYS.indexOf(part('weekday'));
    const now = Number(part('hour')) * 60 + Number(part('minute'));

    if (day >= 0) {
      nodes.forEach((node) => {
        const schedule = JSON.parse(node.dataset.schedule ?? 'null') as Schedule | null;
        if (!schedule?.[day]) return;

        if ('today' in node.dataset) {
          const [open, close] = schedule[day];
          node.textContent = `${shortTime(open)} — ${shortTime(close)}`;
          return;
        }

        const state = openState(schedule, day, now);
        node.textContent = state.label;
        node.classList.toggle('is-open', state.isOpen);
        node.hidden = false;
      });
    }
  }
</script>
