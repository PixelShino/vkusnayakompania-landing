---
/**
 * Reviews with one source of truth: the live Yandex Maps widget. The typed-in
 * score panel and the «positive mentions» bars are gone — they argued with
 * the widget two centimetres away (4,9 · 1085 · 463 against 4,8 · 774 · 472)
 * and went stale in silence. What stays is what the page can vouch for: the
 * award as a line under the head, the venue tabs and the widget itself, wide.
 * Texts are never copied over — authors' rights and the Maps terms forbid it.
 * Отзывы с одним источником правды: живой виджет Яндекс Карт. Вбитая руками
 * панель с оценкой и полоски «доля упоминаний» сняты — они спорили с виджетом
 * в двух сантиметрах (4,9 · 1085 · 463 против 4,8 · 774 · 472) и устаревали
 * молча. Остаётся то, за что страница может поручиться: награда строкой под
 * заголовком, вкладки точек и сам виджет, широкий. Тексты к себе не
 * копируются — права авторов и условия Карт этого не дают.
 */
import { yandexOrgUrl, yandexReviewsUrl } from '../data/site';
import type { Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

const { places, settings } = Astro.props.content;

const STAR =
  'M12 2.6l2.9 5.9 6.5.95-4.7 4.6 1.1 6.45L12 17.5l-5.8 3-1.1-6.45L.4 9.45l6.5-.95L12 2.6z';
---

<section class="section" id="reviews">
  <div class="container">
    <div class="head" data-reveal>
      <span class="mark" aria-hidden="true"></span>
      <h2 class="display-caps">Что говорят гости</h2>
      <p class="lead">
        Ничего не переписываем и не отбираем — ниже живой виджет Яндекс Карт со всеми отзывами,
        как есть.
      </p>
      {
        settings.yandex_award && (
          <p class="whiskers rev__award">
            <span class="tag rev__award-in">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={STAR} />
              </svg>
              {settings.yandex_award} · Яндекс Карты
            </span>
          </p>
        )
      }
    </div>

    <div class="rev">
      {/* one tab per venue: the street alone, the score is the widget's to say
          вкладка на точку: только улица, оценку называет виджет */}
      <div class="tabs rev__tabs" role="group" aria-label="Отзывы по точкам">
        {
          places.map((place, i) => (
            <button
              type="button"
              class="tab rev__tab"
              data-frame-target="reviews"
              data-src={yandexReviewsUrl(place.yandex_org)}
              data-frame-href={`${yandexOrgUrl(place.yandex_org)}reviews/`}
              data-frame-name={place.name}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {place.street}
            </button>
          ))
        }
      </div>

      <div
        class="rev__frame"
        data-frame="reviews"
        data-frame-title="Отзывы о «Вкусной компании» на Яндекс Картах"
        data-src={yandexReviewsUrl(places[0].yandex_org)}
      >
        <p class="rev__frame-stub" data-frame-note>Загружаем отзывы…</p>
        <noscript>
          {/* без JS вкладки не работают: по ссылке на каждую точку */}
          <div class="rev__frame-stub rev__frame-links">
            {
              places.map((place) => (
                <a
                  href={`${yandexOrgUrl(place.yandex_org)}reviews/`}
                  target="_blank"
                  rel="noopener"
                >
                  Отзывы: {place.name}
                </a>
              ))
            }
          </div>
        </noscript>
      </div>

      <p class="rev__frame-note">
        Виджет Яндекс Карт · <a
          data-frame-link="reviews"
          href={`${yandexOrgUrl(places[0].yandex_org)}reviews/`}
          target="_blank"
          rel="noopener">Все отзывы</a
        >
      </p>
    </div>
  </div>
</section>

<style>
  /* the award between whiskers under the lead: a printed line, not a badge
     награда между усами под лидом: печатная строка, а не значок */
  .rev__award {
    margin-top: 18px;
    color: var(--terracotta-text);
  }

  .rev__award-in {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: inherit;
  }

  .rev__award-in svg {
    flex: none;
  }

  /* the widget on the axis, as wide as the menu list — one column, no split
     виджет по оси, шириной как список меню — одна колонка, без раздвоения */
  .rev {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 880px;
    margin: 22px auto 0;
  }

  .rev__tabs {
    justify-content: center;
  }

  /* высота задана снизу: внутри виджета свой скролл, страница не прыгает при
     загрузке кадра */
  .rev__frame {
    position: relative;
    min-height: 460px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-sq);
    background: var(--surface);
  }

  .rev__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .rev__frame-stub {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 13px;
    color: var(--text-4);
    text-decoration: none;
  }

  .rev__frame-links {
    gap: 10px;
    padding-inline: var(--pad);
    text-align: center;
  }

  /* отказ: полосатая подложка читалась бы как «ещё грузится» */
  .rev__frame.is-failed {
    background: var(--surface);
  }

  .rev__frame.is-loaded .rev__frame-stub {
    display: none;
  }

  .rev__frame-note {
    font-size: 12px;
    color: var(--text-5);
    text-align: center;
  }

  /* the link keeps its line; the tap target is 44 px on touch
     ссылка остаётся в строке; зона нажатия на таче 44 px */
  .rev__frame-note a {
    display: inline-block;
    padding-block: 8px;
    margin-block: -8px;
  }

  @media (pointer: coarse) {
    .rev__frame-note a {
      padding-block: 13px;
      margin-block: -13px;
    }
  }

  @media (min-width: 768px) {
    .rev {
      margin-top: 28px;
    }

    .rev__frame {
      min-height: 540px;
    }
  }
</style>

<script>
  import '../scripts/lazy-frame';
</script>
