---
/**
 * Отзывы — настоящие, из официального виджета Яндекс.Карт.
 *
 * Копировать тексты отзывов к себе нельзя (авторские права авторов + условия
 * Яндекс.Карт), поэтому вместо переписанных «отзывов» стоит живой виджет: он
 * сам обновляется и его нельзя подделать. Слева — цифры и награда с карточки
 * организации, они факты и цитируются со ссылкой на источник.
 */
import { places, plural, yandexOrgUrl, yandexReviewsUrl, yandexStats } from '../data/site';
---

<section class="section" id="reviews">
  <div class="container">
    <div class="rev">
      <div class="rev__aside">
        <p class="kicker">Отзывы</p>
        <h2>Что говорят гости</h2>
        <p class="lead">
          Ничего не переписываем и не отбираем — рядом живой виджет Яндекс Карт со всеми отзывами,
          как есть.
        </p>

        <div class="rev__score">
          <div class="blob" aria-hidden="true"></div>
          <div class="card-top">
            <span class="card-mark card-mark--light">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="#FFFAED" aria-hidden="true">
                <path
                  d="M12 2.6l2.9 5.9 6.5.95-4.7 4.6 1.1 6.45L12 17.5l-5.8 3-1.1-6.45L.4 9.45l6.5-.95L12 2.6z"
                ></path>
              </svg>
            </span>
            <span class="card-dash card-dash--light"></span>
            <span class="card-pill card-pill--light">{yandexStats.award}</span>
          </div>

          <div class="rev__big-row">
            <p class="rev__big tnum">{yandexStats.score}</p>
            <div class="rev__stars" aria-hidden="true">
              {
                Array.from({ length: 5 }).map(() => (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="#FFFAED">
                    <path d="M12 2.6l2.9 5.9 6.5.95-4.7 4.6 1.1 6.45L12 17.5l-5.8 3-1.1-6.45L.4 9.45l6.5-.95L12 2.6z" />
                  </svg>
                ))
              }
            </div>
          </div>

          <p class="rev__score-meta">
            {yandexStats.ratings} {plural(yandexStats.ratings, 'оценка', 'оценки', 'оценок')} и{' '}
            {yandexStats.reviews} {plural(yandexStats.reviews, 'отзыв', 'отзыва', 'отзывов')} на
            Яндекс Картах — по двум точкам
          </p>

          <div class="rev__sources">
            {
              places.map((place) => (
                <a
                  class="rev__source"
                  href={`${yandexOrgUrl(place.yandexOrg)}reviews/`}
                  target="_blank"
                  rel="noopener"
                >
                  <span class="rev__source-name">{place.street}</span>
                  <span class="rev__source-score tnum">{place.rating}</span>
                </a>
              ))
            }
          </div>
        </div>

        <ul class="rev__marks">
          {
            yandexStats.highlights.map((mark) => (
              <li class="rev__mark">
                <span class="rev__mark-label">{mark.label}</span>
                <span class="rev__mark-bar" aria-hidden="true">
                  <span class="rev__mark-fill" style={`width:${mark.percent}%`} />
                </span>
                <span class="rev__mark-value tnum">{mark.percent}%</span>
              </li>
            ))
          }
        </ul>
        <p class="rev__marks-note">Доля положительных упоминаний в отзывах — по данным Яндекса</p>
      </div>

      <div class="rev__widget">
        <div class="rev__tabs" role="group" aria-label="Отзывы по точкам">
          {
            places.map((place, i) => (
              <button
                type="button"
                class="rev__tab"
                data-frame-target="reviews"
                data-src={yandexReviewsUrl(place.yandexOrg)}
                data-frame-name={place.addr}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                {place.addr}
                <span class="rev__tab-score tnum">{place.rating}</span>
              </button>
            ))
          }
        </div>

        <div
          class="rev__frame"
          data-frame="reviews"
          data-frame-title="Отзывы о «Вкусной компании» на Яндекс Картах"
          data-src={yandexReviewsUrl(places[0].yandexOrg)}
        >
          <p class="rev__frame-stub">Загружаем отзывы…</p>
          <noscript>
            <a
              class="rev__frame-stub"
              href={`${yandexOrgUrl(places[0].yandexOrg)}reviews/`}
              target="_blank"
              rel="noopener"
            >
              Читать отзывы на Яндекс Картах
            </a>
          </noscript>
        </div>

        <p class="rev__frame-note">
          Виджет Яндекс Карт · <a
            href={`${yandexOrgUrl(places[0].yandexOrg)}reviews/`}
            target="_blank"
            rel="noopener">открыть все отзывы</a
          >
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .rev {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--gap) + 10px);
    align-items: start;
    margin-top: 6px;
  }

  .rev__score {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    margin-top: 22px;
    padding: calc(var(--gap) + 10px);
    border-radius: var(--r-xl);
    background: var(--text);
    color: var(--bg);
  }

  .rev__big-row {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin: 20px 0 8px;
  }

  .rev__big {
    font-weight: var(--fw-heading);
    font-size: 46px;
    line-height: 0.9;
    letter-spacing: -0.02em;
  }

  .rev__stars {
    display: flex;
    gap: 3px;
  }

  .rev__score-meta {
    position: relative;
    z-index: 1;
    font-size: calc(var(--fs-body) - 0.5px);
    line-height: 1.5;
    color: rgba(255, 250, 237, 0.86);
  }

  .rev__sources {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 18px;
  }

  .rev__source {
    flex: 1 1 auto;
    min-width: max-content;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding-inline: 14px;
    border-radius: var(--r-pill);
    background: var(--bg);
    text-decoration: none;
  }

  .rev__source-name {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text);
  }

  .rev__source-score {
    font-weight: var(--fw-heading);
    font-size: 15px;
    line-height: 1;
    color: var(--terracotta-text);
  }

  /* за что хвалят — компактные полоски вместо пилюль: цифра и доля читаются разом */
  .rev__marks {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .rev__mark {
    display: grid;
    grid-template-columns: 74px minmax(0, 1fr) 38px;
    align-items: center;
    gap: 10px;
  }

  .rev__mark-label {
    font-size: 13px;
    color: var(--text-2);
  }

  .rev__mark-bar {
    height: 6px;
    border-radius: var(--r-pill);
    background: var(--line-3);
    overflow: hidden;
  }

  .rev__mark-fill {
    display: block;
    height: 100%;
    border-radius: var(--r-pill);
    background: var(--olive);
  }

  .rev__mark-value {
    font-size: 12.5px;
    font-weight: 600;
    text-align: right;
    color: var(--text-3);
  }

  .rev__marks-note {
    margin-top: 10px;
    font-size: 11.5px;
    color: var(--text-5);
  }

  .rev__widget {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .rev__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .rev__tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--bg);
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 0.16s ease,
      border-color 0.16s ease,
      color 0.16s ease;
  }

  .rev__tab-score {
    color: var(--terracotta-text);
  }

  .rev__tab[aria-pressed='true'] {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }

  .rev__tab[aria-pressed='true'] .rev__tab-score {
    color: rgba(255, 250, 237, 0.72);
  }

  .rev__tab:hover:not([aria-pressed='true']) {
    background: color-mix(in srgb, var(--text) 6%, transparent);
  }

  /* высота фиксированная: внутри виджета свой скролл, а страница не должна
     прыгать, когда кадр наконец подгрузится */
  .rev__frame {
    position: relative;
    height: 460px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--surface);
  }

  .rev__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .rev__frame-stub {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 13px;
    color: var(--text-4);
    text-decoration: none;
  }

  .rev__frame.is-loaded .rev__frame-stub {
    display: none;
  }

  .rev__frame-note {
    font-size: 11.5px;
    color: var(--text-5);
  }

  @media (min-width: 768px) {
    .rev__frame {
      height: 520px;
    }
  }

  @media (min-width: 1000px) {
    .rev {
      grid-template-columns: 0.9fr 1.1fr;
      gap: calc(var(--gap) + 24px);
    }

    .rev__big {
      font-size: 58px;
    }
  }
</style>

<script>
  import '../scripts/lazy-frame';
</script>
