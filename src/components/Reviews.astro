---
/**
 * Reviews: the score panel and the live Yandex widget stand as one composition.
 * Texts are never copied over — authors' rights and the Maps terms forbid it.
 * Отзывы: панель рейтинга и живой виджет Яндекс Карт стоят одной композицией.
 * Тексты к себе не копируются — права авторов и условия Карт этого не дают.
 */
import { plural, yandexOrgUrl, yandexReviewsUrl } from '../data/site';
import type { Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

const { places, settings } = Astro.props.content;
const ratings = settings.yandex_ratings ?? 0;
const reviews = settings.yandex_reviews ?? 0;
// оценки в админке ещё нет — виджет остаётся, а придумывать цифру нечем
const score = settings.yandex_score;
const highlights = settings.yandex_highlights;

// The panel stands on the score or on the marks: with neither there is nothing to show.
// Панель держится на оценке или на долях: нет ни того, ни другого — панели нет.
const hasPanel = Boolean(score) || highlights.length > 0;

const STAR =
  'M12 2.6l2.9 5.9 6.5.95-4.7 4.6 1.1 6.45L12 17.5l-5.8 3-1.1-6.45L.4 9.45l6.5-.95L12 2.6z';
---

<section class="section" id="reviews">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="kicker">Отзывы</p>
        <h2>Что говорят гости</h2>
      </div>
      <p class="lead">
        Ничего не переписываем и не отбираем — рядом живой виджет Яндекс Карт со всеми отзывами,
        как есть.
      </p>
    </div>

    <div class:list={['rev', hasPanel && 'rev--split']}>
      {
        hasPanel && (
          <div class="rev__score">
            <div class="blob" aria-hidden="true" />

            <div class="card-top">
              <span class="card-mark card-mark--light">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={STAR} />
                </svg>
              </span>
              {settings.yandex_award && (
                <span class="card-pill card-pill--light">{settings.yandex_award}</span>
              )}
            </div>

            {score && (
              <div class="rev__big-row">
                <p class="rev__big display tnum">{score}</p>
                <div class="rev__big-meta">
                  <span class="rev__stars" aria-hidden="true">
                    {Array.from({ length: 5 }).map(() => (
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                        <path d={STAR} />
                      </svg>
                    ))}
                  </span>
                  <p class="rev__count tnum">
                    {ratings} {plural(ratings, 'оценка', 'оценки', 'оценок')} · {reviews}{' '}
                    {plural(reviews, 'отзыв', 'отзыва', 'отзывов')}
                  </p>
                  <p class="rev__src">
                    Яндекс Карты · {places.length}{' '}
                    {plural(places.length, 'точка', 'точки', 'точек')}
                  </p>
                </div>
              </div>
            )}

            {highlights.length > 0 && (
              <>
                <ul class="rev__marks">
                  {highlights.map((mark) => (
                    <li class="rev__mark">
                      <span class="rev__mark-label">{mark.label}</span>
                      <span class="rev__mark-bar" aria-hidden="true">
                        <span class="rev__mark-fill" style={`width:${mark.percent}%`} />
                      </span>
                      <span class="rev__mark-value tnum">{mark.percent}%</span>
                    </li>
                  ))}
                </ul>
                <p class="rev__marks-note">Доля положительных упоминаний — по данным Яндекса</p>
              </>
            )}

            <div class="rev__sources">
              {places.map((place) => (
                <a
                  class="rev__source"
                  href={`${yandexOrgUrl(place.yandex_org)}reviews/`}
                  target="_blank"
                  rel="noopener"
                >
                  <span class="rev__source-name">{place.street}</span>
                  {place.rating && <span class="rev__source-score tnum">{place.rating}</span>}
                </a>
              ))}
            </div>
          </div>
        )
      }

      <div class="rev__widget">
        <div class="rev__tabs" role="group" aria-label="Отзывы по точкам">
          {
            places.map((place, i) => (
              <button
                type="button"
                class="rev__tab"
                data-frame-target="reviews"
                data-src={yandexReviewsUrl(place.yandex_org)}
                data-frame-href={`${yandexOrgUrl(place.yandex_org)}reviews/`}
                data-frame-name={place.name}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                {place.name}
                {place.rating && <span class="rev__tab-score tnum">{place.rating}</span>}
              </button>
            ))
          }
        </div>

        <div
          class="rev__frame"
          data-frame="reviews"
          data-frame-title="Отзывы о «Вкусной компании» на Яндекс Картах"
          data-src={yandexReviewsUrl(places[0].yandex_org)}
        >
          <p class="rev__frame-stub" data-frame-note>Загружаем отзывы…</p>
          <noscript>
            {/* без JS вкладки не работают: по ссылке на каждую точку */}
            <div class="rev__frame-stub rev__frame-links">
              {
                places.map((place) => (
                  <a
                    href={`${yandexOrgUrl(place.yandex_org)}reviews/`}
                    target="_blank"
                    rel="noopener"
                  >
                    Отзывы: {place.name}
                  </a>
                ))
              }
            </div>
          </noscript>
        </div>

        <p class="rev__frame-note">
          Виджет Яндекс Карт · <a
            data-frame-link="reviews"
            href={`${yandexOrgUrl(places[0].yandex_org)}reviews/`}
            target="_blank"
            rel="noopener">Все отзывы</a
          >
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .rev {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    /* stretch: the panel and the widget end on one line, no gap under either
       stretch: панель и виджет кончаются на одной линии, дыры под ними нет */
    align-items: stretch;
    gap: var(--gap);
    margin-top: 18px;
  }

  .rev__score {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 20px;
    border-radius: var(--r-xl);
    background: var(--olive);
    /* на оливковой заливке текст только непрозрачный кремовый: 0,86 даёт 3,9:1 */
    color: var(--bg);
  }

  .rev__big-row {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 6px 16px;
    margin-top: 18px;
  }

  .rev__big {
    font-size: clamp(64px, 8.4vw, 88px);
    line-height: 0.86;
  }

  .rev__big-meta {
    flex: 1 1 180px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .rev__stars {
    display: flex;
    gap: 3px;
    margin-bottom: 2px;
  }

  .rev__count {
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: 1.3;
  }

  .rev__src {
    font-size: 12px;
    line-height: 1.3;
  }

  /* полоски вместо пилюль: название и доля читаются разом. Список тянется на
     свободную высоту панели — иначе под ним оставалась пустая зона */
  .rev__marks {
    position: relative;
    z-index: 1;
    display: grid;
    flex: 1 1 auto;
    align-content: space-between;
    gap: 10px 24px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .rev__mark {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) 38px;
    align-items: center;
    gap: 10px;
  }

  .rev__mark-label {
    font-size: 13.5px;
  }

  .rev__mark-bar {
    height: 8px;
    border-radius: var(--r-pill);
    /* подложка темнее заливки: светлая полупрозрачная сливалась бы с оливой */
    background: color-mix(in srgb, var(--text) 26%, transparent);
    overflow: hidden;
  }

  .rev__mark-fill {
    display: block;
    height: 100%;
    border-radius: var(--r-pill);
    background: var(--bg);
  }

  .rev__mark-value {
    font-size: 12.5px;
    font-weight: 600;
    text-align: right;
  }

  .rev__marks-note {
    position: relative;
    z-index: 1;
    margin-top: 10px;
    font-size: 11.5px;
  }

  .rev__sources {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 20px;
  }

  .rev__source {
    flex: 1 1 auto;
    min-width: max-content;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding-inline: 14px;
    border-radius: var(--r-pill);
    background: var(--bg);
    text-decoration: none;
    transition:
      scale 120ms var(--ease-out),
      background-color 0.16s ease;
  }

  .rev__source:active {
    scale: 0.96;
  }

  .rev__source-name {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text);
  }

  .rev__source-score {
    font-weight: var(--fw-heading);
    font-size: 15px;
    line-height: 1;
    color: var(--terracotta-text);
  }

  .rev__widget {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .rev__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .rev__tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 15px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--bg);
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    transition-property: scale, background-color, border-color, color;
    transition-duration: 120ms, 0.16s, 0.16s, 0.16s;
    transition-timing-function: var(--ease-out), ease, ease, ease;
  }

  .rev__tab:active {
    scale: 0.96;
  }

  .rev__tab-score {
    color: var(--terracotta-text);
  }

  .rev__tab[aria-pressed='true'] {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }

  .rev__tab[aria-pressed='true'] .rev__tab-score {
    color: inherit;
  }

  @media (hover: hover) and (pointer: fine) {
    .rev__tab:hover:not([aria-pressed='true']) {
      background: var(--surface);
      border-color: var(--line-4);
    }

    .rev__source:hover {
      background: var(--surface);
    }
  }

  /* высота задана снизу: внутри виджета свой скролл, страница не прыгает при
     загрузке кадра, а `flex: 1` дотягивает кадр до низа панели рейтинга */
  .rev__frame {
    position: relative;
    flex: 1;
    min-height: 460px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--surface);
  }

  .rev__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .rev__frame-stub {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 13px;
    color: var(--text-4);
    text-decoration: none;
  }

  .rev__frame-links {
    gap: 10px;
    padding-inline: var(--pad);
    text-align: center;
  }

  /* отказ: полосатая подложка читалась бы как «ещё грузится» */
  .rev__frame.is-failed {
    background: var(--surface);
  }

  .rev__frame.is-loaded .rev__frame-stub {
    display: none;
  }

  .rev__frame-note {
    font-size: 12px;
    color: var(--text-5);
  }

  /* the link keeps its line but gets a 30 px tap target / ссылка остаётся в строке, зона нажатия 30 px */
  .rev__frame-note a {
    display: inline-block;
    padding-block: 8px;
    margin-block: -8px;
  }

  @media (min-width: 768px) {
    .rev {
      margin-top: 22px;
    }

    .rev__score {
      padding: 24px;
    }

    /* планшет: панель во всю ширину, доли в две колонки — иначе она вытягивается
       столбиком и под ней остаётся пустое поле */
    .rev__marks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rev__frame {
      min-height: 520px;
    }
  }

  @media (min-width: 1200px) {
    .rev--split {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
      gap: calc(var(--gap) + 8px);
    }

    .rev__score {
      padding: 28px;
    }

    .rev--split .rev__marks {
      grid-template-columns: minmax(0, 1fr);
    }

    /* кадр ниже планшетного: при 520 колонка виджета перерастала панель и внизу
       неё зияла пустая зона, а отзывов на экране больше не становилось */
    .rev--split .rev__frame {
      min-height: 460px;
    }
  }
</style>

<script>
  import '../scripts/lazy-frame';
</script>
