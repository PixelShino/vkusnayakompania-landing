---
import { reviews, rating } from '../data/catalog';
import { places, yandexOrgUrl } from '../data/site';
---

<section class="section" id="reviews">
  <div class="container">
    <div class="rev">
      <div class="rev__aside">
        <p class="kicker">Отзывы</p>
        <h2>Что говорят гости</h2>

        <div class="rev__score">
          <div class="blob" aria-hidden="true"></div>
          <div class="card-top">
            <span class="card-mark card-mark--light">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="#FFFAED" aria-hidden="true">
                <path
                  d="M12 2.6l2.9 5.9 6.5.95-4.7 4.6 1.1 6.45L12 17.5l-5.8 3-1.1-6.45L.4 9.45l6.5-.95L12 2.6z"
                ></path>
              </svg>
            </span>
            <span class="card-dash card-dash--light"></span>
            <span class="card-pill card-pill--light">{rating.period}</span>
          </div>

          <div class="rev__big-row">
            <p class="rev__big">{rating.score}</p>
            <div class="rev__stars" aria-hidden="true">
              {
                Array.from({ length: 5 }).map(() => (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="#FFFAED">
                    <path d="M12 2.6l2.9 5.9 6.5.95-4.7 4.6 1.1 6.45L12 17.5l-5.8 3-1.1-6.45L.4 9.45l6.5-.95L12 2.6z" />
                  </svg>
                ))
              }
            </div>
          </div>

          <p class="rev__score-meta">{rating.total}</p>

          <div class="rev__sources">
            {
              places.map((place) => (
                <a
                  class="rev__source"
                  href={`${yandexOrgUrl(place.yandexOrg)}reviews/`}
                  target="_blank"
                  rel="noopener"
                >
                  <span class="rev__source-name">{place.street}</span>
                  <span class="rev__source-score">{place.rating}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <div class="rev__list rail">
        {
          reviews.map((review) => (
            <figure class="rev__card">
              <div class="card-top">
                <span class="card-mark" aria-hidden="true">
                  {review.initial}
                </span>
                <span class="card-dash" />
                <span class="card-pill">{review.source}</span>
              </div>
              <blockquote class="rev__quote">{review.text}</blockquote>
              <figcaption class="rev__foot">
                <span class="rev__name">{review.author}</span>
                <span class="rev__date">{review.date}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>

    <p class="rev__hint">Свайп в сторону — ещё отзывы</p>
  </div>
</section>

<style>
  .rev {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--gap) + 10px);
    align-items: start;
    margin-top: 6px;
  }

  .rev__score {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    margin-top: 18px;
    padding: calc(var(--gap) + 10px);
    border-radius: var(--r-xl);
    background: var(--text);
    color: var(--bg);
  }

  .rev__big-row {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin: 20px 0 8px;
  }

  .rev__big {
    font-weight: var(--fw-heading);
    font-size: 46px;
    line-height: 0.9;
    letter-spacing: -0.02em;
  }

  .rev__stars {
    display: flex;
    gap: 3px;
  }

  .rev__score-meta {
    position: relative;
    z-index: 1;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: rgba(255, 250, 237, 0.86);
  }

  .rev__sources {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 8px;
    margin-top: auto;
    padding-top: 18px;
  }

  .rev__source {
    flex: 1 1 0;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: var(--r-pill);
    background: var(--bg);
    text-decoration: none;
  }

  .rev__source-name {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text);
  }

  .rev__source-score {
    font-weight: var(--fw-heading);
    font-size: 15px;
    line-height: 1;
    color: var(--terracotta-text);
  }

  .rev__card {
    flex: 0 0 auto;
    width: 80%;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: calc(var(--gap) + 10px);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--bg);
  }

  .rev__quote {
    margin: 20px 0 0;
    font-size: calc(var(--fs-body) + 3px);
    font-weight: 400;
    line-height: 1.35;
  }

  .rev__foot {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: auto;
    padding-top: 16px;
  }

  .rev__name {
    font-size: 13px;
    font-weight: 600;
  }

  .rev__date {
    font-size: 11.5px;
    color: var(--text-5);
  }

  .rev__hint {
    margin-top: 10px;
    font-size: 11.5px;
    color: var(--text-5);
  }

  @media (min-width: 768px) {
    .rev__list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--gap);
      align-items: start;
      width: 100%;
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }

    .rev__card {
      width: auto;
    }

    /* лёгкая шахматка — как в макете */
    .rev__card:nth-child(even) {
      margin-top: 26px;
    }

    .rev__big {
      font-size: 58px;
    }

    .rev__hint {
      display: none;
    }
  }

  @media (min-width: 1200px) {
    .rev {
      grid-template-columns: 0.82fr 1.18fr;
      gap: calc(var(--gap) + 28px);
    }
  }
</style>
