---
/**
 * The cart drawer: one native `<dialog>` with three steps — the cart, the
 * checkout form, «order accepted». A side panel on desktop, a full-height
 * sheet on the phone. The form is static markup (labels, places, consent), the
 * page script fills the lines, the days and the times and sends the order to
 * `PUBLIC_DIRECTUS_URL`; without that address the form is replaced by a call,
 * so a half-configured site never takes an order it cannot deliver.
 * Выдвижная корзина: один нативный `<dialog>` с тремя шагами — корзина, форма
 * оформления, «заказ принят». Боковая панель на десктопе, лист во всю высоту
 * на телефоне. Форма — статическая разметка (подписи, точки, согласие), скрипт
 * страницы заполняет строки, дни и время и отправляет заказ на
 * `PUBLIC_DIRECTUS_URL`; без этого адреса вместо формы — звонок: недонастроенный
 * сайт не примет заказ, который не сможет доставить.
 * The venue is one choice with the catalog's switch: the pickup and «В зале»
 * radios are that switch inside the form, delivery names it in one line
 * («Готовит: Садовая, 212Б · Поменять»). Every venue has its own cart (owner,
 * 27.10.2026): the head names whose cart it is, an empty one offers the other
 * venue's when it holds something; a dish the venue no longer cooks (the admin
 * took it off) is named and closes the checkout until it is removed.
 * Точка — один выбор с переключателем каталога: радио самовывоза и «В зале» —
 * этот же переключатель внутри формы, доставка называет её одной строкой
 * («Готовит: Садовая, 212Б · Поменять»). У каждой точки своя корзина
 * (владелец, 27.10.2026): шапка называет, чья это корзина, пустая предлагает
 * корзину другой точки, если в ней что-то есть; блюдо, которое точка больше не
 * готовит (сняли в админке), называется и закрывает оформление, пока его не уберут.
 */
import Icon from '../Icon.astro';
import CartAccount from '../account/CartAccount.astro';
import PayChoice from './PayChoice.astro';
import PayStep from './PayStep.astro';
import HelpLine from './HelpLine.astro';
import { hoursRows } from '../../data/site.ts';
import type { Content } from '../../lib/content.ts';
import { typo } from '../../lib/content.ts';
import { DOC, docHref } from '../../lib/pages.ts';
import { CART_NOTE } from '../../lib/delivery.ts';
import { TABLE_MAX } from '../../lib/order.ts';

interface Props {
  content: Content;
}

const { settings, places, pages } = Astro.props.content;
// what the guest agrees to by sending: the offer, and where delivery and payment are explained
// с чем гость соглашается, отправляя заказ: оферта и где описаны доставка и оплата
const offerHref = settings.offer?.href;
const deliveryHref = docHref(pages, DOC.delivery);
const directus = (import.meta.env.PUBLIC_DIRECTUS_URL as string | undefined)?.replace(/\/+$/, '');
const endpoint = directus ? `${directus}/items/orders` : '';
// address suggestions and the zone quote (`directus/extensions/delivery`); without it the price is named on the call
// подсказки адресов и расчёт зоны (`directus/extensions/delivery`); без него стоимость называют при звонке
const deliveryApi = directus ? `${directus}/delivery` : '';
// the first venue until the page script reads the chosen one (the drawer is closed by then)
// первая точка, пока скрипт страницы не прочтёт выбранную (корзина к тому времени закрыта)
const first = places[0];
// two venues and more: a cart per venue, the drawer says whose it is
// две точки и больше: корзина на точку, корзина говорит, чья она
const venues = places.length > 1;
---

<dialog
  id="cart"
  class="dlg drawer"
  aria-labelledby={venues ? 'cart-title cart-venue' : 'cart-title'}
  data-endpoint={endpoint}
  data-delivery-api={deliveryApi}
>
  <div class="drawer__in">
    <header class="drawer__head">
      <button type="button" class="round-btn drawer__back" data-back hidden aria-label="Назад к корзине">
        <Icon name="arrow-left" />
      </button>
      {/* whose cart this is: every venue has its own (owner, 27.10.2026); the cart step (the form names it itself)
          чья это корзина: у каждой точки своя (владелец, 27.10.2026); на шаге корзины (форма называет её сама) */}
      <div class="drawer__heading">
        <h2 class="drawer__title" id="cart-title" tabindex="-1" data-drawer-title>Корзина</h2>
        {
          venues && first && (
            <p class="drawer__venue" id="cart-venue" data-drawer-venue>
              <Icon name="pin" />
              <span data-venue-name>{first.name}</span>
            </p>
          )
        }
      </div>
      <button type="button" class="round-btn" data-close aria-label="Закрыть">
        <Icon name="close" />
      </button>
    </header>

    <p class="drawer__offline" data-offline hidden>
      <Icon name="wifi-off" />
      <span>Нет интернета. Корзина сохранена — отправим заказ, когда связь вернётся.</span>
    </p>

    {/* ── шаг 1: корзина ─────────────────────────────────────────────── */}
    <section class="drawer__step" data-step="cart" aria-label="Состав корзины">
      <div class="drawer__scroll">
        <p class="drawer__notice" data-dropped hidden></p>
        <p class="drawer__notice drawer__notice--warn" data-blocked hidden>
          Часть блюд закончилась — уберите их, чтобы оформить заказ.
        </p>
        {/* dishes the venue no longer cooks (the admin took it off while the cart waited): what to do, right above them
            блюда, которых точка больше не готовит (сняли в админке, пока корзина ждала): что делать — прямо над ними */}
        <div class="drawer__notice drawer__notice--warn away" data-away-note role="status" hidden>
          <p data-away-note-text></p>
          <p class="away__actions">
            <button type="button" class="tlink" data-away-drop></button>
          </p>
        </div>
        <ul class="lines" role="list" data-lines></ul>
        {/* the other venue's cart waits under this one's lines
            корзина другой точки ждёт под строками этой */}
        {
          venues && (
            <p class="drawer__other drawer__other--below" data-other-cart="full" hidden>
              <Icon name="bag" />
              <span>
                <span data-venue-cart-text />{' '}
                <span class="cart-go">
                  <b class="tnum" data-venue-cart-what />
                  <button type="button" class="tlink" data-venue-go>
                    Перейти
                  </button>
                </span>
              </span>
            </p>
          )
        }

        <div class="drawer__empty" data-empty hidden>
          <Icon name="cloche" />
          <p class="display drawer__empty-title">В корзине пусто</p>
          {/* the other venue's cart holds something: one line, one way there
              в корзине другой точки что-то есть: одна строка, один путь туда */}
          {
            venues && (
              <p class="drawer__other" data-other-cart="empty" hidden>
                <span data-venue-cart-text />{' '}
                <span class="cart-go">
                  <b class="tnum" data-venue-cart-what />
                  <button type="button" class="tlink" data-venue-go>
                    Перейти
                  </button>
                </span>
              </p>
            )
          }
          <p>Добавьте блюда из каталога — они сохранятся здесь до заказа, даже если закрыть страницу.</p>
          <div class="suggest" data-suggest hidden>
            <p class="label">Часто берут</p>
            <ul class="suggest__list" role="list" data-suggest-list></ul>
          </div>
          <button type="button" class="btn btn--secondary" data-close>Смотреть каталог</button>
        </div>
      </div>

      <footer class="drawer__foot" data-cart-foot hidden>
        <p class="sum">
          <span>Итого <span class="sum__count" data-count></span></span>
          <b class="tnum" data-total></b>
        </p>
        <p class="sum__note">{CART_NOTE}</p>
        <p class="cart-warn" data-cart-warn hidden></p>
        {/* no order endpoint on this build (PUBLIC_DIRECTUS_URL is empty): the
            cart is still a list to dictate over the phone
            у этой сборки нет адреса для заказов (PUBLIC_DIRECTUS_URL пуст):
            корзина остаётся списком, который можно продиктовать по телефону */}
        {
          endpoint ? (
            <button type="button" class="btn btn--primary btn--block" data-to-checkout>
              Оформить заказ
            </button>
          ) : (
            <a class="btn btn--primary btn--block" href={settings.phoneHref}>
              Позвонить <span class="tnum">{settings.phone}</span>
            </a>
          )
        }
        <button type="button" class="tlink drawer__clear" data-clear>
          <Icon name="trash" />
          Очистить корзину
        </button>
      </footer>
    </section>

    {/* ── шаг 2: оформление ──────────────────────────────────────────── */}
    <form class="drawer__step checkout" data-step="checkout" id="checkout" novalidate hidden aria-label="Оформление заказа">
      <div class="drawer__scroll">
        <CartAccount content={Astro.props.content} part="checkout" />
        <fieldset class="fs">
          <legend class="fs__legend">Контакты</legend>
          <div class="field">
            <label for="co-name">Имя</label>
            <input id="co-name" name="name" autocomplete="name" maxlength="80" required aria-describedby="co-name-err" />
            <p class="field__err" id="co-name-err" data-err="name" hidden></p>
          </div>
          <div class="field">
            <label for="co-phone">Телефон</label>
            <input
              id="co-phone"
              name="phone"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              placeholder="+7 (___) ___-__-__"
              required
              aria-describedby="co-phone-hint co-phone-err"
            />
            <p class="field__hint" id="co-phone-hint" data-phone-hint>Перезвоним на него, чтобы подтвердить заказ</p>
            <p class="field__err" id="co-phone-err" data-err="phone" hidden></p>
          </div>
          {/* The mail for the ЮKassa receipt: shown by the payment script only
              while online payment is on — and then required (owner,
              26.10.2026: «чтобы точно пришло»). Russian mail only, as in the account.
              Почта для чека ЮKassa: скрипт оплаты показывает её, только пока
              включена онлайн-оплата, — и тогда она обязательна (владелец,
              26.10.2026: «чтобы точно пришло»). Только российская почта, как в кабинете. */}
          <div class="field" data-receipt-email hidden>
            <label for="co-email">E-mail для чека</label>
            <input
              id="co-email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              maxlength="120"
              placeholder="name@mail.ru"
              aria-required="true"
              aria-describedby="co-email-hint co-email-err"
            />
            <p class="field__hint" id="co-email-hint">{typo('Сюда придёт чек об оплате')}</p>
            <p class="field__err" id="co-email-err" data-err="email" hidden></p>
          </div>
        </fieldset>

        <fieldset class="fs">
          <legend class="fs__legend">Как получить</legend>
          <div class="seg seg--3">
            <label class="seg__opt">
              <input type="radio" name="fulfillment" value="delivery" checked />
              <span>Доставка</span>
            </label>
            <label class="seg__opt">
              <input type="radio" name="fulfillment" value="pickup" />
              <span>Самовывоз</span>
            </label>
            <label class="seg__opt">
              <input type="radio" name="fulfillment" value="dine_in" />
              <span>В зале</span>
            </label>
          </div>

          <div class="fs__part" data-for="delivery">
            {/* the venue that cooks the delivery: the catalog's choice, changed here without closing the cart
                точка, которая готовит доставку: выбор каталога, меняется здесь, не закрывая корзину */}
            {
              places.length > 1 && first && (
                <p class="from">
                  <Icon name="pin" />
                  <span class="from__text">
                    Готовит: <b data-venue-name>{first.name}</b>
                  </span>
                  <button type="button" class="tlink from__swap" data-venue-swap>
                    Поменять
                  </button>
                </p>
              )
            }
            <CartAccount content={Astro.props.content} part="addresses" />
            {/* The address is a combobox once the script finds the API: houses
                from `GET /delivery/suggest` under the field, the zone quote under
                them. Without the script it is the plain field it always was.
                Адрес становится комбобоксом, когда скрипт находит API: дома из
                `GET /delivery/suggest` под полем, расчёт зоны под ними. Без
                скрипта — обычное поле, как было. */}
            <div class="field field--address">
              <label for="co-address">Улица и дом</label>
              <div class="combo" data-combo>
                <input
                  id="co-address"
                  name="address"
                  autocomplete="street-address"
                  placeholder="Например: Советской Армии, 177"
                  maxlength="200"
                  aria-describedby="co-address-hint co-address-dlv co-address-err"
                />
                <ul class="combo__list" id="co-address-list" role="listbox" aria-label="Подсказки адреса" data-combo-list hidden></ul>
              </div>
              <p class="field__hint" id="co-address-hint" data-address-hint>Выберите дом из списка — так мы точно посчитаем доставку</p>
              <p class="field__err" id="co-address-err" data-err="address" hidden></p>
              <div class="dlv" id="co-address-dlv" data-dlv hidden>
                <p class="dlv__line" data-dlv-line>
                  <span class="dlv__ico dlv__ico--zone"><Icon name="delivery" /></span>
                  <span class="dlv__ico dlv__ico--quiet"><Icon name="info" /></span>
                  <span data-dlv-text></span>
                </p>
                <p class="dlv__meta" data-dlv-meta hidden></p>
                <div class="dlv__warn" data-dlv-warn hidden>
                  <p class="dlv__warn-text">
                    <Icon name="danger" />
                    <span data-dlv-warn-text></span>
                  </p>
                  <p class="dlv__actions">
                    <button type="button" class="tlink" data-dlv-act="catalog">Добавить блюда</button>
                    <button type="button" class="tlink" data-dlv-act="pickup">Выбрать самовывоз</button>
                    <a class="tlink" href={settings.phoneHref} data-dlv-act="call" aria-label={`Позвонить ${settings.phone}`}>Позвонить</a>
                  </p>
                </div>
              </div>
            </div>
            {/* What the courier needs at the door, each in its own field: the
                manager reads «кв. 12, подъезд 2» instead of one line, and the
                street above stays a line the map can find. A private house
                leaves them empty — one «необязательно» for the four.
                Что нужно курьеру у двери, каждое в своём поле: менеджер читает
                «кв. 12, подъезд 2», а не одну строку, а улица выше остаётся
                строкой, которую находит карта. Частный дом оставляет их пустыми —
                одно «необязательно» на все четыре. */}
            <fieldset class="apt">
              <legend class="apt__legend">Для курьера <span class="field__opt">необязательно</span></legend>
              <div class="apt__grid">
                <div class="field apt__field">
                  <label for="co-flat">Квартира / офис</label>
                  <input id="co-flat" name="flat" maxlength="20" autocomplete="address-line2" />
                </div>
                <div class="field apt__field">
                  <label for="co-entrance">Подъезд</label>
                  <input id="co-entrance" name="entrance" maxlength="10" inputmode="numeric" autocomplete="off" />
                </div>
                <div class="field apt__field">
                  <label for="co-floor">Этаж</label>
                  <input id="co-floor" name="floor" maxlength="10" inputmode="numeric" autocomplete="off" />
                </div>
                <div class="field apt__field">
                  <label for="co-intercom">Код домофона</label>
                  <input id="co-intercom" name="intercom" maxlength="20" autocomplete="off" spellcheck="false" />
                </div>
              </div>
            </fieldset>
            <CartAccount content={Astro.props.content} part="save-address" />
          </div>

          {/* the venue for pickup and for a table: the same radios, the caption says which
              точка самовывоза и стола: те же радио, подпись говорит, о чём речь */}
          <div class="fs__part" data-for="pickup dine_in" hidden>
            <p class="places__label" id="co-place-label" data-place-label>Откуда заберёте</p>
            <div class="places" role="radiogroup" aria-labelledby="co-place-label" aria-describedby="co-place-err">
              {
                places.map((place) => (
                  <label class="place-opt">
                    <input type="radio" name="place" value={place.id} />
                    <span class="place-opt__name">{place.name}</span>
                    {/* the hours are for pickup: a guest at a table is already there
                        часы — для самовывоза: гость за столом уже на месте */}
                    <span class="place-opt__meta">
                      {place.kind}
                      <span class="place-opt__hours">
                        · {hoursRows(place.schedule).map((row) => `${row.days} ${row.hours}`).join(', ')}
                      </span>
                    </span>
                  </label>
                ))
              }
            </div>
            <p class="field__err" id="co-place-err" data-err="place" hidden></p>
          </div>

          {/* At a table (owner, 26.10.2026): the number if the table has one, paid
              on the site, brought to the table. `?place=2&table=5` fills both.
              За столиком (владелец, 26.10.2026): номер, если он есть на столе,
              оплата на сайте, принесут к столу. `?place=2&table=5` заполняет оба. */}
          <div class="fs__part dine" data-for="dine_in" hidden>
            <div class="field dine__table">
              <label for="co-table">Номер стола <span class="field__opt">необязательно</span></label>
              <input
                id="co-table"
                name="table"
                inputmode="numeric"
                maxlength={TABLE_MAX}
                autocomplete="off"
                spellcheck="false"
                aria-describedby="co-table-hint"
              />
              <p class="field__hint" id="co-table-hint">Если на столе есть номер</p>
            </div>
            <p class="dine__note">
              <Icon name="chair" />
              <span>Оплата на сайте, принесём к столу</span>
            </p>
          </div>
        </fieldset>

        <fieldset class="fs">
          <legend class="fs__legend">Когда</legend>
          <div class="seg">
            <label class="seg__opt">
              <input type="radio" name="when" value="asap" checked />
              <span>Как можно скорее</span>
            </label>
            <label class="seg__opt">
              <input type="radio" name="when" value="later" />
              <span>Ко времени</span>
            </label>
          </div>
          <div class="fs__part when" data-for="later" hidden>
            <div class="field">
              <label for="co-date">День</label>
              <select id="co-date" name="date" data-days></select>
            </div>
            <div class="field">
              <label for="co-time">Время</label>
              <select id="co-time" name="time" data-times aria-describedby="co-time-err"></select>
            </div>
            <p class="field__err" id="co-time-err" data-err="time" hidden></p>
          </div>
          {/* at a table nobody calls: a waiter comes to confirm (owner, 26.10.2026)
              в зале не звонят: к столу подходит сотрудник и подтверждает (владелец, 26.10.2026) */}
          <p class="field__hint" data-when-hint>Точное время подтвердим при звонке</p>
        </fieldset>

        <PayChoice />

        <div class="field">
          <label for="co-comment">Комментарий <span class="field__opt">необязательно</span></label>
          <textarea
            id="co-comment"
            name="comment"
            rows="3"
            maxlength="1000"
            placeholder="Например: позвоните за 10 минут, оставьте у двери"></textarea>
        </div>

        {/* a field people never see: a form-filling bot fills it and is turned away
            поле, которого люди не видят: бот, заполняющий формы, заполнит его и получит отказ */}
        <div class="hp" aria-hidden="true">
          <label for="co-company">Компания</label>
          <input id="co-company" name="company" tabindex="-1" autocomplete="off" />
        </div>

        <label class="consent" data-consent>
          <input type="checkbox" name="consent" aria-describedby="co-consent-err" />
          <span>
            Согласен на обработку персональных данных для оформления заказа
            {
              settings.policy && (
                <>
                  {' '}по{' '}
                  <a href={settings.policy.href} target="_blank" rel="noopener">
                    политике конфиденциальности
                  </a>
                </>
              )
            }
          </span>
        </label>
        <p class="field__err" id="co-consent-err" data-err="consent" hidden></p>

        <div class="alert" data-error role="alert" hidden>
          <p class="alert__title" data-error-title>Заказ не отправился</p>
          <p data-error-text></p>
          <div class="alert__actions">
            <a class="btn btn--secondary btn--sm" href={settings.phoneHref}>Позвонить {settings.phone}</a>
          </div>
        </div>
      </div>

      <footer class="drawer__foot">
        {/* the bill: dishes, delivery, what points and the birthday take off, to pay
            счёт: блюда, доставка, что снимают баллы и скидка именинника, к оплате */}
        <div class="bill" data-bill>
          <p class="bill__row">
            <span>Блюда <span class="sum__count" data-count></span></span>
            <b class="tnum" data-total></b>
          </p>
          <p class="bill__row" data-bill-delivery>
            <span data-bill-delivery-label>Доставка</span>
            <b class="tnum" data-bill-delivery-value>по адресу</b>
          </p>
          <CartAccount content={Astro.props.content} part="summary" />
          <p class="bill__row bill__row--pay">
            <span>К оплате</span>
            <b class="tnum" data-bill-pay></b>
          </p>
        </div>
        <CartAccount content={Astro.props.content} part="earn" />
        <p class="bill__note" data-bill-note hidden></p>
        {/* dishes the venue does not cook, found at the last step (the venue changed here)
            блюда, которых точка не готовит, — на последнем шаге (точку сменили здесь же) */}
        <p class="bill__note bill__note--away" data-bill-away hidden>
          <span data-bill-away-text></span>
          <button type="button" class="tlink" data-to-cart>К корзине</button>
        </p>
        <button type="submit" class="btn btn--primary btn--block" data-submit>
          <span data-submit-label>Отправить заказ</span>
        </button>
        {
          offerHref && (
            <p class="sum__legal">
              Отправляя заказ, вы принимаете{' '}
              <a href={offerHref} target="_blank" rel="noopener">
                оферту
              </a>
              {deliveryHref && (
                <>
                  {' '}и{' '}
                  <a href={deliveryHref} target="_blank" rel="noopener">
                    условия доставки и оплаты
                  </a>
                </>
              )}
            </p>
          )
        }
        {/* stuck at the last step: a call or a message, quieter than the button
            застрял на последнем шаге: звонок или сообщение, тише кнопки */}
        <HelpLine settings={settings} />
      </footer>
    </form>

    {/* ── вход по номеру, не выходя из корзины ─────────────────────── */}
    <CartAccount content={Astro.props.content} part="login" />

    {/* ── шаг 3: заказ принят ────────────────────────────────────────── */}
    <section class="drawer__step done" data-step="done" hidden aria-labelledby="done-title">
      <div class="drawer__scroll done__in">
        <span class="mark" aria-hidden="true"></span>
        <h3 class="display display-caps done__title" id="done-title" tabindex="-1">Заказ принят</h3>
        <p class="done__number">
          <span class="label">Номер заказа</span>
          <span class="display tnum" data-done-number></span>
        </p>
        <p class="done__text">
          <span data-done-lead>Перезвоним на <b class="tnum" data-done-phone></b>, чтобы подтвердить состав, сумму, адрес и время.</span>
          <span data-done-after>Оплату обсудим там же.</span>
        </p>
        {/* the phone and the messengers right under «we will call you»: the old
            «Не хотите ждать — позвоните сами» at the bottom said the same number
            телефон и мессенджеры сразу под «перезвоним»: прежняя строка внизу
            «Не хотите ждать — позвоните сами» повторяла тот же номер */}
        <HelpLine settings={settings} class="done__help" />
        {/* the address and the time as they left — what the call will confirm
            адрес и время в том виде, в каком ушли, — то, что подтвердит звонок */}
        <dl class="done__info">
          <div>
            <dt data-done-where-label>Куда</dt>
            <dd>
              <span data-done-where></span>
              <CartAccount content={Astro.props.content} part="done-address" />
            </dd>
          </div>
          <div>
            <dt>Когда</dt>
            <dd data-done-when></dd>
          </div>
        </dl>
        <ul class="done__lines" role="list" data-done-lines></ul>
        <p class="done__total">
          <span>К оплате</span>
          <b class="tnum" data-done-total></b>
        </p>
        <CartAccount content={Astro.props.content} part="done" />
      </div>
      <footer class="drawer__foot">
        <button type="button" class="btn btn--primary btn--block" data-close>Вернуться в каталог</button>
      </footer>
    </section>

    {/* ── шаг 4: оплата ──────────────────────────────────────────────── */}
    <PayStep settings={settings} />
  </div>
</dialog>
