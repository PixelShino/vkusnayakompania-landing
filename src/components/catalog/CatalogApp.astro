---
/**
 * The end of the catalog: the other ways to order, on paper. The landing's ink
 * strip about the app stood right on top of the dark footer here, and two dark
 * blocks read as one heavy slab; the catalog does not need the phone mockup
 * either — the guest has just seen the whole menu.
 * Конец каталога: другие способы заказать, на бумаге. Чернильная полоса
 * лендинга про приложение стояла здесь вплотную к тёмному подвалу, и два
 * тёмных блока читались одной тяжёлой плитой; макет телефона каталогу тоже ни
 * к чему — гость только что видел всё меню.
 */
import { typo, type Content } from '../../lib/content.ts';
import appstore from '../../assets/icons/appstore.svg?raw';
import googleplay from '../../assets/icons/googleplay.svg?raw';

interface Props {
  content: Content;
}

const { settings, home } = Astro.props.content;
const STORES = [
  { label: 'App Store', href: settings.app_ios, icon: appstore },
  { label: 'Google Play', href: settings.app_android, icon: googleplay },
].filter((store) => Boolean(store.href));
---

<section class="strip-paper cat-app" id="app" aria-labelledby="cat-app-title">
  <div class="container cat-app__in">
    <div class="cat-app__lead" data-reveal>
      <span class="mark cat-app__mark" aria-hidden="true"></span>
      <h2 class="display-caps cat-app__title" id="cat-app-title">Удобнее в приложении?</h2>
      <p class="cat-app__text">
        {typo('Тот же каталог, история заказов и статус доставки — в приложении «Вкусная компания». Или позвоните — подскажем и поможем с заказом.')}
      </p>
    </div>
    <div class="cat-app__cta">
      {home.delivery_note && <p class="display cat-app__note">{home.delivery_note}</p>}
      <div class="cat-app__actions">
        {
          STORES.map((store) => (
            <a class="btn btn--primary" href={store.href} target="_blank" rel="noopener">
              <span class="store-ico" aria-hidden="true">
                <Fragment set:html={store.icon} />
              </span>
              {store.label}
            </a>
          ))
        }
        <a class="btn btn--secondary" href={settings.phoneHref}>
          Позвонить <span class="tnum">{settings.phone}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cat-app {
    padding-block: var(--sec-pad);
  }

  .cat-app__in {
    display: grid;
    gap: 22px;
  }

  .cat-app__mark {
    margin-inline: 0;
  }

  .cat-app__title {
    margin-top: 14px;
    font-size: clamp(26px, 6.6vw, 34px);
  }

  .cat-app__text {
    max-width: 48ch;
    margin-top: 12px;
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--text-2);
  }

  .cat-app__note {
    max-width: 22ch;
    font-size: clamp(22px, 5.4vw, 26px);
    line-height: 1.15;
    color: var(--terracotta-text);
    text-wrap: balance;
  }

  /* phone: the two stores share a row, the call takes the next one whole —
     three ragged widths stacked read as leftovers
     телефон: два магазина делят строку, звонок берёт следующую целиком — три
     рваные ширины столбиком читались остатками */
  .cat-app__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 18px;
  }

  .cat-app__actions .btn {
    padding-inline: 14px;
  }

  .cat-app__actions .btn--secondary {
    grid-column: 1 / -1;
  }

  @media (min-width: 768px) {
    .cat-app__actions {
      display: flex;
      flex-wrap: wrap;
    }

    .cat-app__actions .btn {
      padding-inline: 22px;
    }

    .cat-app__in {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 40px;
      align-items: end;
    }
  }
</style>
