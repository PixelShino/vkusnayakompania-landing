---
/**
 * First screen: the photo stays visible on the right, the scrim runs as a
 * column down the left, and the empty right half carries the «today» card —
 * both venues' status, the nearest event and the venue phone.
 * Первый экран: фото справа остаётся видно, скрим идёт колонкой слева, а
 * пустовавшая правая половина занята карточкой «сегодня» — статус обеих
 * точек, ближайшее событие афиши и телефон точки.
 */
import Photo from './Photo.astro';
import OpenStatus from './OpenStatus.astro';
import { HERO_SIZES } from '../lib/hero.ts';
import type { Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { home, settings, places, afisha } = content;

const dayMonth = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long' });
const afishaDate = afisha ? dayMonth.format(new Date(afisha.date)) : '';
---

<section class="hero" id="top">
  <Photo
    photo={home.hero_image}
    ratio="auto"
    ratioMd="auto"
    radius="0"
    sizes={HERO_SIZES}
    eager
    class="hero__photo"
  />
  <div class="hero__veil">
    <div class="container hero__in">
      <div class="hero__box">
        <h1>{home.hero_title}</h1>
        {home.hero_text && <p class="lead hero__lead">{home.hero_text}</p>}

        <div class="hero__cta">
          <a class="btn btn--light" href={settings.shop_url} target="_blank" rel="noopener">
            Заказать доставку
          </a>
          <button type="button" class="btn btn--ghost-light" data-book="Бронь стола">
            Забронировать стол
          </button>
        </div>
      </div>

      <div class="hero__today">
        <p class="hero__today-t">Сегодня</p>
        <ul class="hero__points">
          {
            places.map((place) => (
              <li class="hero__point">
                <span class="hero__point-head">
                  <a class="hero__point-name" href="#contacts">
                    {place.name}
                  </a>
                  <OpenStatus schedule={place.schedule} class="hero__status" />
                </span>
                <a class="hero__tel" href={place.phoneHref}>
                  {place.phone}
                </a>
              </li>
            ))
          }
        </ul>

        {
          afisha && (
            <a class="hero__event" href="#afisha">
              <span class="hero__event-m">
                Афиша<span class="hero__sep" aria-hidden="true">
                  ·
                </span>
                <time datetime={afisha.date}>{afishaDate}</time>
              </span>
              <span class="hero__event-t">{afisha.title}</span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    /* шапка липкая и стоит в потоке: без вычета её высоты кнопки уезжают
       за нижний край экрана */
    min-height: calc(100svh - var(--header-h));
  }

  /* класс лежит на корне дочернего `Photo.astro` — нужен `:global` */
  .hero > :global(.hero__photo) {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  .hero > :global(.hero__photo img) {
    object-position: center 40%;
  }

  /* До 1200 карточка стоит под текстом, колонка занимает всю ширину — скрим
     тут вертикальный и привязан к тексту, а не к экрану: градиент «от низа
     экрана» отдаёт заголовку 0,13 альфы, то есть 2,1:1 на светлой витрине.
     Below 1200 the text spans the full column, so the scrim stays vertical
     and text-anchored: a screen-anchored ramp leaves the headline at 0.13. */
  .hero__veil {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-top: 160px;
    background: linear-gradient(
      to top,
      rgb(44 41 39 / 0.9) 0%,
      rgb(44 41 39 / 0.78) 55%,
      rgb(44 41 39 / 0.68) 84%,
      rgb(44 41 39 / 0) 100%
    );
  }

  .hero__in {
    padding-block: 0 34px;
    color: var(--bg);
  }

  .hero h1 {
    max-width: 15ch;
  }

  .hero__lead {
    color: var(--surface);
    max-width: 38ch;
  }

  .hero__cta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 22px;
  }

  .hero__cta .btn {
    height: 48px;
    font-size: 14.5px;
  }

  .hero__box {
    max-width: 620px;
  }

  /* Карточка «сегодня»: полупрозрачные чернила поверх кадра. 0,86 держит
     `--on-ink` 7,0:1 и `--on-ink-2` 4,7:1 даже на белом пикселе витрины;
     терракота там даёт 3,6:1 и не берётся.
     Translucent ink over the frame: 0.86 keeps the cream text at 7.0:1 even
     over the brightest pixel of the photo. */
  .hero__today {
    margin-top: 24px;
    padding: 16px;
    border: 1px solid color-mix(in srgb, var(--on-ink) 18%, transparent);
    border-radius: var(--r-xl);
    background: color-mix(in srgb, var(--ink) 86%, transparent);
    color: var(--on-ink);
  }

  .hero__today-t {
    margin-bottom: 12px;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--on-ink-2);
  }

  .hero__points {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__point + .hero__point {
    padding-top: 12px;
    border-top: 1px solid color-mix(in srgb, var(--on-ink) 14%, transparent);
  }

  /* Grid, not wrapping flex: a long name pushed the pill onto its own line and
     left-aligned it, so the two venues lined up differently in one card.
     Сетка, а не переносимый flex: длинное название сбрасывало пилюлю на свою
     строку и прижимало её влево — две точки в одной карточке шли по-разному. */
  .hero__point-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px 10px;
  }

  .hero__point-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--on-ink);
    text-decoration: none;
    /* «Советской Армии, 177» в две строки не должно оставлять висячее «177» */
    text-wrap: pretty;
  }

  /* Pill never shrinks: its text is nowrap and a squeezed one overflows. The
     side padding is tighter than the shared pill's 13px, because at 390 the
     six pixels it frees are exactly what keeps «Советской Армии, 177» on one
     line next to it.
     Пилюля `OpenStatus` не сжимается: её текст `nowrap`, ужатая — вылезает.
     Боковой отступ тут меньше общих 13 px: на 390 освободившиеся шесть
     пикселей — ровно то, что оставляет «Советской Армии, 177» в одну строку. */
  .hero__point-head :global(.hero__status) {
    flex: none;
    padding-inline: 9px;
  }

  .hero__tel {
    display: inline-block;
    margin-top: 6px;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--on-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .hero__event {
    display: block;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid color-mix(in srgb, var(--on-ink) 14%, transparent);
    color: var(--on-ink);
    text-decoration: none;
  }

  .hero__event-m {
    display: block;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--on-ink-2);
  }

  .hero__event-t {
    display: block;
    margin-top: 5px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
  }

  .hero__sep {
    margin-inline: 6px;
    opacity: 0.6;
  }

  /* тач: ссылки карточки растут до зоны нажатия 44 px, строка не съезжает */
  @media (pointer: coarse) {
    .hero__point-name {
      display: inline-block;
      padding-block: 11px;
      margin-block: -11px;
    }

    .hero__tel {
      padding-block: 11px;
      margin-block: -5px -11px;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__point-name:hover,
    .hero__tel:hover,
    .hero__event:hover .hero__event-t {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  @media (min-width: 768px) {
    /* шапка здесь `fixed` и фона не имеет — кадр начинается от самого верха */
    .hero {
      min-height: 100svh;
    }

    /* Верх кадра светлый (витрина с лампами): без скрима кремовые пункты меню
       в прозрачной шапке дают 2,7:1. Плато 0,74…0,70 держится всю высоту шапки
       (88 px) — на самом светлом пикселе фона это 4,9:1 — и только потом гаснет.
       Абсолютный — значит не флекс-элемент родителя.
       A plateau over the header height, then the fade: the bright display case
       under the labels needs a constant floor, not a linear ramp. */
    .hero::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      z-index: 1;
      height: 220px;
      background: linear-gradient(
        to bottom,
        rgb(44 41 39 / 0.74) 0,
        rgb(44 41 39 / 0.7) 88px,
        rgb(44 41 39 / 0) 220px
      );
      pointer-events: none;
    }

    .hero__in {
      padding-block: 0 54px;
    }

    .hero__cta {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 10px;
    }

    .hero__cta .btn {
      padding-inline: 26px;
    }

    /* карточка во всю ширину колонки: точки встают рядом, справа от них не
       остаётся пустой зоны */
    .hero__today {
      padding: 18px 20px;
    }

    .hero__points {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 22px;
    }

    .hero__point + .hero__point {
      padding-top: 0;
      border-top: 0;
    }
  }

  @media (min-width: 1200px) {
    /* Скрим — колонкой слева во всю высоту, правая часть витрины остаётся
       видна. Верхнее плато рисует `.hero::before` поверх — цвет тот же.
       The scrim becomes a full-height left column; the right half of the
       frame stays visible, the header plateau still comes from `::before`. */
    .hero__veil {
      display: flex;
      align-items: flex-end;
      align-self: stretch;
      padding-top: 0;
      background: linear-gradient(
        to right,
        rgb(44 41 39 / 0.86) 0%,
        rgb(44 41 39 / 0.72) 38%,
        rgb(44 41 39 / 0) 68%
      );
    }

    .hero__in {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(300px, 360px);
      align-items: end;
      gap: 48px;
      padding-block: 0 64px;
    }

    /* Не шире 620, но и не шире зоны, где скрим держит 0,66 альфы: правее
       кремовый текст на светлом пикселе кадра падает ниже 4,5:1.
       Capped by the scrim: past ~40 % of the viewport the cream text drops
       under 4.5:1 over a bright pixel. */
    .hero__box {
      max-width: min(620px, 34vw);
    }

    .hero__today {
      margin-top: 0;
      padding: 20px 22px;
      /* размывает только на десктопе: на телефоне карточка лежит в потоке
         и `blur` там зря греет GPU */
      backdrop-filter: blur(10px);
    }

    .hero__points {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .hero__point + .hero__point {
      padding-top: 12px;
      border-top: 1px solid color-mix(in srgb, var(--on-ink) 14%, transparent);
    }
  }
</style>
