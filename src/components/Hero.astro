---
/**
 * First screen: the photo fills the viewport, everything else sits on top of
 * the scrim in the bottom-left corner — a poster with two actions under the
 * thumb, as `docs/PRODUCT.md` asks.
 * Первый экран: фото на весь экран, остальное лежит поверх скрима в левом
 * нижнем углу — афиша с двумя кнопками под пальцем, как просит
 * `docs/PRODUCT.md`.
 */
import Photo from './Photo.astro';
import OpenStatus from './OpenStatus.astro';
import { HERO_SIZES } from '../lib/hero.ts';
import type { Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { home, settings, places, afisha } = content;

const dayMonth = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long' });
const afishaDate = afisha ? dayMonth.format(new Date(afisha.date)) : '';
---

<section class="hero" id="top">
  <Photo
    photo={home.hero_image}
    ratio="auto"
    ratioMd="auto"
    radius="0"
    sizes={HERO_SIZES}
    eager
    class="hero__photo"
  />
  <div class="hero__veil">
    <div class="container hero__in">
      <div class="hero__box">
      {
        afisha && (
          <a class="hero__afisha" href="#afisha">
            Афиша<span class="hero__sep" aria-hidden="true">·</span>
            <time datetime={afisha.date}>{afishaDate}</time>
            <span class="hero__sep" aria-hidden="true">·</span>
            {afisha.title}
          </a>
        )
      }

      <h1>{home.hero_title}</h1>
      {home.hero_text && <p class="lead hero__lead">{home.hero_text}</p>}

      <div class="hero__cta">
        <a class="btn btn--light" href={settings.shop_url} target="_blank" rel="noopener">
          Заказать доставку
        </a>
        <button type="button" class="btn btn--ghost-light" data-book="Бронь стола">
          Забронировать стол
        </button>
      </div>

      <div class="hero__foot">
        <a class="hero__phone" href={settings.phoneHref}>{settings.phone}</a>
        <div class="hero__places">
          {
            places.map((place) => (
              <a class="hero__place" href="#contacts">
                {place.name}
                <OpenStatus schedule={place.schedule} class="hero__status" />
              </a>
            ))
          }
        </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    /* шапка липкая и стоит в потоке: без вычета её высоты кнопки уезжают
       за нижний край экрана */
    min-height: calc(100svh - var(--header-h));
  }

  /* класс лежит на корне дочернего `Photo.astro` — нужен `:global` */
  .hero > :global(.hero__photo) {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  .hero > :global(.hero__photo img) {
    object-position: center 40%;
  }

  /* Скрим привязан к тексту, а не к экрану: на телефоне блок занимает три
     четверти кадра, и градиент «от низа экрана» отдаёт заголовку 0,13 альфы —
     белое по светлой витрине — 2,1:1. Здесь верхние 160 px гасят переход, а
     под текстом держится 0,58…0,88.
     The scrim is tied to the text, not to the viewport: a screen-anchored
     gradient leaves the headline at 0.13 alpha over a bright display case. */
  .hero__veil {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-top: 160px;
    background: linear-gradient(
      to top,
      rgb(44 41 39 / 0.9) 0%,
      rgb(44 41 39 / 0.78) 55%,
      rgb(44 41 39 / 0.68) 84%,
      rgb(44 41 39 / 0) 100%
    );
  }

  .hero__in {
    padding-block: 0 34px;
    color: var(--bg);
  }

  .hero__afisha {
    display: inline-block;
    max-width: 100%;
    margin-bottom: 16px;
    padding: 7px 13px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    border: 1px solid rgb(255 250 237 / 0.32);
    border-radius: var(--r-pill);
    /* подложка темнее фона, а не светлее: светлая на белом кадре роняет
       контраст подписи до 2,1:1 (`docs/DESIGN.md`, раздел «Цвет») */
    background: rgb(28 25 22 / 0.38);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--bg);
    text-decoration: none;
    vertical-align: bottom;
    transition-property: scale, background-color;
    transition-duration: 120ms, 0.16s;
    transition-timing-function: var(--ease-out), ease;
  }

  .hero__afisha:active {
    scale: 0.96;
  }

  .hero__sep {
    margin-inline: 6px;
    opacity: 0.6;
  }

  .hero h1 {
    max-width: 15ch;
  }

  .hero__lead {
    color: var(--surface);
    max-width: 38ch;
  }

  .hero__cta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 22px;
  }

  .hero__cta .btn {
    height: 48px;
    font-size: 14.5px;
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid rgb(255 250 237 / 0.22);
  }

  .hero__phone {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--bg);
    text-decoration: none;
    white-space: nowrap;
  }

  .hero__places {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hero__place {
    display: inline-flex;
    align-items: center;
    padding: 7px 13px;
    border: 1px solid rgb(255 250 237 / 0.32);
    border-radius: var(--r-pill);
    /* подложка темнее фона, а не светлее: светлая на белом кадре роняет
       контраст подписи до 2,1:1 (`docs/DESIGN.md`, раздел «Цвет») */
    background: rgb(28 25 22 / 0.38);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--bg);
    text-decoration: none;
    transition-property: scale, background-color;
    transition-duration: 120ms, 0.16s;
    transition-timing-function: var(--ease-out), ease;
  }

  .hero__place:active {
    scale: 0.96;
  }

  /* пилюля `OpenStatus` внутри нашей — четыре класса против трёх у неё */
  .hero__place :global(.hero__status.card-pill) {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
  }

  /* точка живёт на самом статусе: пока он скрыт до расчёта, её тоже нет */
  .hero__place :global(.hero__status)::before {
    content: '·';
    margin-inline: 6px;
    opacity: 0.6;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__afisha:hover,
    .hero__place:hover {
      background: rgb(28 25 22 / 0.5);
    }

    .hero__phone:hover {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  .hero__box {
    max-width: 640px;
  }

  @media (min-width: 768px) {
    /* шапка здесь `fixed` и фона не имеет — кадр начинается от самого верха */
    .hero {
      min-height: 100svh;
    }

    /* Верх кадра светлый (витрина с лампами): без скрима кремовые пункты меню
       в прозрачной шапке дают 2,7:1. Плато 0,74…0,70 держится всю высоту шапки
       (88 px) — на самом светлом пикселе фона это 4,9:1 — и только потом гаснет.
       Абсолютный — значит не флекс-элемент родителя.
       A plateau over the header height, then the fade: the bright display case
       under the labels needs a constant floor, not a linear ramp. */
    .hero::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      z-index: 1;
      height: 220px;
      background: linear-gradient(
        to bottom,
        rgb(44 41 39 / 0.74) 0,
        rgb(44 41 39 / 0.7) 88px,
        rgb(44 41 39 / 0) 220px
      );
      pointer-events: none;
    }

    .hero__in {
      padding-block: 0 54px;
    }

    .hero__afisha {
      font-size: 13px;
    }

    .hero__cta {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 10px;
    }

    .hero__cta .btn {
      padding-inline: 26px;
    }

    .hero__foot {
      gap: 12px 22px;
      margin-top: 28px;
    }

    .hero__phone {
      font-size: 30px;
    }
  }
</style>
