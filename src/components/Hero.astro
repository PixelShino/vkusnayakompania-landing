---
import Photo from './Photo.astro';
import { heroPhotos } from '../data/catalog';
import { site } from '../data/site';
---

<section class="hero" id="top">
  <div class="container">
    <div class="hero__head">
      <p class="kicker">Кондитерская и кухня · {site.city}</p>
      <h1>Печём с утра, пока не разберут</h1>
    </div>

    <div class="hero__grid">
      <Photo
        photo={heroPhotos.tall}
        ratio="3 / 4.4"
        ratioMd="auto"
        radius="var(--r-xl)"
        sizes="(min-width: 1200px) 520px, (min-width: 768px) 45vw, 100vw"
        eager
        class="hero__tall"
      >
        <div class="hero__scrim" aria-hidden="true"></div>
        <div class="hero__overlay">
          <p class="kicker kicker--light" aria-hidden="true">Кондитерская и кухня · {site.city}</p>
          {/* дубль `h1` поверх фото: второго `h1` в документе быть не должно */}
          <p class="hero__overlay-title" aria-hidden="true">Печём с утра, пока не разберут</p>
          <p class="hero__overlay-lead">
            Торты на&nbsp;заказ, пирожные и&nbsp;конфеты&nbsp;— и&nbsp;завтраки, супы и&nbsp;паста
            в&nbsp;зале.
          </p>
          <div class="hero__overlay-cta">
            <a class="btn btn--primary btn--block" href="#cakes">Смотреть торты</a>
            <a
              class="btn btn--ghost-light btn--block"
              href={site.links.shop}
              target="_blank"
              rel="noopener">Заказать доставку</a
            >
          </div>
        </div>
      </Photo>

      {/* виден сразу, но канал у LCP-снимка слева отбирать не должен */}
      <Photo
        photo={heroPhotos.wide}
        ratio="16 / 9"
        radius="var(--r-xl)"
        sizes="(min-width: 1200px) 700px, 55vw"
        eager
        priority="low"
        class="hero__wide"
      />

      <div class="hero__text">
        <p class="lead">
          Торты на&nbsp;заказ, пирожные, конфеты&nbsp;— и&nbsp;завтраки, супы и&nbsp;паста
          в&nbsp;зале. Всё своё, всё с&nbsp;одной кухни.
        </p>
        <div class="hero__cta">
          <a class="btn btn--primary" href="#cakes">Смотреть торты</a>
          <a class="btn btn--secondary" href={site.links.shop} target="_blank" rel="noopener">
            Заказать доставку
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--sec-pad) * 0.6);
  }

  /* на телефоне `h1` не выключаем, а прячем: он нужен поиску и скринридеру */
  .hero__head {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .hero__grid {
    display: block;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(26, 23, 20, 0.9) 0%,
      rgba(26, 23, 20, 0.72) 30%,
      rgba(26, 23, 20, 0.28) 62%,
      rgba(26, 23, 20, 0.02) 100%
    );
  }

  .hero__overlay {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: 9px;
    /* запас снизу: туда наезжает бенто из соседней секции */
    padding: 20px 18px 76px;
  }

  .kicker--light {
    color: rgba(255, 250, 237, 0.72);
    margin-bottom: 0;
  }

  .hero__overlay-title {
    font-size: 31px;
    line-height: 1.06;
    letter-spacing: -0.01em;
    color: var(--bg);
  }

  .hero__overlay-lead {
    font-size: 14px;
    line-height: 1.45;
    color: rgba(255, 250, 237, 0.84);
  }

  .hero__overlay-cta {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-top: 2px;
  }

  .hero__overlay-cta .btn {
    height: 48px;
    font-size: 14.5px;
  }

  /* классы на корне дочернего `Photo.astro` — нужен `:global` */
  .hero__grid > :global(.hero__wide),
  .hero__text {
    display: none;
  }

  @media (min-width: 768px) {
    .hero__head {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip-path: none;
    }

    .hero__head h1 {
      max-width: 18ch;
      margin-bottom: 26px;
    }

    .hero__grid {
      display: grid;
      grid-template-columns: 0.85fr 1.15fr;
      grid-template-rows: auto auto;
      gap: var(--gap);
      align-items: stretch;
    }

    .hero__grid > :global(.hero__tall) {
      grid-column: 1;
      grid-row: 1 / span 2;
      height: 100%;
    }

    .hero__scrim,
    .hero__overlay {
      display: none;
    }

    .hero__grid > :global(.hero__wide) {
      display: block;
      grid-column: 2;
      grid-row: 1;
    }

    .hero__text {
      display: flex;
      flex-direction: column;
      justify-content: center;
      grid-column: 2;
      grid-row: 2;
      padding: calc(var(--gap) + 10px);
      border-radius: 22px;
      background: var(--surface);
    }

    .hero__cta {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 24px;
    }
  }
</style>
