---
import MessengerButtons from './MessengerButtons.astro';
import OpenStatus from './OpenStatus.astro';
import type { Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { places, settings } = content;
const main = places[0];
---

<section class="bento-wrap">
  <div class="container">
    <div class="bento">
      <div class="bento__hours">
        <div class="bento__hours-top">
          <p class="bento__label">Сегодня</p>
          <OpenStatus schedule={main.schedule} class="bento__status" />
        </div>
        <OpenStatus schedule={main.schedule} mode="today" class="bento__big tnum" />
        <p class="bento__sub">{main.name} · витрина полная с утра</p>
      </div>

      <div class="bento__cell">
        <p class="bento__num">48 ч</p>
        <p class="bento__sub">на торт под заказ</p>
      </div>

      <a class="bento__cell bento__cell--link" href="#contacts">
        <p class="bento__num">2 точки</p>
        <p class="bento__sub">{places.map((place) => place.street).join(' · ')}</p>
      </a>

      <div class="bento__contact">
        <p class="bento__label">Написать нам</p>
        <MessengerButtons settings={settings} variant="dark" size="md" />
      </div>
    </div>
  </div>
</section>

<style>
  .bento-wrap {
    padding-bottom: calc(var(--sec-pad) * 0.5);
  }

  /* на телефоне бенто наезжает на фото первого экрана: карточка часов
     вырезается из снимка кольцом цвета фона */
  .bento {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
    margin-top: -46px;
  }

  .bento__hours,
  .bento__contact {
    grid-column: span 2;
  }

  .bento__hours {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 13px 15px;
    border-radius: var(--r-lg);
    background: var(--olive);
    color: var(--bg);
    box-shadow: 0 0 0 5px var(--bg);
  }

  .bento__hours-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .bento__hours :global(.bento__status),
  .bento__hours :global(.bento__status.is-open) {
    padding: 4px 10px;
    border-color: transparent;
    background: rgba(28, 25, 22, 0.24);
    color: var(--bg);
    font-size: 11px;
  }

  .bento__cell {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    padding: 11px 13px;
    border: 1px solid var(--line-2);
    border-radius: var(--r-sm);
    background: var(--surface);
  }

  .bento__cell--link {
    text-decoration: none;
    transition: border-color 0.16s ease;
  }

  .bento__cell--link:hover {
    border-color: var(--line-4);
  }

  .bento__contact {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
    padding: 10px;
    border: 1px solid var(--line-warm);
    border-radius: var(--r-sm);
    background: var(--surface-warm);
  }

  .bento__label {
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.78;
  }

  /* на оливковой заливке прозрачность роняет контраст ниже нормы */
  .bento__hours .bento__label,
  .bento__hours .bento__sub {
    opacity: 1;
  }

  .bento__hours :global(.bento__big) {
    display: block;
    font-weight: var(--fw-heading);
    font-size: 21px;
    line-height: 1.04;
    letter-spacing: -0.01em;
  }

  .bento__num {
    font-weight: var(--fw-heading);
    font-size: 17px;
    line-height: 1.04;
    /* заливочная терракота на кремовом даёт 3,1:1 — берём текстовую */
    color: var(--terracotta-text);
  }

  .bento__sub {
    font-size: 11.5px;
    line-height: 1.35;
    opacity: 0.85;
  }

  @media (min-width: 768px) {
    .bento {
      grid-template-columns: repeat(6, 1fr);
      gap: 10px;
      margin-top: 34px;
    }

    .bento__hours {
      box-shadow: none;
    }

    .bento__hours,
    .bento__cell,
    .bento__contact {
      padding: 18px 20px;
      border-radius: 18px;
    }

    .bento__hours,
    .bento__contact {
      gap: 3px;
    }

    .bento__label {
      font-size: 11px;
    }

    .bento__hours :global(.bento__big) {
      font-size: 30px;
    }

    .bento__num {
      font-size: 25px;
    }

    .bento__sub {
      font-size: 12.5px;
    }
  }
</style>
