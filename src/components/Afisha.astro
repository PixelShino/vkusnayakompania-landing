---
/**
 * Current event on an ink strip: the mark and «Афиша» on the central axis,
 * then the spread — a narrow poster on the left and the event pressed beside
 * it: the date as a display line with a large day numeral, the title in
 * antiqua, the venue as a label and the booking stamp. The caller decides
 * whether to render it — the component draws.
 * Текущая афиша на чернильной полосе: марка и «Афиша» по центральной оси, ниже
 * разворот — узкий постер слева и событие рядом: дата дисплейной строкой с
 * крупным числом, название антиквой, точка подписью и оттиск брони. Решение
 * «показывать или нет» принимает вызывающий, компонент всегда рисует.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { typo, type Afisha } from '../lib/content';

interface Props {
  afisha: Afisha;
}

const { afisha } = Astro.props;

// dates come as YYYY-MM-DD; UTC keeps the day from sliding on a western builder
// даты приходят как YYYY-MM-DD; UTC не даёт дню съехать на сборке западнее
const date = new Date(`${afisha.date}T00:00:00Z`);
const day = new Intl.DateTimeFormat('ru-RU', {
  day: 'numeric',
  month: 'long',
  timeZone: 'UTC',
}).format(date);
const dayNumber = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', timeZone: 'UTC' }).format(date);
// the long form minus the number leaves the month in the case the numeral needs
// «26 сентября» минус число — родительный падеж месяца рядом с крупной цифрой
const dayMonth = day.slice(dayNumber.length).trim();
const time = afisha.time?.slice(0, 5);
const datetime = time ? `${afisha.date}T${time}` : afisha.date;

// a stub file is marked in the admin, and the mark reaches the page through alt
// файл-заглушку помечают в админке, до страницы пометка доходит через `alt`
const stub = /заглушк/i.test(afisha.poster.alt);
---

<section class="section strip-ink" id="afisha">
  <div class="container">
    <div class="head">
      <span class="mark" aria-hidden="true"></span>
      <h2 class="display-caps">Афиша</h2>
    </div>

    <div class="af">
      <figure class="af__poster">
        {
          stub ? (
            <div class="stub af__stub">
              <span class="stub__title">Постер афиши</span>
              <span class="stub__meta">заглушка · заменяется в админке</span>
            </div>
          ) : (
            <Image
              src={afisha.poster.src as ImageMetadata}
              width={afisha.poster.width}
              height={afisha.poster.height}
              alt={afisha.poster.alt}
              widths={[260, 440, 520, 800]}
              sizes="(min-width: 1200px) 253px, (min-width: 768px) 220px, 92vw"
              format="avif"
              quality={52}
              loading="lazy"
              decoding="async"
            />
          )
        }
      </figure>

      <div class="af__body">
        <time datetime={datetime} class="af__date">
          <span class="af__day display">{dayNumber}</span>
          <span class="af__dm">
            {dayMonth}
            {
              time && (
                <>
                  <span class="af__dot" aria-hidden="true">
                    {' · '}
                  </span>
                  <span class="af__time tnum">{time}</span>
                </>
              )
            }
          </span>
        </time>

        <h3 class="af__title display">{afisha.title}</h3>

        <p class="tag af__place">
          {afisha.place.name}
          <span class="af__dot" aria-hidden="true">{' · '}</span>
          {afisha.place.kind}
        </p>

        {afisha.text && <p class="lead af__text">{typo(afisha.text)}</p>}

        <div class="af__actions">
          <button
            type="button"
            class="btn btn--light"
            data-book={`Бронь стола: ${afisha.place.street}`}
            data-book-note={`${afisha.title}, ${day}${time ? `, ${time}` : ''}`}
          >
            Забронировать стол
          </button>
          {
            afisha.link && (
              <a class="btn btn--ghost-light" href={afisha.link} target="_blank" rel="noopener">
                Подробнее
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .af {
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
    align-items: center;
    margin-top: 30px;
  }

  /* the poster keeps its natural ratio, so a real shot drops in without a shift */
  /* постер идёт в своей пропорции: подстановка кадра ничего не сдвинет */
  .af__poster {
    margin: 0;
    border-radius: var(--r-sq);
    overflow: hidden;
    background: var(--surface-photo);
  }

  .af__poster :global(img) {
    width: 100%;
    height: auto;
    outline: 1px solid rgb(0 0 0 / 0.08);
    outline-offset: -1px;
  }

  /* the stub is a finished 3:4 plate with a caption, never an empty frame */
  /* заглушка — оформленная плашка 3:4 с надписью, а не пустая рамка */
  .af__stub {
    aspect-ratio: 3 / 4;
  }

  .af__body {
    min-width: 0;
  }

  /* The date as a line, not a panel: the day numeral in the display face, the
     month and time in small caps beside it, the time in lightened terracotta.
     Дата строкой, а не панелью: число антиквой, рядом месяц и время мелкими
     прописными, время — осветлённой терракотой. */
  .af__date {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .af__day {
    font-size: clamp(48px, 11vw, 60px);
    line-height: 0.9;
    color: var(--on-ink);
  }

  .af__dm {
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--on-ink);
  }

  /* терракота на чернилах только осветлённая: базовая даёт 3,2:1 */
  .af__time {
    color: var(--terracotta-on-ink);
  }

  .af__dot {
    opacity: 0.55;
  }

  .af__title {
    margin-top: 14px;
    font-size: clamp(28px, 7vw, 34px);
    line-height: 1.1;
    color: var(--on-ink);
    text-wrap: balance;
  }

  .af__place {
    margin-top: 10px;
    color: var(--on-ink-2);
  }

  .af__text {
    margin-top: 14px;
    color: var(--on-ink-2);
  }

  .af__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  /* на телефоне обе кнопки на всю ширину колонки, чтобы не рвать ряд */
  @media (max-width: 767px) {
    .af__actions .btn {
      width: 100%;
    }
  }

  /* poster and copy sit tight: a narrow poster column, copy takes the rest */
  /* пара «постер + текст» стоит вплотную: постер узкий, текст занимает остальное */
  @media (min-width: 768px) {
    .af {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 40px;
      margin-top: 36px;
    }

    .af__title {
      font-size: 36px;
    }
  }

  @media (min-width: 1200px) {
    /* the pair is centred under the heading: a capped copy column, the grid
       itself in the middle of the strip
       пара стоит по центру под заголовком: колонка текста ограничена, сама
       сетка — посередине полосы */
    .af {
      grid-template-columns: 253px minmax(0, 600px);
      justify-content: center;
      gap: 56px;
    }

    .af__day {
      font-size: 68px;
    }

    .af__title {
      font-size: 40px;
    }

    /* the lead stays a paragraph, not a line across the whole strip */
    /* лид остаётся абзацем, а не строкой через всю полосу */
    .af__text {
      max-width: 48ch;
    }
  }
</style>
