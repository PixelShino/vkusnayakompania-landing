---
import Photo from './Photo.astro';
import { aboutPhotos } from '../data/catalog';

// TODO(клиент): финальный текст «о нас». Пока — заготовка на фактах, которые
// подтверждаются публично: шесть лет работы (сайт кейтеринга), две точки в
// Самаре, собственная кухня и кейтеринговое направление.
const facts = ['Шесть лет на кухне', 'Две точки в Самаре', 'Свой цех, без закупа'];
---

<section class="section" id="about">
  <div class="container">
    <div class="about">
      <div>
        <h2>О нас</h2>
        <p class="lead about__text">
          Начинали с одной витрины: пекли по утрам ровно столько, сколько успевали продать за день.
          За шесть лет добавились вторая точка, кухня с завтраками и кейтеринг на большие праздники
          — а правило осталось прежним.
        </p>
        <p class="lead about__text">
          Ничего не закупаем на стороне. Торты, пирожные и конфеты делаем сами — из того же, что
          поставили бы себе на стол.
        </p>

        <ul class="about__facts">
          {facts.map((fact) => <li>{fact}</li>)}
        </ul>
      </div>

      <div class="about__grid">
        {
          aboutPhotos.map((photo, i) => (
            <Photo
              photo={photo}
              ratio={i === 0 ? '16 / 10' : '1 / 1'}
              sizes="(min-width: 1200px) 320px, 45vw"
              class={i === 0 ? 'about__photo about__photo--wide' : 'about__photo'}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--gap) + 18px);
    align-items: center;
  }

  .about__text {
    margin-top: 14px;
  }

  .about__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .about__facts li {
    padding: 7px 14px;
    border: 1px solid #e1e4cb;
    border-radius: var(--r-pill);
    background: #f1f2e7;
    font-size: 12.5px;
    color: var(--olive-dark);
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
  }

  /* `:global`, потому что класс висит на корне дочернего `Photo.astro`,
     а scoped-атрибут у него свой — без этого правило не матчится */
  .about__grid > :global(.about__photo--wide) {
    grid-column: span 2;
  }

  @media (min-width: 1000px) {
    .about {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>
