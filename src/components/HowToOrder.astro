---
import MessengerButtons from './MessengerButtons.astro';
import type { Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

const { settings, places } = Astro.props.content;
const streets = places.map((place) => place.street).join(' и ');
---

<section class="section" id="how">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="kicker">Три способа</p>
        <h2>Как заказать</h2>
        <p class="lead">
          Забрать с витрины сегодня, привезти домой к ужину или собрать торт под событие —
          выбирайте по срокам.
        </p>
      </div>
      <a class="how__phone" href={settings.phoneHref}>{settings.phone}</a>
    </div>

    <div class="how__grid">
      <article class="how__card">
        <div class="card-top">
          <span class="card-mark">1</span>
          <span class="card-dash"></span>
          <span class="card-pill">20–40 минут</span>
        </div>
        <h3 class="how__title">Доставка</h3>
        <p class="how__text">
          Каталог, корзина и оплата — в магазине <b>vkusdostavka.shop</b>. Там же завтраки, супы и
          паста. Есть приложения для iOS и Android.
        </p>
        <div class="how__foot">
          <a class="btn btn--secondary btn--md" href={settings.shop_url} target="_blank" rel="noopener">
            В магазин
          </a>
        </div>
      </article>

      <article class="how__card">
        <div class="card-top">
          <span class="card-mark">2</span>
          <span class="card-dash"></span>
          <span class="card-pill">Сегодня</span>
        </div>
        <h3 class="how__title">Самовывоз</h3>
        <p class="how__text">
          То, что стоит на витрине, можно просто забрать с любой из двух точек: {streets}. Часы у них
          разные — смотрите в контактах.
        </p>
        <div class="how__foot">
          <a class="btn btn--secondary btn--md" href="#contacts">Адреса и часы</a>
        </div>
      </article>

      <article class="how__card how__card--hi">
        <div class="blob" aria-hidden="true"></div>
        <div class="card-top">
          <span class="card-mark card-mark--light">3</span>
          <span class="card-dash card-dash--light"></span>
          <span class="card-pill card-pill--light">48 часов</span>
        </div>
        <h3 class="how__title">Торт на заказ</h3>
        <p class="how__text">
          Готовая модель или своя картинка. Меняем цвет и надпись, считаем стоимость в тот же день.
        </p>
        <div class="how__foot">
          <MessengerButtons settings={settings} variant="light" size="md" />
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .how__phone {
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--terracotta-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .how__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--gap) + 2px);
    margin-top: 26px;
    align-items: stretch;
  }

  .how__card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: calc(var(--gap) + 10px);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--bg);
  }

  .how__card--hi {
    border-color: var(--olive);
    background: var(--olive);
    color: var(--bg);
  }

  .how__title {
    position: relative;
    z-index: 1;
    margin: 20px 0 8px;
    font-size: calc(var(--fs-h3) + 3px);
    line-height: 1.12;
  }

  .how__text {
    position: relative;
    z-index: 1;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--text-2);
  }

  .how__card--hi .how__text {
    color: var(--bg);
  }

  .how__foot {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: 18px;
  }

  @media (min-width: 768px) {
    .how__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
