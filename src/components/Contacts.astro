---
import YandexMap from './YandexMap.astro';
import MessengerButtons from './MessengerButtons.astro';
import OpenStatus from './OpenStatus.astro';
import { hoursRows, yandexOrgUrl, yandexRouteUrl, yandexWidgetUrl } from '../data/site';
import yandexPin from '../assets/icons/yandex-maps.svg?raw';
import type { Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { places, settings, home } = content;
---

<section class="section" id="contacts">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="kicker">Две точки в городе</p>
        <h2>Контакты</h2>
      </div>
    </div>

    <div class="ct">
      <div class="ct__col">
        {
          places.map((place) => (
            <article class="ct__card" data-place>
              <div class="card-top">
                <span class="card-mark card-mark--sm">{place.n}</span>
                <span class="card-dash" />
                <OpenStatus schedule={place.schedule} />
              </div>

              <h3 class="ct__name">{place.name}</h3>
              <p class="ct__note">{place.kind}</p>
              <a class="ct__tel" href={place.phoneHref}>{place.phone}</a>

              <dl class="ct__hours">
                {hoursRows(place.schedule).map((row) => (
                  <div class="ct__hours-row">
                    <dt>{row.days}</dt>
                    <dd class="tnum">{row.hours}</dd>
                  </div>
                ))}
              </dl>

              <div class="ct__actions">
                <a
                  class="btn btn--primary btn--md ct__route"
                  href={yandexRouteUrl(place)}
                  target="_blank"
                  rel="noopener"
                >
                  <span class="ct__ya" aria-hidden="true">
                    <Fragment set:html={yandexPin} />
                  </span>
                  Построить маршрут
                </a>
                {/* обе ветки карты: `data-frame-target` — виджет с центром на точке
                    (обе метки остаются), `data-map-focus` — JS API */}
                <button
                  type="button"
                  class="btn btn--secondary btn--md ct__show"
                  data-frame-target="map"
                  data-src={yandexWidgetUrl(places, place)}
                  data-frame-name={place.name}
                  data-map-focus={String(place.id)}
                  aria-pressed="false"
                >
                  Показать на карте
                </button>
              </div>

              <a
                class="ct__org"
                href={yandexOrgUrl(place.yandex_org)}
                target="_blank"
                rel="noopener"
              >
                Открыть в Яндекс Картах
              </a>
            </article>
          ))
        }
      </div>

      <div class="ct__right">
        <YandexMap content={content} />

        <div class="ct__write">
          <div class="blob" aria-hidden="true"></div>
          <div class="ct__write-col">
            <p class="ct__write-title">Написать нам</p>
            <p class="ct__write-sub">{home.contacts_note}</p>
          </div>
          <MessengerButtons settings={settings} variant="light" size="lg" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ct {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--gap) + 6px);
    align-items: start;
    margin-top: 26px;
  }

  .ct__col,
  .ct__right {
    display: flex;
    flex-direction: column;
    gap: calc(var(--gap) + 2px);
  }

  .ct__card {
    display: flex;
    flex-direction: column;
    padding: calc(var(--gap) + 4px);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg);
    transition: border-color 0.16s ease;
  }

  /* точка, на которой сейчас стоит карта; изначально карта показывает обе */
  .ct__card.is-shown {
    border-color: var(--line-4);
  }

  .ct__name {
    margin: 14px 0 4px;
    font-size: calc(var(--fs-h3) + 1px);
    line-height: 1.12;
  }

  .ct__note {
    font-size: calc(var(--fs-body) - 0.5px);
    color: var(--text-4);
  }

  /* свой номер у каждой точки — крупнее часов, как заголовок карточки */
  .ct__tel {
    align-self: flex-start;
    margin-top: 10px;
    padding-block: 2px;
    font-weight: var(--fw-heading);
    font-size: calc(var(--fs-h3) + 1px);
    letter-spacing: var(--ls-heading);
    font-variant-numeric: tabular-nums;
    text-decoration: none;
  }

  .ct__hours {
    margin: 12px 0 16px;
    padding: 12px 0 0;
    border-top: 1px solid var(--line-3);
  }

  .ct__hours-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .ct__hours-row + .ct__hours-row {
    margin-top: 4px;
  }

  .ct__hours dt {
    flex: 0 0 auto;
    min-width: 62px;
    font-size: 12px;
    color: var(--text-5);
  }

  .ct__hours dd {
    margin: 0;
    font-size: calc(var(--fs-body) - 0.5px);
    font-weight: 600;
  }

  .ct__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
  }

  /* подчёркивание, а не рамка: паддинг растит зону нажатия, не сдвигая линию */
  .ct__org {
    align-self: flex-start;
    margin-top: 3px;
    padding-block: 9px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-3);
    text-decoration: underline;
    text-decoration-color: var(--line-4);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition:
      color 0.16s ease,
      text-decoration-color 0.16s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .ct__org:hover {
      color: var(--text);
      text-decoration-color: var(--text);
    }

    .ct__tel:hover {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  /* «Построить маршрут» шире соседа: на телефоне кнопки встают друг под другом */
  .ct__route {
    flex: 1 1 190px;
  }

  .ct__show {
    flex: 1 1 150px;
  }

  /* логотип Яндекс Карт — единственный цветной значок на кнопке; кремовый
     кружок держит красный пин читаемым на оливковой заливке */
  .ct__ya {
    display: grid;
    place-items: center;
    flex: none;
    width: 24px;
    height: 24px;
    margin-left: -8px;
    border-radius: var(--r-pill);
    background: var(--bg);
  }

  .ct__ya :global(svg) {
    width: 15px;
    height: 15px;
  }

  /* карта не загрузилась — кнопке некуда вести; `.btn` перебивает `[hidden]` */
  .ct__show[hidden] {
    display: none;
  }

  .ct__show[aria-pressed='true'] {
    border-color: var(--line-4);
    background: color-mix(in srgb, var(--text) 5%, transparent);
  }

  .ct__write {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: calc(var(--gap) + 10px);
    border-radius: var(--r-xl);
    background: var(--olive);
  }

  .ct__write-col {
    position: relative;
    z-index: 1;
  }

  .ct__write-title {
    margin-bottom: 6px;
    font-weight: var(--fw-heading);
    font-size: calc(var(--fs-h3) + 2px);
    line-height: 1.12;
    letter-spacing: var(--ls-heading);
    color: var(--bg);
  }

  .ct__write-sub {
    font-size: calc(var(--fs-body) - 0.5px);
    line-height: 1.5;
    color: var(--bg);
  }

  .ct__write :global(.messengers) {
    position: relative;
    z-index: 1;
  }

  /* карточки в две колонки: иначе карта уезжает на второй экран */
  @media (min-width: 700px) and (max-width: 999px) {
    .ct__col {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }

    .ct__card {
      height: 100%;
    }
  }

  /* карта помещается рядом с карточками */
  @media (min-width: 1000px) {
    .ct {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>
