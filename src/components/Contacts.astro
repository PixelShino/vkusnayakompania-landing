---
/**
 * Contacts: two venue blocks and the messenger panel in the container, the
 * map as a full-width band under them, touching the footer (Green Park). One
 * action per venue — the route; the map switch and the Maps link live on the
 * map bar itself, so nothing is said three times.
 * Контакты: два блока точек и панель мессенджеров в контейнере, карта —
 * полосой во всю ширину под ними, вплотную к подвалу (Green Park). У точки
 * одно действие — маршрут; переключатель карты и ссылка на Карты живут на
 * планке самой карты, и ничего не говорится трижды.
 */
import YandexMap from './YandexMap.astro';
import MessengerButtons from './MessengerButtons.astro';
import OpenStatus from './OpenStatus.astro';
import { hoursRows, yandexRouteUrl } from '../data/site';
import yandexPin from '../assets/icons/yandex-maps.svg?raw';
import type { Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { places, settings, home } = content;
---

<section class="section ct-sec" id="contacts">
  <div class="container">
    <div class="head">
      <span class="mark" aria-hidden="true"></span>
      <h2 class="display-caps">Контакты</h2>
      <p class="lead">Две точки в городе</p>
    </div>

    <div class="ct">
      {
        places.map((place) => (
          <article class="ct__card">
            <h3 class="ct__name display">{place.name}</h3>
            {/* the kind and the status as two short lines, the status olive when
                open — in one line the dot dangled at the wrap on every width
                тип и статус двумя короткими строками, статус оливой когда открыто —
                в одну строку точка повисала на переносе на любой ширине */}
            <p class="ct__note">{place.kind}</p>
            <OpenStatus schedule={place.schedule} class="ct__status" />
            <a class="ct__tel" href={place.phoneHref}>{place.phone}</a>

            <dl class="ct__hours">
              {hoursRows(place.schedule).map((row) => (
                <div class="ct__hours-row">
                  <dt>{row.days}</dt>
                  <dd class="tnum">{row.hours}</dd>
                </div>
              ))}
            </dl>

            {/* the one action: the route opens Maps from the guest's location
                единственное действие: маршрут открывает Карты от места гостя */}
            <a
              class="btn btn--primary btn--md ct__route"
              href={yandexRouteUrl(place)}
              target="_blank"
              rel="noopener"
            >
              <span class="ct__ya" aria-hidden="true">
                <Fragment set:html={yandexPin} />
              </span>
              Построить маршрут
            </a>
          </article>
        ))
      }

      <div class="ct__write">
        <div class="ct__write-col">
          <h3 class="ct__write-title display">Написать нам</h3>
          <p class="ct__write-sub">{home.contacts_note}</p>
        </div>
        <MessengerButtons settings={settings} variant="light" size="lg" class="ct__msg" />
      </div>
    </div>
  </div>

  <YandexMap content={content} />
</section>

<style>
  /* the map band closes the section and meets the footer with no cream gap
     полоса карты закрывает секцию и встречает подвал без кремового зазора */
  .ct-sec {
    padding-bottom: 0;
  }

  /* stretch: both route buttons end on one line even when one venue lists
     three rows of hours and the other one
     stretch: обе кнопки маршрута кончаются на одной линии, даже когда у одной
     точки три строки часов, а у другой одна */
  .ct {
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
    align-items: stretch;
    margin-top: 26px;
  }

  /* Venue blocks without a frame: text on paper with a hairline between them.
     Блоки точек без рамки: текст на бумаге и волосяная линия между ними. */
  .ct__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-block: 4px 0;
  }

  .ct__card + .ct__card {
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .ct__name {
    margin-bottom: 6px;
    font-size: clamp(24px, 6vw, 28px);
    line-height: 1.1;
  }

  .ct__note {
    font-size: calc(var(--fs-body) - 0.5px);
    font-weight: 600;
    color: var(--text-3);
  }

  /* `:global` — the class sits on the child component's root
     `:global` — класс лежит на корне дочернего компонента */
  .ct__card :global(.ct__status) {
    margin-top: 2px;
    font-size: calc(var(--fs-body) - 0.5px);
    color: var(--text-3);
  }

  /* свой номер у каждой точки — крупнее часов, как заголовок карточки */
  .ct__tel {
    margin-top: 10px;
    padding-block: 2px;
    font-weight: var(--fw-heading);
    font-size: calc(var(--fs-h3) + 1px);
    letter-spacing: var(--ls-heading);
    font-variant-numeric: tabular-nums;
    text-decoration: none;
  }

  .ct__hours {
    align-self: stretch;
    margin: 12px 0 18px;
    padding: 12px 0 0;
    border-top: 1px solid var(--line-3);
  }

  .ct__hours-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .ct__hours-row + .ct__hours-row {
    margin-top: 4px;
  }

  .ct__hours dt {
    flex: 0 0 auto;
    min-width: 62px;
    font-size: 12px;
    color: var(--text-5);
  }

  .ct__hours dd {
    margin: 0;
    font-size: calc(var(--fs-body) - 0.5px);
    font-weight: 600;
  }

  /* the number is a 28 px line: on touch it grows to 44 px without moving
     номер — строка 28 px: на таче растёт до 44 px, не сдвигаясь */
  @media (pointer: coarse) {
    .ct__tel {
      padding-block: 8px;
      /* the 10 px top margin minus the 6 px the padding adds above the text
         верхний отступ 10 px минус 6 px, которые поле добавляет над текстом */
      margin-block: 4px -6px;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .ct__tel:hover {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  /* full width on the phone: one button per block, the thumb finds it
     на телефоне во всю ширину: одна кнопка на блок, палец её находит */
  .ct__route {
    width: 100%;
    margin-top: auto;
  }

  /* логотип Яндекс Карт — единственный цветной значок на кнопке; кремовый
     кружок держит красный пин читаемым на оливковой заливке */
  .ct__ya {
    display: grid;
    place-items: center;
    flex: none;
    width: 24px;
    height: 24px;
    margin-left: -8px;
    border-radius: var(--r-pill);
    background: var(--bg);
  }

  .ct__ya :global(svg) {
    width: 15px;
    height: 15px;
  }

  .ct__write {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: calc(var(--gap) + 10px);
    border-radius: var(--r-sq);
    background: var(--olive);
  }

  .ct__write-title {
    margin-bottom: 6px;
    font-size: 24px;
    line-height: 1.12;
    color: var(--bg);
  }

  .ct__write-sub {
    font-size: calc(var(--fs-body) - 0.5px);
    line-height: 1.5;
    color: var(--bg);
  }

  /* tablet: the two venues side by side with a rule between, the messenger
     panel as a wide row under them — copy left, buttons right
     планшет: две точки рядом с линией между ними, панель мессенджеров широкой
     строкой под ними — текст слева, кнопки справа */
  @media (min-width: 768px) {
    .ct {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 32px;
      margin-top: 32px;
    }

    .ct__card + .ct__card {
      padding-top: 4px;
      padding-left: 32px;
      border-top: 0;
      border-left: 1px solid var(--line);
    }

    .ct__route {
      width: auto;
    }

    .ct__write {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 24px 32px;
      padding: 26px 30px;
    }

    .ct__write-col {
      max-width: 44ch;
    }

    .ct__write :global(.ct__msg) {
      flex: none;
    }
  }

  /* desktop: venue · venue · panel in one row, the panel back to a column
     десктоп: точка · точка · панель в один ряд, панель снова столбиком */
  @media (min-width: 1200px) {
    .ct {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 40px;
      margin-top: 36px;
    }

    .ct__card + .ct__card {
      padding-left: 40px;
    }

    .ct__write {
      grid-column: auto;
      flex-direction: column;
      align-items: stretch;
      justify-content: center;
      gap: 18px;
      padding: 30px 32px;
    }

    .ct__write-col {
      max-width: none;
    }

    .ct__write :global(.ct__msg) {
      flex: initial;
    }
  }
</style>
