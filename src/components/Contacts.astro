---
import YandexMap from './YandexMap.astro';
import MessengerButtons from './MessengerButtons.astro';
import OpenStatus from './OpenStatus.astro';
import { hoursRows, yandexOrgUrl, yandexRouteUrl, yandexWidgetUrl } from '../data/site';
import yandexPin from '../assets/icons/yandex-maps.svg?raw';
import type { Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { places, settings, home } = content;
---

<section class="section" id="contacts">
  <div class="container">
    <div class="head">
      <span class="mark" aria-hidden="true"></span>
      <h2 class="display-caps">Контакты</h2>
      <p class="lead">Две точки в городе</p>
    </div>

    <div class="ct">
      <div class="ct__col">
        {
          places.map((place) => (
            <article class="ct__card" data-place>
              <h3 class="ct__name display">{place.name}</h3>
              {/* status as words on the meta line, olive when open — no pill, no number
                  статус словами в строке меты, оливой когда открыто — без пилюли и номера */}
              <p class="ct__note">
                {place.kind}
                <span class="ct__dot" aria-hidden="true">
                  {' · '}
                </span>
                <OpenStatus schedule={place.schedule} class="ct__status" />
              </p>
              <a class="ct__tel" href={place.phoneHref}>{place.phone}</a>

              <dl class="ct__hours">
                {hoursRows(place.schedule).map((row) => (
                  <div class="ct__hours-row">
                    <dt>{row.days}</dt>
                    <dd class="tnum">{row.hours}</dd>
                  </div>
                ))}
              </dl>

              <div class="ct__actions">
                <a
                  class="btn btn--primary btn--md ct__route"
                  href={yandexRouteUrl(place)}
                  target="_blank"
                  rel="noopener"
                >
                  <span class="ct__ya" aria-hidden="true">
                    <Fragment set:html={yandexPin} />
                  </span>
                  Построить маршрут
                </a>
                {/* обе ветки карты: `data-frame-target` — виджет с центром на точке
                    (обе метки остаются), `data-map-focus` — JS API */}
                <button
                  type="button"
                  class="btn btn--secondary btn--md ct__show"
                  data-frame-target="map"
                  data-src={yandexWidgetUrl(places, place)}
                  data-frame-name={place.name}
                  data-map-focus={String(place.id)}
                  aria-pressed="false"
                >
                  Показать на карте
                </button>
              </div>

              <a
                class="tlink ct__org"
                href={yandexOrgUrl(place.yandex_org)}
                target="_blank"
                rel="noopener"
              >
                Открыть в Яндекс Картах
              </a>
            </article>
          ))
        }
      </div>

      <div class="ct__right">
        <YandexMap content={content} />

        <div class="ct__write">
          <div class="ct__write-col">
            <h3 class="ct__write-title display">Написать нам</h3>
            <p class="ct__write-sub">{home.contacts_note}</p>
          </div>
          <MessengerButtons settings={settings} variant="light" size="lg" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ct {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--gap) + 6px);
    align-items: start;
    margin-top: 26px;
  }

  .ct__col,
  .ct__right {
    display: flex;
    flex-direction: column;
    gap: calc(var(--gap) + 2px);
  }

  /* Venue blocks without a frame: text on paper with a hairline between the
     two — next to the framed map a second box only added noise. `.is-shown`
     (the venue the map is centred on) is carried by the pressed button alone.
     Блоки точек без рамки: текст на бумаге и волосяная линия между ними —
     рядом с картой в рамке второй короб только шумел. `.is-shown` (точка, на
     которой стоит карта) держится на нажатой кнопке. */
  .ct__card {
    display: flex;
    flex-direction: column;
    padding-block: 4px 22px;
  }

  .ct__card + .ct__card {
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .ct__name {
    margin-bottom: 6px;
    font-size: clamp(24px, 6vw, 28px);
    line-height: 1.1;
  }

  .ct__note {
    font-size: calc(var(--fs-body) - 0.5px);
    font-weight: 600;
    color: var(--text-3);
  }

  .ct__dot {
    color: var(--text-4);
  }

  /* on a narrow phone the status takes its own line, no dot left dangling
     на узком телефоне статус уходит на свою строку, точка в конце не висит */
  @media (max-width: 399px) {
    .ct__dot {
      display: none;
    }

    .ct__note :global(.ct__status) {
      display: block;
    }
  }

  /* свой номер у каждой точки — крупнее часов, как заголовок карточки */
  .ct__tel {
    align-self: flex-start;
    margin-top: 10px;
    padding-block: 2px;
    font-weight: var(--fw-heading);
    font-size: calc(var(--fs-h3) + 1px);
    letter-spacing: var(--ls-heading);
    font-variant-numeric: tabular-nums;
    text-decoration: none;
  }

  .ct__hours {
    margin: 12px 0 16px;
    padding: 12px 0 0;
    border-top: 1px solid var(--line-3);
  }

  .ct__hours-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .ct__hours-row + .ct__hours-row {
    margin-top: 4px;
  }

  .ct__hours dt {
    flex: 0 0 auto;
    min-width: 62px;
    font-size: 12px;
    color: var(--text-5);
  }

  .ct__hours dd {
    margin: 0;
    font-size: calc(var(--fs-body) - 0.5px);
    font-weight: 600;
  }

  .ct__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
  }

  /* `.tlink` from the vocabulary; its negative margins are reset so the link
     sits under the buttons at its own distance
     `.tlink` из словаря; его отрицательные поля сброшены, чтобы ссылка стояла
     под кнопками на своём расстоянии */
  .ct__org {
    align-self: flex-start;
    margin-block: 6px 0;
    font-size: 12.5px;
    color: var(--text-3);
  }

  @media (hover: hover) and (pointer: fine) {
    .ct__tel:hover {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  /* «Построить маршрут» шире соседа: на телефоне кнопки встают друг под другом */
  .ct__route {
    flex: 1 1 190px;
  }

  .ct__show {
    flex: 1 1 150px;
  }

  /* логотип Яндекс Карт — единственный цветной значок на кнопке; кремовый
     кружок держит красный пин читаемым на оливковой заливке */
  .ct__ya {
    display: grid;
    place-items: center;
    flex: none;
    width: 24px;
    height: 24px;
    margin-left: -8px;
    border-radius: var(--r-pill);
    background: var(--bg);
  }

  .ct__ya :global(svg) {
    width: 15px;
    height: 15px;
  }

  /* карта не загрузилась — кнопке некуда вести; `.btn` перебивает `[hidden]` */
  .ct__show[hidden] {
    display: none;
  }

  .ct__show[aria-pressed='true'] {
    border-color: var(--line-4);
    background: color-mix(in srgb, var(--text) 5%, transparent);
  }

  .ct__write {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: calc(var(--gap) + 10px);
    border-radius: var(--r-sq);
    background: var(--olive);
  }

  .ct__write-title {
    margin-bottom: 6px;
    font-size: 24px;
    line-height: 1.12;
    color: var(--bg);
  }

  .ct__write-sub {
    font-size: calc(var(--fs-body) - 0.5px);
    line-height: 1.5;
    color: var(--bg);
  }

  /* блоки в две колонки: иначе карта уезжает на второй экран; линия между
     ними встаёт вертикально */
  @media (min-width: 700px) and (max-width: 999px) {
    .ct__col {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }

    .ct__card {
      height: 100%;
    }

    .ct__card + .ct__card {
      padding-top: 4px;
      padding-left: 24px;
      border-top: 0;
      border-left: 1px solid var(--line);
    }
  }

  /* карта помещается рядом с карточками */
  @media (min-width: 1000px) {
    .ct {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>
