---
/**
 * Cake showcase as an even grid under a centred head: every frame is the same
 * 4:5 plate, a pending photo stands as a hatched plaque with the name on it.
 * The uneven grid with a two-row lead tile made one placeholder 1200 px tall.
 * The cakes are the catalog's «Праздничные торты» (`cakeShowcase`, the very
 * section the shelves of `/cakes/` are cut from): photo, name, price, sizes
 * with the lead time; the card leads to the cake's window in the catalog.
 * Витрина тортов ровной сеткой под заголовком по оси: каждый кадр — одна
 * плашка 4:5, неснятое фото стоит штрихованной плашкой с названием. Неровная
 * сетка с доминантой в две строки растягивала одну заглушку до 1200 px.
 * Торты — раздел каталога «Праздничные торты» (`cakeShowcase`, тот самый
 * раздел, из которого режутся полки `/cakes/`): фото, название, цена, размеры
 * со сроком; карточка ведёт в окно торта в каталоге.
 */
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import type { Content } from '../lib/content.ts';
import { priceLabel, type Product } from '../lib/catalog.ts';
import { catalogSectionHref } from '../lib/nav.ts';
import { BASE } from '../lib/base.ts';
import { cakeShowcase } from '../data/landings-shop.ts';

interface Props {
  content: Content;
}

const { home } = Astro.props.content;
// the home page draws the section only when the showcase exists (`index.astro`)
// главная рисует секцию, только когда витрина есть (`index.astro`)
const cakes = cakeShowcase(Astro.props.content)?.cakes ?? [];
// «Торты в наличии» is a section of our own catalog; without such a section
// the button opens the catalog page itself
// «Торты в наличии» — раздел своего каталога; без такого раздела кнопка
// открывает саму страницу каталога
const ready = catalogSectionHref(Astro.props.content, 'torty-v-nalichii') ?? `${BASE}catalog/`;

// one rule for every block: normalization decides what is a placeholder; a
// dish without a photo stands as a plaque too
// одно правило на все блоки: что заглушка, решает нормализация; блюдо без
// фото тоже стоит плашкой
const shot = (product: Product) => (product.photo && !product.photo.placeholder ? product.photo : undefined);

// the cake's window in the catalog — the address of a tile on `/cakes/`
// окно торта в каталоге — тот же адрес, что у плитки на `/cakes/`
const href = (product: Product) => `${BASE}catalog/#p-${product.slug}`;

const SIZES = '(min-width: 1200px) 309px, (min-width: 768px) 243px, 45vw';
---

<section class="section" id="cakes">
  <div class="container">
    <div class="head" data-reveal>
      <span class="mark" aria-hidden="true"></span>
      <h2 class="display-caps">{home.cakes_title}</h2>
      {home.cakes_text && <p class="lead">{home.cakes_text}</p>}

      <div class="cakes__actions">
        <button
          type="button"
          class="btn btn--primary"
          data-book="Торт на заказ"
          data-book-note="Пришлите картинку, посчитаем в тот же день"
        >
          Торт на заказ
        </button>
        <a
          class="btn btn--secondary"
          href={ready}
        >
          Торты в наличии
        </a>
      </div>
    </div>

    <div class="cakes__grid" id="cakes-grid" data-cakes-grid data-reveal="grid">
      {
        cakes.map(({ product, note }) => {
          const photo = shot(product);
          return (
            <article class:list={['cake-card', { 'cake-card--out': !product.available }]}>
              {photo ? (
                <Photo photo={photo} ratio="4 / 5" sizes={SIZES} />
              ) : (
                <figure class="stub cake-stub">
                  {/* название видно на плашке, а читается из ссылки ниже: под кадром у заглушки остаются цена, вес и срок
                      the name shows on the plaque and is read from the link below: the caption keeps price, weight and lead time */}
                  <span class="stub__title" aria-hidden="true">{product.title}</span>
                  <span class="stub__meta">фото скоро появится</span>
                </figure>
              )}

              <div class="cake__cap">
                <a class="cake__name" href={href(product)}>
                  <span class:list={[{ cake__hide: !photo }]}>{product.title}</span>
                </a>
                <span class="cake__price tnum">
                  {!product.available && <span class="cake__out">Нет в наличии</span>}
                  {priceLabel(product)}
                </span>
                {note && <span class="tag tnum">{note}</span>}
              </div>
            </article>
          );
        })
      }
    </div>

    <div class="cakes__more">
      <button
        type="button"
        class="btn btn--secondary"
        data-cakes-toggle
        aria-expanded="false"
        aria-controls="cakes-grid"
      >
        <Icon name="chevron-down" class="ico--down" />
        Показать ещё
      </button>
    </div>
  </div>
</section>

<style>
  /* the section's two buttons on the axis, like the first screen
     две кнопки секции по оси, как на первом экране */
  .cakes__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 12px;
    margin-top: 22px;
  }

  .cakes__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px var(--gap);
    /* карточка не тянется по высоте ряда: длинная подпись остаётся длинной
       cards never stretch to the row height: a long caption stays long */
    align-items: start;
    margin-top: 32px;
  }

  .cake-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  /* лимит витрины живёт только здесь: свёрнутая показывает целые ряды — восемь
     на двух и четырёх колонках, шесть на трёх
     the shelf limit lives here alone: collapsed shows whole rows — eight on two
     and four columns, six on three */
  .cakes__grid:not(.is-open) > .cake-card:nth-child(n + 9) {
    display: none;
  }

  /* тортов не больше, чем видно — раскрывать нечего, кнопки нет
     no more cakes than shown — nothing to unfold, no button */
  .cakes__grid:not(:has(> :nth-child(9))) + .cakes__more {
    display: none;
  }

  .cakes__more {
    display: flex;
    justify-content: center;
    margin-top: 28px;
  }

  /* The plate reads its fill from two properties so the ink rhythm below can
     switch it without repeating the stub styles.
     Плашка берёт заливку из двух свойств: ритм чернил ниже переключает её,
     не повторяя стили заглушки. */
  .cake-stub {
    aspect-ratio: 4 / 5;
    margin: 0;
    background-color: var(--plate, var(--surface-warm));
    background-image: var(--plate-hatch, var(--hatch));
    color: var(--plate-ink, var(--text));
  }

  .cake-stub .stub__meta {
    color: var(--plate-meta, inherit);
  }

  /* a 136 px tile on a 320 screen: «Шоколадный» ran past the edge at 20 px
     with 20 px padding — 16 px on 10 px padding fits the longest name whole;
     `anywhere` is not used: it cut «Шоколадны/й» before hyphenation could
     плитка 136 px на экране 320: «Шоколадный» вылезал за край при 20 px и
     полях 20 px — 16 px на полях 10 px вмещает самое длинное имя целиком;
     `anywhere` не берётся: оно резало «Шоколадны/й» раньше переноса */
  @media (max-width: 359px) {
    .cake-stub {
      padding: 14px 10px;
    }

    .cake-stub .stub__title {
      font-size: 16px;
      hyphens: auto;
    }
  }

  /* Ink plates step diagonally — one per row, never a column. An index from
     the markup lined them up on three columns, so the rhythm is set per column
     count, each in its own width range: 2nd and 3rd of four on two columns,
     2nd and 6th of six on three, 2nd and 7th of eight on four.
     Чернильные плашки идут по диагонали — по одной в ряду, никогда столбцом.
     Индекс из разметки выстраивал их в колонку на трёх столбцах, поэтому ритм
     задаётся на каждое число колонок в своём диапазоне ширин: 2-я и 3-я из
     четырёх на двух, 2-я и 6-я из шести на трёх, 2-я и 7-я из восьми на четырёх. */
  @media (max-width: 767.98px) {
    .cake-card:nth-child(4n + 2) > .cake-stub,
    .cake-card:nth-child(4n + 3) > .cake-stub {
      --plate: var(--ink);
      --plate-hatch: var(--hatch-ink);
      --plate-ink: var(--on-ink);
      --plate-meta: var(--on-ink-2);
    }
  }

  @media (min-width: 768px) and (max-width: 1199.98px) {
    .cake-card:nth-child(6n + 2) > .cake-stub,
    .cake-card:nth-child(6n + 6) > .cake-stub {
      --plate: var(--ink);
      --plate-hatch: var(--hatch-ink);
      --plate-ink: var(--on-ink);
      --plate-meta: var(--on-ink-2);
    }
  }

  @media (min-width: 1200px) {
    .cake-card:nth-child(8n + 2) > .cake-stub,
    .cake-card:nth-child(8n + 7) > .cake-stub {
      --plate: var(--ink);
      --plate-hatch: var(--hatch-ink);
      --plate-ink: var(--on-ink);
      --plate-meta: var(--on-ink-2);
    }
  }

  .cake__cap {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cake__name {
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: 1.25;
    color: var(--text);
    text-decoration: none;
    text-wrap: balance;
    transition: color 0.16s ease;
  }

  /* the name's link covers the whole card: one stop for the keyboard, the whole card for the finger
     ссылка названия накрывает всю карточку: одна остановка для клавиатуры, вся карточка для пальца */
  .cake__name::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .cake__name:focus-visible {
    outline: none;
  }

  .cake__name:focus-visible::after {
    outline: 2px solid var(--terracotta);
    outline-offset: 4px;
    border-radius: var(--r-md);
  }

  /* у заглушки имя уже на плашке: в подписи оно только для скринридера, а
     накрывающая ссылка остаётся — прячется текст, не сама ссылка
     a stub has the name on its plaque: in the caption it is for screen readers
     only, and the covering link stays — the text is hidden, not the link */
  .cake__hide {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .cake__price {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
    margin-top: 2px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
  }

  .cake__out {
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* торт, который сейчас не принимают, — как в каталоге: кадр гаснет
     a cake not taken right now looks as in the catalog: the frame fades */
  .cake-card--out .media img {
    filter: grayscale(1);
    opacity: 0.5;
  }

  .cake-card--out .cake__price {
    color: var(--text-4);
  }

  @media (min-width: 768px) {
    .cakes__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px var(--gap);
      margin-top: 36px;
    }

    .cakes__grid:not(.is-open) > .cake-card:nth-child(n + 7) {
      display: none;
    }

    .cakes__grid:not(:has(> :nth-child(7))) + .cakes__more {
      display: none;
    }

  }

  @media (min-width: 1200px) {
    .cakes__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin-top: 40px;
    }

    /* `flex`, not `revert`: `revert` gives the UA `block`, and the 8 px gap under the photo is lost
       `flex`, а не `revert`: `revert` даёт браузерный `block`, и зазор 8 px под фото пропадает */
    .cakes__grid:not(.is-open) > .cake-card:nth-child(n + 7) {
      display: flex;
    }

    .cakes__grid:not(.is-open) > .cake-card:nth-child(n + 9) {
      display: none;
    }

    .cakes__grid:not(:has(> :nth-child(7))) + .cakes__more {
      display: flex;
    }

    .cakes__grid:not(:has(> :nth-child(9))) + .cakes__more {
      display: none;
    }

  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('[data-cakes-grid]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-cakes-toggle]');

  if (grid && toggle) {
    toggle.addEventListener('click', () => {
      const open = grid.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = open ? 'Свернуть' : 'Показать ещё';
    });
  }
</script>
