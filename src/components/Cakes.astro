---
/**
 * Cake showcase: photos only, no filters and no prices — the order goes through
 * the booking dialog or the delivery shop.
 * Витрина работ: только фото, без фильтров и цен — заказ уходит в диалог брони
 * или в магазин доставки. Сколько тортов видно до «Показать ещё» — решает CSS.
 */
import Photo from './Photo.astro';
import type { Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

const { cakes, settings, home } = Astro.props.content;
const shop = settings.shop_cakes_ready ?? settings.shop_url;
---

<section class="section" id="cakes">
  <div class="container">
    <div class="section-head">
      <div>
        <h2>{home.cakes_title}</h2>
        {home.cakes_text && <p class="lead">{home.cakes_text}</p>}
      </div>

      <div class="cakes__actions">
        <button
          type="button"
          class="btn btn--primary btn--sm"
          data-book="Торт на заказ"
          data-book-note="Пришлите картинку, посчитаем в тот же день"
        >
          Торт на заказ
        </button>
        <a class="btn btn--secondary btn--sm" href={shop} target="_blank" rel="noopener">
          Торты в наличии
        </a>
      </div>
    </div>

    <div class="cakes__grid" id="cakes-grid" data-cakes-grid>
      {
        cakes.map((cake) => (
          <Photo
            photo={cake.photo}
            ratio="3 / 4"
            class="cake"
            sizes="(min-width: 1200px) 310px, (min-width: 768px) 243px, 45vw"
          >
            <figcaption class="cake__caption">
              <span class="cake__name">{cake.title}</span>
              {cake.note && <span class="cake__meta">{cake.note}</span>}
            </figcaption>
          </Photo>
        ))
      }
    </div>

    <div class="cakes__more">
      <button
        type="button"
        class="btn btn--secondary btn--md"
        data-cakes-toggle
        aria-expanded="false"
        aria-controls="cakes-grid"
      >
        Показать ещё
      </button>
    </div>
  </div>
</section>

<style>
  .cakes__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .cakes__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap);
    margin-top: 24px;
  }

  /* лимит витрины живёт только здесь: свёрнутая показывает первые восемь.
     `:global` — кадры рисует `Photo.astro`, метки области у них нет */
  .cakes__grid:not(.is-open) > :global(:nth-child(n + 9)) {
    display: none;
  }

  /* тортов не больше восьми — раскрывать нечего, кнопки нет */
  .cakes__grid:not(:has(> :nth-child(9))) + .cakes__more {
    display: none;
  }

  .cakes__more {
    display: flex;
    margin-top: 24px;
  }

  .cake__caption {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 38px 14px 13px;
    pointer-events: none;
    /* плотнее брифа: на светлом кадре подпись иначе падает до 2,5:1 */
    background: linear-gradient(to top, rgb(44 41 39 / 0.86), rgb(44 41 39 / 0.66) 46%, transparent);
  }

  .cake__name {
    font-weight: 600;
    font-size: calc(var(--fs-body) + 1px);
    line-height: 1.25;
    color: var(--bg);
    text-wrap: balance;
  }

  .cake__meta {
    font-size: 12px;
    line-height: 1.35;
    color: var(--surface);
  }

  @media (min-width: 768px) {
    .cakes__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* три колонки — девятый кадр возвращается, иначе последний ряд рваный */
  @media (min-width: 768px) and (max-width: 1199px) {
    .cakes__grid:not(.is-open) > :global(:nth-child(9)) {
      display: block;
    }

    .cakes__grid:not(:has(> :nth-child(10))) + .cakes__more {
      display: none;
    }
  }

  @media (min-width: 1200px) {
    .cakes__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('[data-cakes-grid]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-cakes-toggle]');

  if (grid && toggle) {
    toggle.addEventListener('click', () => {
      const open = grid.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = open ? 'Свернуть' : 'Показать ещё';
    });
  }
</script>
