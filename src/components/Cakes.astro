---
import Photo from './Photo.astro';
import CustomCake from './CustomCake.astro';
import { cakes, cakeFilters } from '../data/catalog';
import { site } from '../data/site';

// Фильтры и «показать ещё» — на классах, без перерисовки DOM.
---

<section class="section" id="cakes">
  <div class="container">
    <div class="section-head">
      <div>
        <h2>Торты</h2>
        <p class="lead">
          Двенадцать моделей в постоянном меню, каждая — за 48 часов. Цвет и надпись меняем под
          повод, остальное как на фото.
        </p>
      </div>
      <a class="btn btn--secondary btn--sm" href="#custom-cake">Свой торт по картинке</a>
    </div>

    <div class="cakes__filters rail" role="group" aria-label="Фильтр по видам тортов">
      {
        cakeFilters.map((filter, i) => (
          <button
            type="button"
            class="chip"
            data-filter={filter}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {filter}
          </button>
        ))
      }
    </div>

    <div class="cakes__grid" data-cakes-grid>
      {
        cakes.map((cake, i) => (
          <article class="cake" data-tags={[cake.name, ...(cake.tags ?? [])].join('|')}>
            <Photo
              photo={cake.photo}
              ratio="3 / 4"
              eager={i < 4}
              sizes="(min-width: 1200px) 310px, (min-width: 768px) 240px, 45vw"
            >
              <figcaption class="cake__caption">
                <span class="cake__name">{cake.name}</span>
                <span class="cake__meta">{cake.meta}</span>
              </figcaption>
            </Photo>
          </article>
        ))
      }
    </div>

    <p class="cakes__empty" data-cakes-empty hidden>
      В этой подборке пока пусто. Напишите нам — соберём под ваш повод.
    </p>

    <div class="cakes__more">
      <button type="button" class="btn btn--secondary" data-cakes-toggle aria-expanded="false">
        Показать ещё
      </button>
      <p class="cakes__count" data-cakes-count>В витрине {cakes.length} тортов</p>
      <a class="cakes__shop" href={site.shopSections.cakesReady} target="_blank" rel="noopener">
        Торты, которые можно забрать сегодня →
      </a>
    </div>

    <CustomCake />
  </div>
</section>

<style>
  .cakes__filters {
    margin-top: 22px;
    padding-bottom: 6px;
    gap: 8px;
    scroll-snap-type: none;
  }

  .chip {
    flex: none;
    padding: 9px 16px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--bg);
    font-size: 12.5px;
    font-weight: 600;
    color: #4c463d;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.16s ease,
      border-color 0.16s ease,
      color 0.16s ease;
  }

  .chip:hover {
    border-color: var(--text);
  }

  .chip[aria-pressed='true'] {
    background: var(--text);
    border-color: var(--text);
    color: var(--surface);
  }

  .cakes__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap);
    margin-top: 20px;
  }

  /* свёрнутая витрина: два ряда, низ уходит в фейд */
  .cakes__grid:not(.is-expanded) > :nth-child(n + 7) {
    display: none;
  }

  .cakes__grid:not(.is-expanded) {
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 62%,
      rgba(0, 0, 0, 0.32) 88%,
      transparent 100%
    );
    mask-image: linear-gradient(to bottom, #000 62%, rgba(0, 0, 0, 0.32) 88%, transparent 100%);
  }

  /* правило сильнее счётчика выше: отфильтрованное скрыто всегда */
  .cakes__grid > .cake.is-hidden {
    display: none !important;
  }

  .cake__caption {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 38px 14px 13px;
    pointer-events: none;
    background: linear-gradient(to top, rgba(28, 25, 22, 0.82), rgba(28, 25, 22, 0));
  }

  .cake__name {
    font-weight: var(--fw-heading);
    font-size: calc(var(--fs-h3) - 1px);
    line-height: 1.2;
    letter-spacing: var(--ls-heading);
    color: var(--bg);
    text-wrap: balance;
  }

  .cake__meta {
    font-size: 12px;
    color: rgba(255, 250, 237, 0.76);
  }

  .cakes__empty {
    margin-top: 20px;
    font-size: var(--fs-body);
    color: var(--text-4);
  }

  .cakes__more {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 24px;
  }

  .cakes__count {
    font-size: 12.5px;
    color: var(--text-4);
  }

  .cakes__shop {
    font-size: 13px;
    font-weight: 600;
    color: var(--terracotta-text);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--terracotta) 40%, transparent);
  }

  .cakes__shop:hover {
    border-bottom-color: var(--terracotta);
  }

  @media (min-width: 768px) {
    .cakes__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .cakes__shop {
      margin-left: auto;
    }
  }

  @media (min-width: 1200px) {
    .cakes__grid {
      grid-template-columns: repeat(4, 1fr);
    }

    /* четыре колонки — два полных ряда в свёрнутом виде */
    .cakes__grid:not(.is-expanded) > :nth-child(-n + 8) {
      display: block;
    }

    .cakes__grid:not(.is-expanded) > :nth-child(n + 9) {
      display: none;
    }
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('[data-cakes-grid]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-cakes-toggle]');
  const count = document.querySelector<HTMLElement>('[data-cakes-count]');
  const empty = document.querySelector<HTMLElement>('[data-cakes-empty]');
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];

  if (grid && toggle && count) {
    const cards = [...grid.children] as HTMLElement[];
    const total = cards.length;
    let filter = chips[0]?.dataset.filter ?? 'Все';

    const visible = () => cards.filter((card) => !card.classList.contains('is-hidden')).length;

    const sync = () => {
      const shown = visible();
      const expanded = grid.classList.contains('is-expanded');
      const collapsedLimit = window.matchMedia('(min-width: 1200px)').matches ? 8 : 6;
      const hasMore = shown > collapsedLimit;

      toggle.hidden = !hasMore;
      toggle.textContent = expanded ? 'Свернуть' : 'Показать ещё';
      toggle.setAttribute('aria-expanded', String(expanded));

      if (filter === 'Все') {
        count.textContent = expanded ? `Показаны все ${total}` : `В витрине ${total} тортов`;
      } else {
        count.textContent = `${shown} из ${total} подходят`;
      }

      if (empty) empty.hidden = shown > 0;
    };

    toggle.addEventListener('click', () => {
      grid.classList.toggle('is-expanded');
      sync();
    });

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        filter = chip.dataset.filter ?? 'Все';
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        cards.forEach((card) => {
          const tags = card.dataset.tags ?? '';
          card.classList.toggle('is-hidden', filter !== 'Все' && !tags.includes(filter));
        });
        // подборку короче двух рядов не сворачиваем
        grid.classList.toggle('is-expanded', filter !== 'Все');
        sync();
      });
    });

    sync();
  }
</script>
