---
/**
 * Виджет Яндекс.Карт с карточкой организации: рейтинг, часы, телефон и кнопка
 * «как добраться» — всё живое, прямо из Яндекс.Бизнеса.
 *
 * Карта одна: у каждой точки свой `oid`, и виджет показывает ту, которую
 * выбрали в карточках контактов (`[data-map-target]`) — параметр `pt` виджет
 * игнорирует, метки рисует только статическое API, так что две точки разом на
 * одной карте не показать. Iframe подставляется по IntersectionObserver, чтобы
 * скрипты Яндекса не тормозили первую загрузку; без JS работает ссылка из
 * `<noscript>`.
 */
import { places, yandexOrgUrl, yandexWidgetUrl } from '../data/site';
---

<div class="map-block">
  <p class="map-label">
    На карте: <b data-frame-label="map">{places[0].addr}</b>
  </p>

  <div
    class="map"
    data-frame="map"
    data-frame-title="Карта: «Вкусная компания» в Самаре"
    data-src={yandexWidgetUrl(places[0])}
  >
    <div class="map__stub">
      <p class="map__stub-label">Загружаем карту…</p>
    </div>
    <noscript>
      <a
        class="map__fallback"
        href={yandexOrgUrl(places[0].yandexOrg)}
        target="_blank"
        rel="noopener"
      >
        Открыть на Яндекс.Картах
      </a>
    </noscript>
  </div>
</div>

<style>
  .map-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .map-label {
    font-size: 12.5px;
    color: var(--text-4);
  }

  .map-label b {
    font-weight: 600;
    color: var(--text);
  }

  .map {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: repeating-linear-gradient(45deg, #efe7da 0 12px, #eae1d2 12px 24px);
  }

  .map :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .map__stub,
  .map__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .map__stub-label,
  .map__fallback {
    font-size: 13px;
    color: var(--text-4);
    text-decoration: none;
  }

  .map__stub-label {
    padding: 8px 16px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--bg);
  }

  .map.is-loaded .map__stub {
    display: none;
  }

  /* во всю ширину планшета квадратная карта съедает целый экран */
  @media (min-width: 700px) and (max-width: 999px) {
    .map {
      aspect-ratio: 16 / 9;
    }
  }
</style>

<script>
  import '../scripts/lazy-frame';
</script>
