---
/**
 * Карта одна на две точки: виджет показывает карточку организации по `oid`,
 * а параметр `pt` игнорирует — свои метки умеет только статическое API.
 * Точку выбирают кнопки `[data-frame-target="map"]` в контактах.
 */
import { yandexOrgUrl, yandexWidgetUrl } from '../data/site';
import type { Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

const { places } = Astro.props.content;
---

<div class="map-block">
  <p class="map-label">
    На карте: <b data-frame-label="map">{places[0].name}</b>
  </p>

  <div
    class="map"
    data-frame="map"
    data-frame-title="Карта: «Вкусная компания» в Самаре"
    data-src={yandexWidgetUrl(places[0])}
  >
    <div class="map__stub">
      <p class="map__stub-label">Загружаем карту…</p>
    </div>
    <noscript>
      <a
        class="map__fallback"
        href={yandexOrgUrl(places[0].yandex_org)}
        target="_blank"
        rel="noopener"
      >
        Открыть на Яндекс.Картах
      </a>
    </noscript>
  </div>
</div>

<style>
  .map-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .map-label {
    font-size: 12.5px;
    color: var(--text-4);
  }

  .map-label b {
    font-weight: 600;
    color: var(--text);
  }

  .map {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: repeating-linear-gradient(45deg, #efe7da 0 12px, #eae1d2 12px 24px);
  }

  .map :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .map__stub,
  .map__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .map__stub-label,
  .map__fallback {
    font-size: 13px;
    color: var(--text-4);
    text-decoration: none;
  }

  .map__stub-label {
    padding: 8px 16px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--bg);
  }

  .map.is-loaded .map__stub {
    display: none;
  }

  /* во всю ширину планшета квадратная карта съедает целый экран */
  @media (min-width: 700px) and (max-width: 999px) {
    .map {
      aspect-ratio: 16 / 9;
    }
  }
</style>

<script>
  import '../scripts/lazy-frame';
</script>
