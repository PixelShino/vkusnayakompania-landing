---
/**
 * Map band: both venues on one map, always — the owner wants the two pins
 * seen at once, so there is no «zoom to one venue» mode to fall out of. The
 * bar above carries the caption and the links to the venues' cards on Maps;
 * the map runs edge to edge under it with no frame (Green Park). With
 * `PUBLIC_YANDEX_MAPS_KEY` it is the Yandex JS API 3.0 with a labelled marker
 * per venue; without the key it is the iframe widget with a plain pin per
 * venue (`pt`).
 * Полоса карты: обе точки на одной карте, всегда — владелец хочет видеть две
 * метки сразу, поэтому режима «одна точка крупно», из которого не вернуться,
 * нет. На планке сверху подпись и ссылки на карточки точек в Картах; карта
 * под ней от края до края без рамки (Green Park). С ключом
 * `PUBLIC_YANDEX_MAPS_KEY` — JS API 3.0 и подписанная метка на точку; без
 * ключа — iframe-виджет с простой меткой на каждую точку (`pt`).
 */
import { yandexOrgUrl, yandexWidgetUrl } from '../data/site';
import type { Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

const { places } = Astro.props.content;
// ключ выдают в кабинете Яндекса и ограничивают доменами; пусто — ветка виджета
const key = import.meta.env.PUBLIC_YANDEX_MAPS_KEY;

const points = places.map((place) => ({
  id: place.id,
  n: place.n,
  name: place.name,
  lat: place.lat,
  lng: place.lng,
  href: yandexOrgUrl(place.yandex_org),
}));
---

<div class="map-block">
  <div class="container map-bar">
    <p class="tag map-caption">На карте · обе точки</p>
    {/* the cards on Maps (photos, reviews, the route from anywhere) — the one
        place on the page that links to them; the route buttons above lead
        elsewhere / карточки в Картах (фото, отзывы, маршрут откуда угодно) —
        единственное место на странице со ссылками на них; кнопки маршрута
        выше ведут в другое */}
    <p class="map-note">
      На Яндекс Картах:{' '}
      {places.map((place, i) => (
        <>
          {i > 0 && <span aria-hidden="true">{' · '}</span>}
          <a href={yandexOrgUrl(place.yandex_org)} target="_blank" rel="noopener">
            {place.street}
          </a>
        </>
      ))}
    </p>
  </div>

  {
    key ? (
      <div class="map" data-map data-places={JSON.stringify(points)}>
        <div class="map__canvas" data-map-canvas />
        <div class="map__stub">
          <p class="map__stub-title display">Карта</p>
          <p class="tag map__stub-label" data-map-note>
            Загружаем карту…
          </p>
        </div>
      </div>
    ) : (
      <div
        class="map"
        data-frame="map"
        data-frame-title="Карта: «Вкусная компания» в Самаре"
        data-src={yandexWidgetUrl(places)}
      >
        <div class="map__stub">
          <p class="map__stub-title display">Карта</p>
          <p class="tag map__stub-label" data-frame-note>
            Загружаем карту…
          </p>
        </div>
      </div>
    )
  }

  {/* JS off: nothing loads — the label is hidden, the links on the bar stay
      Без JS ничего не грузится — подпись гасим, ссылки на планке остаются */}
  <noscript>
    <style is:inline>
      .map__stub-label {
        display: none;
      }
    </style>
  </noscript>
</div>

<style>
  .map-block {
    margin-top: 28px;
  }

  /* caption left, the links right; on the phone the links drop under the caption
     подпись слева, ссылки справа; на телефоне ссылки уходят под подпись */
  .map-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 24px;
    padding-bottom: 12px;
  }

  .map-note {
    font-size: 12.5px;
    color: var(--text-4);
  }

  .map-note a {
    display: inline-block;
    padding-block: 13px;
    margin-block: -13px;
    font-weight: 600;
    color: var(--text);
    text-decoration-color: var(--line-4);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.16s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .map-note a:hover {
      text-decoration-color: var(--text);
    }
  }

  /* Edge to edge, no frame: the same hatched plate as every photo stub sits
     under the map until it lands. The height is the band's own, not a ratio —
     on the phone a 4:3 frame gave a square, on the desktop a whole screen.
     От края до края, без рамки: та же штрихованная плашка, что у фото-заглушек,
     лежит под картой, пока та не встала. Высота своя, не пропорция — на
     телефоне 4:3 давало квадрат, на десктопе целый экран. */
  .map {
    position: relative;
    width: 100%;
    height: 360px;
    overflow: hidden;
    border-top: 1px solid var(--line);
    background-color: var(--surface-photo);
    background-image: var(--hatch);
  }

  .map :global(iframe),
  .map__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .map__stub {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
    justify-content: center;
    padding: var(--gap);
    text-align: center;
  }

  .map__stub-title {
    font-size: 26px;
    line-height: 1;
  }

  /* `.tag` is the caps line under the title / `.tag` — прописная строка под заголовком */
  .map__stub-label {
    margin-top: 2px;
  }

  .map.is-loaded .map__stub {
    display: none;
  }

  /* полоски читаются как «ещё грузится» — у окончательного отказа фон спокойный */
  .map.is-failed {
    background: var(--surface);
  }

  @media (min-width: 768px) {
    .map-block {
      margin-top: 36px;
    }

    .map {
      height: 440px;
    }
  }

  @media (min-width: 1200px) {
    .map-block {
      margin-top: 44px;
    }

    .map {
      height: 520px;
    }
  }

  /* ── метка карты: круг с номером точки и подпись адреса ──────────────────── */

  /* метку ставят левым верхним углом на координату — сдвигаем круг на точку */
  .map :global(.ymk) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transform: translate(-14px, -14px);
    text-decoration: none;
    white-space: nowrap;
  }

  .map :global(.ymk__dot) {
    width: 28px;
    height: 28px;
    flex: none;
    display: grid;
    place-items: center;
    border: 2px solid var(--bg);
    border-radius: var(--r-pill);
    /* заливка темнее `--terracotta`: на ней цифра цветом `--bg` даёт 6,3:1 */
    background: var(--terracotta-text);
    color: var(--bg);
    font-weight: var(--fw-heading);
    font-size: 14px;
    line-height: 1;
  }

  .map :global(.ymk__label) {
    padding: 5px 11px;
    border: 1px solid var(--line);
    border-radius: var(--r-sq);
    background: var(--bg);
    color: var(--text);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
  }

</style>

<script>
  // каждая ветка сама проверяет свою разметку: лишний модуль просто ничего не делает
  import '../scripts/lazy-frame';
  import '../scripts/yandex-map';
</script>
