---
import { Image } from 'astro:assets';
import tg from '../assets/tg.svg';
import max from '../assets/max.png';
import type { Settings } from '../lib/content.ts';

interface Props {
  settings: Settings;
  variant?: 'dark' | 'light' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  labels?: [string, string];
  class?: string;
}

const {
  settings,
  variant = 'dark',
  size = 'md',
  labels = ['Telegram', 'Max'],
  class: className = '',
} = Astro.props;

const variantClass = {
  dark: 'btn--primary',
  light: 'btn--light',
  ghost: 'btn--secondary',
}[variant];

const sizeClass = size === 'sm' ? 'btn--sm' : size === 'lg' ? '' : 'btn--md';
---

<div class:list={['messengers', className]}>
  <a
    class:list={['btn', variantClass, sizeClass]}
    href={settings.telegram}
    target="_blank"
    rel="noopener"
  >
    <Image src={tg} alt="" width={18} height={18} aria-hidden="true" />
    {labels[0]}
  </a>
  <a
    class:list={['btn', variantClass, sizeClass]}
    href={settings.max}
    target="_blank"
    rel="noopener"
  >
    <Image src={max} alt="" width={18} height={18} densities={[1, 2, 3]} aria-hidden="true" />
    {labels[1]}
  </a>
</div>

<style>
  .messengers {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* делят строку поровну, но не уже своей подписи: текст в кнопке не переносится */
  .messengers > .btn {
    flex: 1 1 auto;
    min-width: max-content;
  }
</style>
