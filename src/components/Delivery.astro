---
/**
 * Ink strip for the app and the shop: the pitch on the left, the store block in
 * the middle, a phone mockup cut off by the bottom edge of the strip.
 * Чернильная полоса про приложение и магазин: слева суть, в середине блок с
 * кнопками магазинов, справа мокап телефона, срезанный нижним краем полосы.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { typo, type Content } from '../lib/content';
import appstore from '../assets/icons/appstore.svg?raw';
import googleplay from '../assets/icons/googleplay.svg?raw';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { settings, home } = content;
const shot = home.app_screenshot;

const STORES = [
  { label: 'App Store', href: settings.app_ios, icon: appstore },
  { label: 'Google Play', href: settings.app_android, icon: googleplay },
].filter((store) => Boolean(store.href));
---

<section class="section strip-ink dl-strip" id="delivery">
  <div class:list={['container', 'dl', { 'dl--solo': !shot }]}>
    <div class="dl__lead">
      <p class="kicker">Доставка</p>
      <h2>{home.delivery_title}</h2>
      {home.delivery_text && <p class="dl__text">{typo(home.delivery_text)}</p>}
    </div>

    <div class="dl__cta">
      {home.delivery_note && <p class="dl__note display">{home.delivery_note}</p>}

      <div class="dl__actions">
        {
          STORES.map((store) => (
            <a class="btn btn--light btn--md dl__store" href={store.href} target="_blank" rel="noopener">
              <span class="icon" aria-hidden="true">
                <Fragment set:html={store.icon} />
              </span>
              {store.label}
            </a>
          ))
        }
        <a class="btn btn--md dl__ghost" href={settings.shop_url} target="_blank" rel="noopener">
          Открыть магазин
        </a>
      </div>
    </div>

    {
      shot && (
        <div class="dl__phone">
          <Image
            class="dl__screen"
            src={shot.src as ImageMetadata}
            width={shot.width}
            height={shot.height}
            alt={shot.alt}
            widths={[240, 480, 640]}
            sizes="(min-width: 1200px) 250px, (min-width: 768px) 220px, 200px"
            format="avif"
            quality={52}
            loading="lazy"
            decoding="async"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  /* the strip bleeds edge to edge and clips the mockup: no inner rounded panel
     полоса идёт от края до края и режет мокап: внутренней панели с радиусом нет */
  .dl-strip {
    overflow: hidden;
  }

  .dl {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    align-items: start;
  }

  /* `--on-ink-2` на чернилах — 6,5:1, тело секции идёт им */
  .dl__text {
    margin-top: 10px;
    font-size: var(--fs-body);
    max-width: 52ch;
  }

  /* выгода — оттиск печати: антиква от 22 px и осветлённая терракота, 5,5:1 */
  .dl__note {
    font-size: clamp(22px, 5.4vw, 27px);
    line-height: 1.14;
    color: var(--terracotta-on-ink);
    text-wrap: balance;
  }

  .dl__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  /* иконка слева: паддинг с её стороны на 2 px меньше — оптическая балансировка */
  .dl__store {
    padding-inline: 16px 18px;
  }

  .icon {
    display: inline-flex;
    flex: none;
    width: 18px;
    height: 18px;
  }

  .icon > :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* на чернилах вторая кнопка держится обводкой: заливка спорила бы с полосой */
  .dl__ghost {
    background: transparent;
    border-color: color-mix(in srgb, var(--on-ink) 55%, transparent);
    color: var(--on-ink);
  }

  .dl__phone {
    position: relative;
    width: 200px;
    height: 415px;
    padding: 8px;
    border-radius: 32px;
    background: var(--text);
    /* корпус `--text` почти сливается с чернилами — отделяем волоском в 1 px */
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--on-ink) 26%, transparent);
    justify-self: center;
    align-self: end;
    /* отрицательный отступ решает, насколько мокап срежется нижним краем полосы */
    margin-bottom: calc(var(--sec-pad) * -1 - 100px);
  }

  .dl__phone :global(img) {
    width: 100%;
    height: 100%;
    border-radius: 24px;
    object-fit: cover;
    object-position: top center;
  }

  @media (hover: hover) and (pointer: fine) {
    .dl__ghost:hover {
      background: transparent;
      border-color: var(--on-ink);
    }
  }

  @media (min-width: 768px) {
    .dl {
      grid-template-columns: minmax(0, 1fr) 260px;
      grid-template-areas:
        'lead phone'
        'cta phone';
      column-gap: calc(var(--gap) + 16px);
      row-gap: 22px;
    }

    .dl--solo {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: 'lead cta';
    }

    .dl__lead {
      grid-area: lead;
    }

    .dl__cta {
      grid-area: cta;
    }

    .dl__phone {
      grid-area: phone;
      width: 220px;
      height: 460px;
      border-radius: 36px;
      margin-bottom: calc(var(--sec-pad) * -1 - 120px);
      transform: rotate(-6deg);
    }

    .dl__phone :global(img) {
      border-radius: 28px;
    }
  }

  @media (min-width: 1200px) {
    .dl {
      /* три занятые колонки вместо двух: пустоты рядом с текстом не остаётся */
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 300px;
      grid-template-areas: 'lead cta phone';
      column-gap: calc(var(--gap) + 20px);
    }

    /* без скриншота колонка мокапа не резервируется — иначе справа дыра 300 px */
    .dl--solo {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: 'lead cta';
    }

    /* первая строка врезки встаёт вровень с первой строкой h2, а не с кикером */
    .dl__cta {
      margin-top: 30px;
    }

    .dl__note {
      font-size: clamp(24px, 2.1vw, 28px);
    }

    .dl__phone {
      width: 250px;
      height: 520px;
      border-radius: 40px;
      /* глубже: мокап задавал высоту полосы и оставлял под текстом мёртвую зону */
      margin-bottom: calc(var(--sec-pad) * -1 - 205px);
    }

    .dl__phone :global(img) {
      border-radius: 32px;
    }
  }
</style>
