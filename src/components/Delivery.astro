---
/**
 * Ink strip about ordering from this site: the pitch under its own mark, three
 * things a guest wants to know before ordering (what there is, how it is
 * confirmed, where to pick it up) and the way in — the catalog. Beside it, the
 * food itself: three dishes from different sections on the page's paper, one
 * large and two small, each a door into its section. On a phone the food comes
 * right after the pitch: appetite first, then the facts, then the button.
 * Чернильная полоса про заказ с этого сайта: суть под своей маркой, три вещи,
 * которые гость хочет знать до заказа (что есть, как подтверждается, где
 * забрать), и вход — каталог. Рядом сама еда: три блюда из разных разделов на
 * бумаге страницы, одно крупное и два малых, и каждое — дверь в свой раздел.
 * На телефоне еда идёт сразу за сутью: сначала аппетит, потом факты, потом кнопка.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { typo, type Content } from '../lib/content';
import { BASE } from '../lib/base.ts';
import { coverOf, photoWidths, positions } from '../lib/catalog.ts';
import { plural } from '../data/site.ts';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { settings, catalog, places } = content;
const hasCatalog = catalog.count > 0;

// three sections that read as a whole menu — breakfast, a hot dish, a cake
// that can come today — and any others with a photo when the catalog names
// them differently; the longest name takes the large photo, where its tag fits
// три раздела, которые читаются как всё меню, — завтрак, горячее, торт,
// который привезут сегодня, — и любые другие с фото, если в каталоге они
// названы иначе; самое длинное имя берёт крупное фото, где его бирка помещается
const PREFERRED = ['torty-v-nalichii', 'zavtraki', 'pasta', 'goryachee', 'pirojnye', 'prazdnichnye-torty'];
const ranked = [
  ...PREFERRED.map((slug) => catalog.categories.find((category) => category.slug === slug)),
  ...catalog.categories,
].filter((category, i, all) => category && all.indexOf(category) === i);
const picked = ranked
  .map((category) => ({ category: category!, cover: coverOf(category!) }))
  .filter((shot) => shot.cover?.photo)
  .slice(0, 3);
const longest = picked.reduce((best, shot, i) => (shot.category.title.length > picked[best].category.title.length ? i : best), 0);
const shots = picked.length ? [picked[longest], ...picked.filter((_, i) => i !== longest)] : picked;

const sections = catalog.categories.length;
const COUNT: Record<number, string> = { 2: 'двух', 3: 'трёх', 4: 'четырёх' };
const POINTS = [
  {
    title: 'Всё меню на одной странице',
    text: hasCatalog
      ? `${sections} ${plural(sections, 'раздел', 'раздела', 'разделов')} и ${positions(catalog.count)} — от завтраков до праздничных тортов, с фото, весом и ценой.`
      : 'От завтраков до праздничных тортов — с фото, весом и ценой.',
  },
  {
    title: 'Подтверждаем звонком',
    text: 'Соберите корзину и оставьте телефон: перезвоним, сверим состав, адрес и время. Оплату обсудим там же.',
  },
  {
    title: places.length > 1 ? `Самовывоз с ${COUNT[places.length] ?? places.length} точек` : 'Самовывоз',
    text: `${places.map((place) => place.name).join(' и ')}. Или доставка по Самаре — стоимость назовём при звонке.`,
  },
];

// the large photo is two thirds of the mosaic, the small ones one third
// крупное фото — две трети мозаики, малые — треть
const SIZES = ['(min-width: 1200px) 340px, (min-width: 768px) 30vw, 62vw', '(min-width: 1200px) 170px, (min-width: 768px) 15vw, 31vw'];
---

<section class="section strip-ink dl-strip" id="delivery">
  <div class:list={['container', 'dl', { 'dl--solo': shots.length < 3 }]}>
    <div class="dl__head" data-reveal>
      <span class="mark dl__mark" aria-hidden="true"></span>
      <h2 class="display-caps dl__title">Доставка и самовывоз</h2>
      <p class="dl__text">
        {
          typo(
            'Завтраки, обеды и десерты нашей кухни и кондитерской — закажите здесь, на сайте, с доставкой по Самаре или заберите сами.',
          )
        }
      </p>
    </div>

    <div class="dl__body" data-reveal>
      <ol class="dl__points" role="list">
        {
          POINTS.map((point, i) => (
            <li class="dl__point">
              <span class="dl__num display tnum" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="dl__point-title">{point.title}</h3>
                <p class="dl__point-text">{typo(point.text)}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="dl__actions">
        {
          hasCatalog ? (
            <a class="btn btn--light" href={`${BASE}catalog/`}>
              <Icon name="bag" class="ico--pop" />
              Открыть каталог
            </a>
          ) : null
        }
        <a class:list={['btn', hasCatalog ? 'btn--ghost-light' : 'btn--light']} href={settings.phoneHref}>
          <Icon name="phone" />
          {hasCatalog ? 'Позвонить' : `Заказать по телефону ${settings.phone}`}
        </a>
      </div>
    </div>

    {
      shots.length === 3 && (
        <ul class="dl__food" role="list" aria-label="Из каталога">
          {shots.map(({ category, cover }, i) => (
            <li class:list={['dl__dish', { 'dl__dish--big': i === 0 }]}>
              <a class="dl__dish-link" href={`${BASE}catalog/#${category.slug}`}>
                <Image
                  src={cover!.photo!.src as ImageMetadata}
                  alt={cover!.photo!.alt}
                  width={Math.min(cover!.photo!.width, 720)}
                  height={Math.round((cover!.photo!.height * Math.min(cover!.photo!.width, 720)) / cover!.photo!.width)}
                  widths={photoWidths(cover!.photo!.width)}
                  sizes={SIZES[i === 0 ? 0 : 1]}
                  format="webp"
                  quality={76}
                  loading="lazy"
                  decoding="async"
                />
                <span class="dl__dish-cap">{category.title}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  /* phone: the pitch, the food, the facts and the button — one column
     телефон: суть, еда, факты и кнопка — одной колонкой */
  .dl {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'head' 'food' 'body';
    gap: 30px;
    align-items: start;
  }

  .dl--solo {
    grid-template-areas: 'head' 'body';
  }

  .dl__head {
    grid-area: head;
  }

  .dl__body {
    grid-area: body;
  }

  /* the mark sits over its column, not on the page axis: the text is pressed
     to its side of the spread (Everest)
     марка стоит над своей колонкой, а не на оси страницы: текст прижат к своей
     стороне разворота (Everest) */
  .dl__mark {
    margin-inline: 0;
    color: var(--terracotta-on-ink);
  }

  .dl__title {
    max-width: 16ch;
    margin-top: 18px;
  }

  /* `--on-ink-2` на чернилах — 6,5:1, тело секции идёт им
     `--on-ink-2` on ink is 6.5:1, the section body takes it */
  .dl__text {
    max-width: 48ch;
    margin-top: 14px;
    font-size: var(--fs-body);
    color: var(--on-ink-2);
    text-wrap: pretty;
  }

  /* Three facts as a numbered list on hairlines — a printed menu's order, not
     three identical cards with icons.
     Три факта нумерованным списком на волосяных линиях — порядок печатного
     меню, а не три одинаковые карточки с иконками. */
  .dl__points {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dl__point {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    gap: 12px;
    padding-block: 14px;
    border-top: 1px solid color-mix(in srgb, var(--on-ink) 18%, transparent);
  }

  .dl__point:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--on-ink) 18%, transparent);
  }

  /* номер — антиква в осветлённой терракоте, 5,5:1 на чернилах */
  .dl__num {
    font-size: 22px;
    line-height: 1;
    color: var(--terracotta-on-ink);
  }

  .dl__point-title {
    font-family: var(--font);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--on-ink);
  }

  .dl__point-text {
    margin-top: 4px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--on-ink-2);
  }

  /* one button per row, the whole width, until the column is wide enough
     for both: two ragged widths stacked read as leftovers
     по кнопке в строку во всю ширину, пока колонка не вместит обе: две рваные
     ширины столбиком читаются остатками */
  .dl__actions {
    display: grid;
    gap: 10px;
    margin-top: 26px;
  }

  /* The food: one large dish and two small ones on the page's paper. The shop
     shoots on white; `multiply` turns the white into the paper of the frame.
     Еда: одно крупное блюдо и два малых на бумаге страницы. Магазин снимает на
     белом; `multiply` делает белое бумагой кадра. */
  .dl__food {
    grid-area: food;
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dl__dish--big {
    grid-row: span 2;
  }

  .dl__dish-link {
    position: relative;
    display: block;
    height: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--r-sq);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: scale 120ms var(--ease-out);
  }

  .dl__dish-link:active {
    scale: 0.96;
  }

  .dl__dish-link:focus-visible {
    outline: 2px solid var(--terracotta-on-ink);
    outline-offset: 3px;
  }

  .dl__dish-link :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
    scale: 1.06;
    transition: scale 520ms var(--ease-out);
  }

  /* the section's name on a paper tag in the corner: says what the photo is
     and where the tap leads
     название раздела на бумажной бирке в углу: говорит, что на фото и куда
     ведёт касание */
  .dl__dish-cap {
    position: absolute;
    left: 8px;
    bottom: 8px;
    max-width: calc(100% - 16px);
    padding: 5px 8px;
    border-radius: var(--r-sq);
    background: var(--bg);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.25;
    text-transform: uppercase;
    color: var(--text);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  @media (hover: hover) and (pointer: fine) {
    .dl__dish-link:hover :global(img) {
      scale: 1.12;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dl__dish-link :global(img) {
      transition: none;
    }
  }

  /* wider: the words on the left, the food beside them, centred on both
     шире: слова слева, еда рядом, по центру обоих блоков */
  @media (min-width: 768px) {
    .dl {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      grid-template-areas: 'head food' 'body food';
      column-gap: calc(var(--gap) + 24px);
      row-gap: 26px;
    }

    .dl__food {
      align-self: center;
    }

    .dl--solo {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'head' 'body';
    }

    .dl__food {
      gap: 10px;
    }

    .dl__dish-cap {
      left: 10px;
      bottom: 10px;
    }
  }

  @media (min-width: 1200px) {
    .dl {
      grid-template-columns: minmax(0, 1fr) 520px;
      column-gap: calc(var(--gap) + 56px);
    }

    .dl--solo {
      grid-template-columns: minmax(0, 760px);
    }

    .dl {
      row-gap: 30px;
    }

    .dl__actions {
      display: flex;
      flex-wrap: wrap;
    }

    .dl__point {
      grid-template-columns: 46px minmax(0, 1fr);
      padding-block: 16px;
    }

    .dl__num {
      font-size: 26px;
    }

    .dl__point-text {
      font-size: 14px;
    }
  }
</style>
