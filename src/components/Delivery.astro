---
/**
 * Ink strip for the app and the shop: the pitch pressed to the left under its
 * own mark, the store block beside it, the real app screen in a squared frame
 * cut off by the bottom edge of the strip — no tilted rounded phone body.
 * Чернильная полоса про приложение и магазин: суть прижата влево под своей
 * маркой, рядом блок магазинов, настоящий экран приложения в квадратном кадре,
 * срезанном нижним краем полосы — без наклонённого скруглённого корпуса.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { typo, type Content } from '../lib/content';
import appstore from '../assets/icons/appstore.svg?raw';
import googleplay from '../assets/icons/googleplay.svg?raw';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { settings, home } = content;
const shot = home.app_screenshot;

const STORES = [
  { label: 'App Store', href: settings.app_ios, icon: appstore },
  { label: 'Google Play', href: settings.app_android, icon: googleplay },
].filter((store) => Boolean(store.href));
---

<section class="section strip-ink dl-strip" id="delivery">
  <div class:list={['container', 'dl', { 'dl--solo': !shot }]}>
    <div class="dl__lead" data-reveal>
      <span class="mark dl__mark" aria-hidden="true"></span>
      <h2 class="display-caps dl__title">{home.delivery_title}</h2>
      {home.delivery_text && <p class="dl__text">{typo(home.delivery_text)}</p>}
    </div>

    <div class="dl__cta">
      {home.delivery_note && <p class="dl__note display">{home.delivery_note}</p>}

      <div class="dl__actions">
        {
          STORES.map((store) => (
            <a class="btn btn--light dl__store" href={store.href} target="_blank" rel="noopener">
              <span class="icon" aria-hidden="true">
                <Fragment set:html={store.icon} />
              </span>
              {store.label}
            </a>
          ))
        }
        <a class="btn btn--ghost-light" href={settings.shop_url} target="_blank" rel="noopener">
          Открыть магазин
        </a>
      </div>
    </div>

    {
      shot && (
        <div class="dl__phone">
          <Image
            class="dl__screen"
            src={shot.src as ImageMetadata}
            width={shot.width}
            height={shot.height}
            alt={shot.alt}
            widths={[240, 480, 640]}
            sizes="(min-width: 1200px) 250px, (min-width: 768px) 220px, 200px"
            format="avif"
            quality={52}
            loading="lazy"
            decoding="async"
          />
          {shot.placeholder && <span class="tag dl__stub-tag">заглушка · заменяется в админке</span>}
        </div>
      )
    }
  </div>
</section>

<style>
  /* the strip bleeds edge to edge and clips the screen: no inner panel
     полоса идёт от края до края и режет экран: внутренней панели нет */
  .dl-strip {
    overflow: hidden;
  }

  .dl {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: start;
  }

  /* the mark sits over its column, not on the page axis: the text is pressed
     to its side of the spread (Everest)
     марка стоит над своей колонкой, а не на оси страницы: текст прижат к своей
     стороне разворота (Everest) */
  .dl__mark {
    margin-inline: 0;
    color: var(--terracotta-on-ink);
  }

  .dl__title {
    max-width: 16ch;
    margin-top: 18px;
  }

  /* `--on-ink-2` на чернилах — 6,5:1, тело секции идёт им
     `--on-ink-2` on ink is 6.5:1, the section body takes it */
  .dl__text {
    max-width: 52ch;
    margin-top: 14px;
    font-size: var(--fs-body);
  }

  /* выгода — оттиск печати: антиква от 22 px и осветлённая терракота, 5,5:1
     the offer is a stamp: the serif from 22 px in lightened terracotta, 5.5:1 */
  .dl__note {
    max-width: 20ch;
    font-size: clamp(22px, 5.4vw, 27px);
    line-height: 1.14;
    color: var(--terracotta-on-ink);
    text-wrap: balance;
  }

  .dl__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  /* иконка слева: паддинг с её стороны на 2 px меньше — оптическая балансировка
     the icon on the left: 2 px less padding on its side — optical balance */
  .dl__store {
    padding-inline: 20px 22px;
  }

  .icon {
    display: inline-flex;
    flex: none;
    width: 18px;
    height: 18px;
  }

  .icon > :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* The screen as a squared frame with a cream hairline, cut by the strip's
     bottom edge; the negative margin sets how deep the cut is.
     Экран квадратным кадром с кремовым волоском, срезанный нижним краем полосы;
     отрицательный отступ задаёт глубину среза. */
  .dl__phone {
    position: relative;
    width: 200px;
    border-radius: var(--r-sq);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--on-ink) 30%, transparent);
    justify-self: center;
    align-self: end;
    overflow: hidden;
    margin-bottom: calc(var(--sec-pad) * -1 - 120px);
  }

  .dl__phone :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--r-sq);
  }

  .dl__stub-tag {
    position: absolute;
    left: 10px;
    bottom: 10px;
    color: var(--on-ink);
  }

  @media (min-width: 768px) {
    .dl {
      grid-template-columns: minmax(0, 1fr) 240px;
      grid-template-areas:
        'lead phone'
        'cta phone';
      column-gap: calc(var(--gap) + 24px);
      row-gap: 28px;
    }

    .dl--solo {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: 'lead cta';
    }

    .dl__lead {
      grid-area: lead;
    }

    .dl__cta {
      grid-area: cta;
    }

    .dl__phone {
      grid-area: phone;
      width: 220px;
      margin-bottom: calc(var(--sec-pad) * -1 - 160px);
    }
  }

  @media (min-width: 1200px) {
    .dl {
      /* три занятые колонки вместо двух: пустоты рядом с текстом не остаётся
         three occupied columns instead of two: no void beside the text */
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) 280px;
      grid-template-areas: 'lead cta phone';
      column-gap: calc(var(--gap) + 40px);
    }

    /* без скриншота колонка экрана не резервируется — иначе справа дыра
       without a screenshot the screen column is not reserved — a hole otherwise */
    .dl--solo {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: 'lead cta';
    }

    /* первая строка врезки встаёт вровень с первой строкой h2, а не с маркой
       the first line of the offer aligns with the first line of h2, not the mark */
    .dl__cta {
      margin-top: 30px;
    }

    .dl__note {
      font-size: clamp(24px, 2.1vw, 28px);
    }

    .dl__phone {
      width: 260px;
      /* глубже: экран задавал высоту полосы и оставлял под текстом мёртвую зону
         deeper: the screen set the strip's height and left dead space under the text */
      margin-bottom: calc(var(--sec-pad) * -1 - 260px);
    }
  }
</style>
