---
/**
 * Five directions of the company as one grid of equal compact cards: circle
 * (venue number or icon) → dashed rule → pill, heading, text, actions. Venue
 * photos moved to the gallery slider below, the cards carry no images.
 * Пять направлений компании одной сеткой одинаковых компактных карточек: круг
 * (номер точки или иконка) → пунктир → пилюля, заголовок, текст, действия.
 * Фото залов уехали в слайдер галереи ниже, в карточках их больше нет.
 */
import OpenStatus from './OpenStatus.astro';
import { menuFor } from '../lib/select';
import type { Content, Direction } from '../lib/content';
import cake from '../assets/icons/cake.svg?raw';
import cloche from '../assets/icons/cloche.svg?raw';
import glasses from '../assets/icons/glasses.svg?raw';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { settings, home, directions, menus } = content;

/** Кнопка карточки: либо ссылка, либо триггер диалога брони (`book`). */
type Action = {
  label: string;
  href?: string;
  book?: string;
  note?: string;
  external?: boolean;
  primary?: boolean;
};

const at = (key: Direction['key']) => directions.find((item) => item.key === key);

const menuHref = (direction: Direction) => menuFor(menus, direction.id)?.file.href ?? null;

// у кафе и ресторана действия одни и те же, адрес уходит в заголовок диалога
// both venue cards share one pair of actions; the dialog title carries the street
const venueActions = (direction: Direction): Action[] => [
  {
    label: 'Забронировать',
    book: direction.place ? `Бронь стола: ${direction.place.street}` : 'Бронь стола',
    primary: true,
  },
  { label: 'Приложение', href: '#delivery' },
];

/**
 * Порядок карточек и их шапка: у точек в круге номер, а в пилюле живой статус,
 * у остальных — иконка и короткое слово. `phone` добавляет телефон к кнопкам.
 * Card order and card top: venues get the venue number and a live status pill,
 * the rest get an icon and a short word. `phone` appends the phone to actions.
 */
const CARDS: {
  key: Direction['key'];
  icon?: string;
  pill?: string;
  phone?: boolean;
  actions: (direction: Direction) => Action[];
}[] = [
  { key: 'cafe', phone: true, actions: venueActions },
  { key: 'restaurant', phone: true, actions: venueActions },
  {
    key: 'confectionery',
    icon: cake,
    pill: '48 часов',
    phone: true,
    actions: (direction) => [
      ...(menuHref(direction)
        ? [{ label: 'Меню', href: menuHref(direction)!, external: true }]
        : []),
      { label: 'В приложении', href: settings.shop_url, external: true },
    ],
  },
  {
    key: 'catering',
    icon: cloche,
    pill: 'выезд',
    phone: true,
    actions: () => [{ label: 'На сайт', href: settings.catering_url, external: true }],
  },
  {
    key: 'banquets',
    icon: glasses,
    pill: 'от 10 гостей',
    actions: () => [
      { label: 'Обсудить банкет', book: 'Банкет', note: 'Скажите дату, число гостей и повод' },
    ],
  },
];

const cards = CARDS.map((row) => ({ ...row, direction: at(row.key) })).filter(
  (row): row is typeof row & { direction: Direction } => row.direction !== undefined,
);
---

<section class="section" id="about">
  <div class="container">
    <div class="section-head">
      <div>
        <h2>{home.about_title}</h2>
        {home.about_text && <p class="lead">{home.about_text}</p>}
      </div>
    </div>

    <div class="dir__grid">
      {
        cards.map(({ direction, icon, pill, phone, actions }) => (
          <article class="dir">
            <div class="card-top">
              <span class="card-mark card-mark--sm">
                {icon ? (
                  <span class="icon" aria-hidden="true">
                    <Fragment set:html={icon} />
                  </span>
                ) : (
                  direction.place?.n
                )}
              </span>
              <span class="card-dash" />
              {pill ? (
                <span class="card-pill">{pill}</span>
              ) : (
                direction.place && <OpenStatus schedule={direction.place.schedule} />
              )}
            </div>

            <h3 class="dir__title">{direction.title}</h3>
            <p class="dir__text">{direction.text}</p>

            {direction.place && (
              <p class="dir__meta">
                Сегодня <OpenStatus schedule={direction.place.schedule} mode="today" class="tnum" />
                <span class="dir__dot"> · </span>
                {direction.place.name}
              </p>
            )}

            <div class="dir__actions">
              {actions(direction).map((action) =>
                action.book ? (
                  <button
                    type="button"
                    class:list={[
                      'btn',
                      'btn--md',
                      action.primary ? 'btn--primary' : 'btn--secondary',
                    ]}
                    data-book={action.book}
                    data-book-note={action.note}
                  >
                    {action.label}
                  </button>
                ) : (
                  <a
                    class:list={[
                      'btn',
                      'btn--md',
                      action.primary ? 'btn--primary' : 'btn--secondary',
                    ]}
                    href={action.href}
                    target={action.external ? '_blank' : undefined}
                    rel={action.external ? 'noopener' : undefined}
                  >
                    {action.label}
                  </a>
                ),
              )}
              {phone && (
                <a class="dir__phone" href={settings.phoneHref}>
                  {settings.phone}
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .dir__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--gap) + 2px);
    align-items: stretch;
    margin-top: 26px;
  }

  .dir {
    display: flex;
    flex-direction: column;
    padding: calc(var(--gap) + 8px);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--surface);
    transition: border-color 0.16s ease;
  }

  .icon {
    display: inline-flex;
    width: 18px;
    height: 18px;
  }

  .icon > :global(svg) {
    width: 100%;
    height: 100%;
  }

  .dir__title {
    margin: 18px 0 8px;
    font-size: calc(var(--fs-h3) + 2px);
    line-height: 1.12;
  }

  .dir__text {
    font-size: var(--fs-body);
    color: var(--text-2);
    /* широкие карточки нижнего ряда не должны тянуть строку до края */
    max-width: 46ch;
  }

  .dir__meta {
    margin-top: 12px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-3);
  }

  .dir__dot {
    color: var(--line-4);
  }

  /* один шаг по обеим осям: перенесённый телефон стоит так же, как соседняя кнопка */
  .dir__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding-top: 20px;
  }

  /* поле нажатия остаётся 42 px, но в поток телефон отдаёт только высоту строки:
     иначе перенесённый на свою строку он отбивается вдвое сильнее, чем кнопки
     the 42 px hit area stays, yet only the text height goes into the flex line:
     otherwise the wrapped phone sits twice as far away as the buttons do */
  .dir__phone {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    margin-block: -10px;
    padding-inline: 4px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--terracotta-text);
    text-decoration: none;
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .dir:hover {
      border-color: var(--line-4);
    }

    .dir__phone:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  /* 2 + 2 + 1: пятая карточка занимает обе колонки, дыры в ряду нет */
  @media (min-width: 768px) {
    .dir__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dir:last-child {
      grid-column: 1 / -1;
    }
  }

  /* 3 + 2 на шести колонках: пять в ряд дают 17 знаков в строке и рвут кнопки */
  @media (min-width: 1200px) {
    .dir__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .dir {
      grid-column: span 2;
    }

    .dir:nth-child(n + 4),
    .dir:last-child {
      grid-column: span 3;
    }
  }
</style>
