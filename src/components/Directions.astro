---
/**
 * Five fixed directions of the company: two big cards with a photo and a venue,
 * three small ones. Buttons come from a table keyed by `direction.key`, so the
 * markup stays free of per-key conditions.
 * Пять направлений компании: две большие карточки с фото и точкой, три малых.
 * Кнопки берутся из таблицы по `direction.key` — в разметке нет условий на ключ.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import OpenStatus from './OpenStatus.astro';
import { menuFor } from '../lib/select';
import type { Content, Direction } from '../lib/content';
import cake from '../assets/icons/cake.svg?raw';
import cloche from '../assets/icons/cloche.svg?raw';
import glasses from '../assets/icons/glasses.svg?raw';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { settings, home, directions, menus } = content;

/** Кнопка карточки: либо ссылка, либо триггер диалога брони (`book`). */
type Action = {
  label: string;
  href?: string;
  book?: string;
  note?: string;
  external?: boolean;
};

const at = (key: Direction['key']) => directions.find((item) => item.key === key);

const bookTitle = (direction: Direction) =>
  direction.place ? `Бронь стола: ${direction.place.street}` : 'Бронь стола';

// same pair of actions on both venue cards; the dialog title carries the street
// у обеих больших карточек кнопки одни и те же, адрес уходит в заголовок диалога
const bigActions = (direction: Direction): Action[] => [
  { label: 'Забронировать', book: bookTitle(direction) },
  { label: 'Приложение', href: '#delivery' },
];

const menuHref = (direction?: Direction) =>
  direction ? (menuFor(menus, direction.id)?.file.href ?? null) : null;

const SMALL: { key: Direction['key']; icon: string; pill: string; actions: Action[] }[] = [
  {
    key: 'confectionery',
    icon: cake,
    pill: '48 часов',
    actions: [
      ...(menuHref(at('confectionery'))
        ? [{ label: 'Меню', href: menuHref(at('confectionery'))!, external: true }]
        : []),
      { label: 'В приложении', href: settings.shop_url, external: true },
    ],
  },
  { key: 'catering', icon: cloche, pill: 'выезд', actions: [{ label: 'На сайт', href: settings.catering_url, external: true }] },
  {
    key: 'banquets',
    icon: glasses,
    pill: 'от 10 гостей',
    actions: [
      { label: 'Обсудить банкет', book: 'Банкет', note: 'Скажите дату, число гостей и повод' },
    ],
  },
];

const big = (['cafe', 'restaurant'] as const).map(at).filter((item) => item !== undefined);
const small = SMALL.map((row) => ({ ...row, direction: at(row.key) })).filter(
  (row) => row.direction !== undefined,
);

// the phone is a text link, not a button: it repeats on every card
// телефон — текстовая ссылка, а не кнопка: он повторяется в каждой карточке
const PHONE_ON: Direction['key'][] = ['cafe', 'restaurant', 'confectionery', 'catering'];
---

<section class="section" id="about">
  <div class="container">
    <div class="section-head">
      <div>
        <h2>{home.about_title}</h2>
        {home.about_text && <p class="lead">{home.about_text}</p>}
      </div>
    </div>

    <div class="dir__grid dir__grid--big">
      {
        big.map((direction) => (
          <article class="dir dir--big">
            {direction.photo && (
              <figure class="media dir__media" style="--ratio: 16 / 9">
                <Image
                  src={direction.photo.src as ImageMetadata}
                  width={direction.photo.width}
                  height={direction.photo.height}
                  alt={direction.photo.alt}
                  widths={[480, 800, 1200, 1600]}
                  sizes="(min-width: 1200px) 640px, (min-width: 768px) 46vw, 92vw"
                  format="avif"
                  quality={52}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            )}

            <div class="dir__body">
              <div class="card-top">
                {direction.place && <span class="card-mark card-mark--sm">{direction.place.n}</span>}
                <span class="card-dash" />
                {direction.place && <OpenStatus schedule={direction.place.schedule} />}
              </div>

              <h3 class="dir__title">{direction.title}</h3>
              <p class="dir__text">{direction.text}</p>

              {direction.place && (
                <p class="dir__meta">
                  Сегодня <OpenStatus schedule={direction.place.schedule} mode="today" class="tnum" />
                  <span class="dir__dot"> · </span>
                  {direction.place.name}
                </p>
              )}

              <div class="dir__actions">
                {bigActions(direction).map((action, i) =>
                  action.book ? (
                    <button
                      type="button"
                      class:list={['btn', 'btn--md', i === 0 ? 'btn--primary' : 'btn--secondary']}
                      data-book={action.book}
                      data-book-note={action.note}
                    >
                      {action.label}
                    </button>
                  ) : (
                    <a
                      class:list={['btn', 'btn--md', i === 0 ? 'btn--primary' : 'btn--secondary']}
                      href={action.href}
                      target={action.external ? '_blank' : undefined}
                      rel={action.external ? 'noopener' : undefined}
                    >
                      {action.label}
                    </a>
                  ),
                )}
                {PHONE_ON.includes(direction.key) && (
                  <a class="dir__phone" href={settings.phoneHref}>
                    {settings.phone}
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="dir__grid dir__grid--small">
      {
        small.map((row) => (
          <article class="dir dir--small">
            <div class="card-top">
              <span class="card-mark card-mark--sm">
                <span class="icon" aria-hidden="true">
                  <Fragment set:html={row.icon} />
                </span>
              </span>
              <span class="card-dash" />
              <span class="card-pill">{row.pill}</span>
            </div>

            <h3 class="dir__title">{row.direction!.title}</h3>
            <p class="dir__text">{row.direction!.text}</p>

            <div class="dir__actions">
              {row.actions.map((action) =>
                action.book ? (
                  <button
                    type="button"
                    class="btn btn--secondary btn--md"
                    data-book={action.book}
                    data-book-note={action.note}
                  >
                    {action.label}
                  </button>
                ) : (
                  <a
                    class="btn btn--secondary btn--md"
                    href={action.href}
                    target={action.external ? '_blank' : undefined}
                    rel={action.external ? 'noopener' : undefined}
                  >
                    {action.label}
                  </a>
                ),
              )}
              {PHONE_ON.includes(row.key) && (
                <a class="dir__phone" href={settings.phoneHref}>
                  {settings.phone}
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .dir__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--gap) + 2px);
    align-items: stretch;
  }

  .dir__grid--big {
    margin-top: 26px;
  }

  .dir__grid--small {
    margin-top: calc(var(--gap) + 2px);
  }

  .dir {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--surface);
    transition: border-color 0.16s ease;
  }

  /* фото 20 + рамка 4 = 24 внешнего радиуса, углы концентричны */
  .dir--big {
    padding: 4px;
  }

  .dir--small {
    padding: calc(var(--gap) + 8px);
  }

  .dir__media {
    --radius: var(--r-lg);
    flex: none;
  }

  .dir__media :global(img) {
    outline: 1px solid rgb(0 0 0 / 0.08);
    outline-offset: -1px;
  }

  .dir__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 18px calc(var(--gap) + 4px) calc(var(--gap) + 4px);
  }

  .icon {
    display: inline-flex;
    width: 18px;
    height: 18px;
  }

  .icon > :global(svg) {
    width: 100%;
    height: 100%;
  }

  .dir__title {
    margin: 18px 0 8px;
    font-size: calc(var(--fs-h3) + 2px);
    line-height: 1.12;
  }

  .dir__text {
    font-size: var(--fs-body);
    color: var(--text-2);
  }

  .dir__meta {
    margin-top: 12px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-3);
  }

  .dir__dot {
    color: var(--line-4);
  }

  .dir__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    margin-top: auto;
    padding-top: 20px;
  }

  .dir__phone {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding-inline: 4px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--terracotta-text);
    text-decoration: none;
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .dir:hover {
      border-color: var(--line-4);
    }

    .dir__phone:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  @media (min-width: 768px) {
    .dir__grid--big {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dir__grid--small {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
