---
import Photo from './Photo.astro';
import type { Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

// зал берётся из галереи первой точки: первый кадр общим планом, дальше детали
const gallery = Astro.props.content.places[0].gallery;
const wide = gallery[0]?.image;
const details = gallery.slice(1, 4);
---

<section class="section" id="room">
  <div class="container">
    <h2>Зал</h2>
    <p class="lead">
      Светло, тихо и пахнет ванилью. Заходите с ноутбуком, с детьми или просто за кофе.
    </p>

    <Photo
      photo={wide}
      ratio="4 / 3"
      ratioMd="16 / 7"
      radius="22px"
      sizes="(min-width: 1200px) 1296px, 100vw"
      class="room__wide"
    />

    <div class="room__grid">
      {
        details.map((item) => (
          <Photo
            photo={item.image}
            ratio="4 / 3"
            sizes="(min-width: 1200px) 420px, (min-width: 768px) 33vw, 100vw"
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  /* класс на корне дочернего `Photo.astro` — нужен `:global` */
  .container > :global(.room__wide) {
    margin-top: 26px;
  }

  .room__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap);
    margin-top: var(--gap);
  }

  @media (min-width: 768px) {
    .room__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
