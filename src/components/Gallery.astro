---
/**
 * One long horizontal strip over the photos of every venue: three frames on a
 * desktop, two on a tablet, one and a peek on a phone; swipe on touch, drag with
 * the mouse, arrows and keys page by one frame. Frames of the second venue
 * follow the first — the guest picks nothing, the address is in every caption.
 * Одна длинная горизонтальная лента по фото всех точек: три кадра на десктопе,
 * два на планшете, кадр с краешком следующего на телефоне; свайп на таче,
 * перетаскивание мышью, стрелки и клавиши листают по кадру. Кадры второй точки
 * идут за первой — выбирать гостю нечего, адрес стоит в подписи каждого кадра.
 */
import Photo from './Photo.astro';
import type { Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

const { places } = Astro.props.content;

// ширина кадра = ширина ленты по колонкам: треть с 1200, половина с 768, 78 % на телефоне
// frame width = strip width per column: a third from 1200, a half from 768, 78 % on a phone
const SIZES = [
  '(min-width: 1440px) 419px',
  '(min-width: 1200px) calc((100vw - 184px) / 3)',
  '(min-width: 834px) 373px',
  '(min-width: 768px) calc((100vw - 88px) / 2)',
  '78vw',
].join(', ');

const shots = places.flatMap((place) =>
  place.gallery.map((shot) => ({
    photo: shot.image,
    caption: [place.name, shot.caption].filter(Boolean).join(' · '),
  })),
);

// один кадр листать некуда: стрелок нет
// nothing to page through with a single frame: no arrows
const many = shots.length > 1;
---

{
  shots.length > 0 && (
    <section class="section" id="gallery" aria-labelledby="gallery-title">
      <div class="container">
        <div class="section-head">
          <div>
            <h2 id="gallery-title">О заведении</h2>
            <p class="lead">
              Два зала в Самаре: кафе на Садовой и ресторан на Советской Армии.
            </p>
          </div>

          {many && (
            <div class="gl__nav">
              <button
                type="button"
                class="gl__arrow"
                data-slider-prev
                aria-disabled="true"
                aria-label="Предыдущее фото"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M14.5 5.5 8 12l6.5 6.5" />
                </svg>
              </button>
              <button
                type="button"
                class="gl__arrow"
                data-slider-next
                aria-label="Следующее фото"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M9.5 5.5 16 12l-6.5 6.5" />
                </svg>
              </button>
            </div>
          )}
        </div>

        <div
          class="gl__rail"
          data-slider-rail
          tabindex="0"
          role="group"
          aria-label="Фотографии залов"
        >
          {shots.map((shot, i) => (
            <div class="gl__slide">
              <Photo
                photo={shot.photo}
                ratio="4 / 3"
                radius="var(--r-lg)"
                sizes={SIZES}
                class="gl__media"
                eager={i < 2}
                priority="low"
              />
              <p class="gl__caption">{shot.caption}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .gl__nav {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
  }

  .gl__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    /* перечислено поимённо: `all` тянул бы за собой и рамку, и размеры */
    transition-property: scale, background-color, border-color, opacity;
    transition-duration: 120ms, 0.16s, 0.16s, 0.16s;
    transition-timing-function: var(--ease-out), ease, ease, ease;
  }

  .gl__arrow:not([aria-disabled='true']):active {
    scale: 0.96;
  }

  .gl__arrow svg {
    width: 20px;
    height: 20px;
  }

  .gl__arrow[aria-disabled='true'] {
    opacity: 0.35;
    cursor: default;
  }

  /* лента выходит за поля до края контейнера, кадры снапятся к левому полю
     the strip bleeds past the padding to the container edge, frames snap to the left padding */
  .gl__rail {
    --slide: 78%;
    display: flex;
    gap: var(--gap);
    margin-top: 26px;
    margin-inline: calc(-1 * var(--pad));
    padding-inline: var(--pad);
    scroll-padding-inline: var(--pad);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }

  .gl__rail.is-dragging {
    scroll-snap-type: none;
    cursor: grabbing;
  }

  .gl__rail :global(img) {
    -webkit-user-drag: none;
    user-select: none;
  }

  .gl__rail::-webkit-scrollbar {
    display: none;
  }

  .gl__slide {
    flex: 0 0 var(--slide);
    min-width: 0;
    scroll-snap-align: start;
  }

  /* `:global` — кадр рисует `Photo.astro`, метки области у него нет */
  .gl__rail :global(.gl__media img) {
    outline: 1px solid rgb(0 0 0 / 0.08);
    outline-offset: -1px;
  }

  .gl__caption {
    margin-top: 10px;
    font-size: 12.5px;
    color: var(--text-4);
  }

  @media (hover: hover) and (pointer: fine) {
    .gl__arrow:not([aria-disabled='true']):hover {
      background: color-mix(in srgb, var(--text) 6%, transparent);
      border-color: var(--line-4);
    }

    .gl__rail {
      cursor: grab;
    }
  }

  @media (min-width: 768px) {
    .gl__rail {
      --slide: calc((100% - var(--gap)) / 2);
      margin-top: 30px;
    }

    .gl__caption {
      margin-top: 12px;
      font-size: 13px;
    }
  }

  @media (min-width: 1200px) {
    .gl__rail {
      --slide: calc((100% - 2 * var(--gap)) / 3);
    }
  }
</style>

<script>
  /**
   * Arrows, keys and mouse drag for the venue strip. Edges are marked with
   * `aria-disabled` rather than `disabled`: a native disabled button drops the
   * keyboard focus to `<body>` mid-scroll.
   * Стрелки, клавиши и перетаскивание мышью для ленты залов. Край помечается
   * `aria-disabled`, а не `disabled`: нативно погашенная кнопка роняет фокус
   * на `<body>` прямо во время прокрутки.
   */
  const rail = document.querySelector<HTMLElement>('[data-slider-rail]');
  const prev = document.querySelector<HTMLButtonElement>('[data-slider-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-slider-next]');
  const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;

  const off = (button: HTMLButtonElement | null) =>
    button?.getAttribute('aria-disabled') === 'true';

  if (rail) {
    const step = () =>
      (rail.firstElementChild?.getBoundingClientRect().width ?? rail.clientWidth) +
      (parseFloat(getComputedStyle(rail).columnGap) || 0);

    const sync = () => {
      // пока секцию пропускает `content-visibility`, кадры не разложены и обе
      // ширины равны: по ним обе стрелки погасли бы навсегда
      // while `content-visibility` skips the section the frames are not laid
      // out and both widths match: judging by them would kill both arrows
      if (rail.scrollWidth <= rail.clientWidth) return;
      const max = rail.scrollWidth - rail.clientWidth - 1;
      prev?.setAttribute('aria-disabled', String(rail.scrollLeft <= 0));
      next?.setAttribute('aria-disabled', String(rail.scrollLeft >= max));
    };

    const go = (direction: number) => {
      if (direction < 0 ? off(prev) : off(next)) return;
      rail.scrollBy({ left: direction * step(), behavior: smooth ? 'smooth' : 'auto' });
    };

    prev?.addEventListener('click', () => go(-1));
    next?.addEventListener('click', () => go(1));
    rail.addEventListener('scroll', sync, { passive: true });

    // снап отбирает нативную прокрутку стрелками, поэтому листаем кадрами сами
    // snap fights the native arrow-key scroll, so we page by frame ourselves
    rail.addEventListener('keydown', (event) => {
      const direction = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
      if (!direction) return;
      event.preventDefault();
      go(direction);
    });

    // мышью ленту тянут как пальцем: на время захвата снап выключен, после
    // отпускания лента сама доснапится к ближайшему кадру
    // the mouse drags the strip like a finger: snap is off while captured and
    // the strip settles on the nearest frame once released
    let dragX = 0;
    let dragLeft = 0;
    rail.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return;
      dragX = event.clientX;
      dragLeft = rail.scrollLeft;
      rail.classList.add('is-dragging');
      rail.setPointerCapture(event.pointerId);
    });
    rail.addEventListener('pointermove', (event) => {
      if (!rail.classList.contains('is-dragging')) return;
      rail.scrollLeft = dragLeft - (event.clientX - dragX);
    });
    const release = () => rail.classList.remove('is-dragging');
    rail.addEventListener('pointerup', release);
    rail.addEventListener('pointercancel', release);

    // ResizeObserver ловит момент, когда секция наконец получила размеры
    // ResizeObserver catches the moment the section finally gets its size
    new ResizeObserver(sync).observe(rail);
  }
</script>
