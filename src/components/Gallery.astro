---
/**
 * Film strip over the photos of every venue: one large frame on the central
 * axis, the neighbours peek in cropped by the viewport edge (Green Park,
 * Levantine). Cream circle arrows sit on the frames, dots below; swipe on
 * touch, drag with the mouse, arrows and keys page by frame. A frame with no
 * photo yet is a hatched plate of the same ratio that says so.
 * Кинолента по фото всех точек: один крупный кадр по центральной оси, соседние
 * подглядывают, обрезанные краем окна (Green Park, Levantine). Кремовые круглые
 * стрелки лежат на кадрах, точки под лентой; свайп, перетаскивание мышью,
 * стрелки и клавиши листают по кадру. Кадр без фото — штрихованная плашка той
 * же пропорции, которая об этом говорит.
 */
import Photo from './Photo.astro';
import { isPlaceholder, type Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

const { places } = Astro.props.content;

// ширина кадра = ширина центрального слота: 60 % окна с 1200 (до 860 px),
// 72 % с 768, 86 % на телефоне
// frame width = the central slot: 60 % of the viewport from 1200 (up to 860 px),
// 72 % from 768, 86 % on a phone
const SIZES = ['(min-width: 1200px) min(860px, 60vw)', '(min-width: 768px) 72vw', '86vw'].join(
  ', ',
);

// The admin marks a stand-in in the file title, but only `alt` reaches the
// strip: both wordings are checked so a real photo is never hidden by a plaque.
// В админке заглушка помечена в заголовке файла, до ленты доходит только `alt`:
// проверяются обе формулировки, чтобы плашка не закрыла настоящее фото.
const isStub = (alt: string) => isPlaceholder(alt) || alt.includes('фото появится позже');

const shots = places.flatMap((place) =>
  place.gallery.map((shot) => {
    const stub = isStub(shot.image.alt);
    return {
      photo: shot.image,
      title: shot.caption || place.name,
      // на плашке предмет кадра уже стоит крупно: под ней остаётся один адрес
      // the plaque already carries the subject: only the address stays below it
      caption: stub ? place.name : [place.name, shot.caption].filter(Boolean).join(' · '),
      stub,
    };
  }),
);

// числительное берётся из данных: с третьей точкой заголовок не должен врать
// the numeral comes from the data: with a third venue the heading must not lie
const COUNT = ['', 'Один зал', 'Два зала', 'Три зала', 'Четыре зала'];
const heading = `${COUNT[places.length] || 'Залы'} в Самаре`;

// один кадр листать некуда: ни стрелок, ни точек
// nothing to page through with a single frame: no arrows, no dots
const many = shots.length > 1;
---

{
  shots.length > 0 && (
    <section class="section gl" id="gallery" aria-labelledby="gallery-title">
      <div class="container head">
        <span class="mark" aria-hidden="true" />
        <h2 id="gallery-title" class="display-caps">
          {heading}
        </h2>
        <p class="lead">
          Кафе на Садовой и ресторан на Советской Армии — кадры обеих точек идут подряд.
        </p>
      </div>

      <div class="gl__strip">
        <div
          class="gl__rail"
          data-slider-rail
          tabindex="0"
          role="group"
          aria-label="Фотографии залов"
        >
          {shots.map((shot, i) => (
            <div class="gl__slide">
              {shot.stub ? (
                <div class:list={['stub', 'gl__stub', i % 2 === 0 && 'stub--ink']}>
                  <span class="stub__title">{shot.title}</span>
                  <span class="stub__meta">заглушка · заменяется в админке</span>
                </div>
              ) : (
                <Photo
                  photo={shot.photo}
                  ratio="16 / 10"
                  radius="var(--r-sq)"
                  sizes={SIZES}
                  class="gl__media"
                  eager={i < 2}
                  priority="low"
                />
              )}
              <p class="tag gl__caption">{shot.caption}</p>
            </div>
          ))}
        </div>

        {many && (
          <>
            <button
              type="button"
              class="gl__arrow gl__arrow--prev"
              data-slider-prev
              aria-disabled="true"
              aria-label="Предыдущее фото"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M14.5 5.5 8 12l6.5 6.5" />
              </svg>
            </button>
            <button
              type="button"
              class="gl__arrow gl__arrow--next"
              data-slider-next
              aria-label="Следующее фото"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M9.5 5.5 16 12l-6.5 6.5" />
              </svg>
            </button>
          </>
        )}
      </div>

      {many && (
        <div class="gl__dots" data-slider-dots role="group" aria-label="Перейти к кадру">
          {shots.map((shot, i) => (
            <button
              type="button"
              class="gl__dot"
              data-slider-dot={i}
              aria-label={`Кадр ${i + 1}: ${shot.title}`}
              aria-current={i === 0 ? 'true' : undefined}
            />
          ))}
        </div>
      )}
    </section>
  )
}

<style>
  /* Frame width per breakpoint. `vw`, not `%`: the arrows sit on the frame's
     edges and need the same length for their offset from the strip's centre.
     Ширина кадра по брейкпоинтам. `vw`, а не `%`: стрелки лежат на краях
     кадра, и им нужна та же длина для отступа от центра ленты. */
  .gl {
    --frame: 86vw;
  }

  /* the strip runs edge to edge under the centred heading
     лента идёт от края до края под заголовком по центру */
  .gl__strip {
    position: relative;
    margin-top: 26px;
  }

  /* The rail is the full viewport; side padding parks the first and last frame
     in the centre, every frame snaps to the centre. No scrollbar: the arrows,
     the dots and the peeking neighbours already say that the strip moves.
     Рельс на всё окно; боковые поля ставят первый и последний кадр в центр,
     каждый кадр снапится к центру. Без скроллбара: стрелки, точки и торчащие
     соседи и так говорят, что лента едет. */
  .gl__rail {
    display: flex;
    gap: var(--gap);
    padding-inline: calc((100% - var(--frame)) / 2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }

  .gl__rail.is-dragging {
    scroll-snap-type: none;
    cursor: grabbing;
  }

  .gl__rail :global(img) {
    -webkit-user-drag: none;
    user-select: none;
  }

  .gl__rail::-webkit-scrollbar {
    display: none;
  }

  .gl__slide {
    flex: 0 0 var(--frame);
    min-width: 0;
    scroll-snap-align: center;
  }

  /* `:global` — кадр рисует `Photo.astro`, метки области у него нет */
  .gl__rail :global(.gl__media img) {
    outline: 1px solid rgb(0 0 0 / 0.08);
    outline-offset: -1px;
  }

  /* the plate repeats the `ratio` of <Photo>: a real shot drops in without a shift
     плашка повторяет `ratio` у <Photo>: настоящий кадр встанет без сдвига */
  .gl__stub {
    aspect-ratio: 16 / 10;
  }

  .gl__caption {
    margin-top: 12px;
    text-align: center;
  }

  /* Cream circle on the frame's edge, vertically centred on the frame (the
     caption below is not counted): the frame is 10/16 of its width high.
     Кремовый круг на краю кадра, по вертикали — в центре кадра (подпись под
     ним не считается): высота кадра — 10/16 его ширины. */
  .gl__arrow {
    position: absolute;
    top: calc(var(--frame) * 10 / 16 / 2);
    z-index: 1;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--bg);
    box-shadow: 0 1px 4px rgb(44 41 39 / 0.25);
    color: var(--text);
    translate: 0 -50%;
    cursor: pointer;
    /* перечислено поимённо: `all` тянул бы за собой и размеры, и тень */
    transition-property: scale, background-color, opacity;
    transition-duration: 120ms, 0.16s, 0.16s;
    transition-timing-function: var(--ease-out), ease, ease;
  }

  /* the arrow sits inside the frame, on the shot itself (Levantine): half a
     circle on bare cream next to the peeking neighbour vanished
     стрелка стоит внутри кадра, прямо на снимке (Levantine): половина круга
     на голом креме рядом с торчащим соседом пропадала */
  .gl__arrow--prev {
    left: calc((100% - var(--frame)) / 2 + 10px);
  }

  .gl__arrow--next {
    right: calc((100% - var(--frame)) / 2 + 10px);
  }

  .gl__arrow:not([aria-disabled='true']):active {
    scale: 0.96;
  }

  .gl__arrow svg {
    width: 20px;
    height: 20px;
  }

  .gl__arrow[aria-disabled='true'] {
    opacity: 0.4;
    cursor: default;
  }

  /* Dots under the strip: the current one is a filled olive circle, the rest
     are hairline rings. Each is a 24 px target with an 8 px mark inside.
     Точки под лентой: текущая — залитый оливковый круг, остальные — кольца в
     волосяную линию. Каждая — цель 24 px с меткой 8 px внутри. */
  .gl__dots {
    display: flex;
    justify-content: center;
    gap: 2px;
    margin-top: 18px;
  }

  .gl__dot {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .gl__dot::before {
    content: '';
    width: 8px;
    height: 8px;
    border: 1px solid var(--olive-dark);
    border-radius: var(--r-pill);
    background: transparent;
    transition-property: background-color;
    transition-duration: 0.16s;
    transition-timing-function: ease;
  }

  .gl__dot[aria-current='true']::before {
    background: var(--olive-dark);
  }

  @media (hover: hover) and (pointer: fine) {
    .gl__arrow:not([aria-disabled='true']):hover {
      background: var(--surface);
    }

    .gl__dot:not([aria-current='true']):hover::before {
      background: color-mix(in srgb, var(--olive-dark) 35%, transparent);
    }

    .gl__rail {
      cursor: grab;
    }
  }

  @media (min-width: 768px) {
    .gl {
      --frame: 72vw;
    }

    .gl__strip {
      margin-top: 32px;
    }

    .gl__arrow {
      width: 44px;
      height: 44px;
    }

    /* inside the frame here too: a circle straddling the edge left half of
       itself on bare cream and read as a smudge when disabled
       и здесь внутри кадра: круг верхом на краю оставлял половину себя на
       голом креме и в выключенном виде читался пятном */
    .gl__arrow--prev {
      left: calc((100% - var(--frame)) / 2 + 14px);
    }

    .gl__arrow--next {
      right: calc((100% - var(--frame)) / 2 + 14px);
    }
  }

  @media (min-width: 1200px) {
    .gl {
      --frame: min(860px, 60vw);
    }

    .gl__caption {
      margin-top: 14px;
    }
  }
</style>

<script>
  /**
   * Arrows, dots, keys and mouse drag for the venue strip. The current frame is
   * the one nearest the rail's centre; edges are marked with `aria-disabled`
   * rather than `disabled`: a native disabled button drops the keyboard focus
   * to `<body>` mid-scroll.
   * Стрелки, точки, клавиши и перетаскивание мышью для ленты залов. Текущий
   * кадр — ближайший к центру рельса; край помечается `aria-disabled`, а не
   * `disabled`: нативно погашенная кнопка роняет фокус на `<body>` прямо во
   * время прокрутки.
   */
  const rail = document.querySelector<HTMLElement>('[data-slider-rail]');
  const prev = document.querySelector<HTMLButtonElement>('[data-slider-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-slider-next]');
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-slider-dot]'));
  const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;

  const off = (button: HTMLButtonElement | null) =>
    button?.getAttribute('aria-disabled') === 'true';

  if (rail) {
    const frames = Array.from(rail.children) as HTMLElement[];

    // offset that puts a frame in the middle of the rail
    // смещение, при котором кадр стоит посередине рельса
    const leftFor = (frame: HTMLElement) =>
      frame.offsetLeft - (rail.clientWidth - frame.offsetWidth) / 2;

    const current = () => {
      const centre = rail.scrollLeft + rail.clientWidth / 2;
      let best = 0;
      let gap = Infinity;
      frames.forEach((frame, i) => {
        const d = Math.abs(frame.offsetLeft + frame.offsetWidth / 2 - centre);
        if (d < gap) {
          gap = d;
          best = i;
        }
      });
      return best;
    };

    const sync = () => {
      // пока секцию пропускает `content-visibility`, кадры не разложены и обе
      // ширины равны: по ним обе стрелки погасли бы навсегда
      // while `content-visibility` skips the section the frames are not laid
      // out and both widths match: judging by them would kill both arrows
      if (rail.scrollWidth <= rail.clientWidth) return;
      const i = current();
      prev?.setAttribute('aria-disabled', String(i === 0));
      next?.setAttribute('aria-disabled', String(i === frames.length - 1));
      dots.forEach((dot, j) => {
        if (j === i) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    const goTo = (i: number) => {
      const frame = frames[Math.max(0, Math.min(frames.length - 1, i))];
      if (!frame) return;
      rail.scrollTo({ left: leftFor(frame), behavior: smooth ? 'smooth' : 'auto' });
    };

    const go = (direction: number) => {
      if (direction < 0 ? off(prev) : off(next)) return;
      goTo(current() + direction);
    };

    prev?.addEventListener('click', () => go(-1));
    next?.addEventListener('click', () => go(1));
    dots.forEach((dot) => dot.addEventListener('click', () => goTo(Number(dot.dataset.sliderDot))));
    rail.addEventListener('scroll', sync, { passive: true });

    // снап отбирает нативную прокрутку стрелками, поэтому листаем кадрами сами
    // snap fights the native arrow-key scroll, so we page by frame ourselves
    rail.addEventListener('keydown', (event) => {
      const direction = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
      if (!direction) return;
      event.preventDefault();
      go(direction);
    });

    // мышью ленту тянут как пальцем: на время захвата снап выключен, после
    // отпускания лента сама доснапится к ближайшему кадру
    // the mouse drags the strip like a finger: snap is off while captured and
    // the strip settles on the nearest frame once released
    let dragX = 0;
    let dragLeft = 0;
    rail.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return;
      dragX = event.clientX;
      dragLeft = rail.scrollLeft;
      rail.classList.add('is-dragging');
      rail.setPointerCapture(event.pointerId);
    });
    rail.addEventListener('pointermove', (event) => {
      if (!rail.classList.contains('is-dragging')) return;
      rail.scrollLeft = dragLeft - (event.clientX - dragX);
    });
    const release = () => {
      if (!rail.classList.contains('is-dragging')) return;
      rail.classList.remove('is-dragging');
      // after a drag the strip settles on the nearest frame by itself
      // после перетаскивания лента сама доезжает до ближайшего кадра
      goTo(current());
    };
    rail.addEventListener('pointerup', release);
    rail.addEventListener('pointercancel', release);

    // ResizeObserver ловит момент, когда секция наконец получила размеры
    // ResizeObserver catches the moment the section finally gets its size
    new ResizeObserver(sync).observe(rail);
  }
</script>
