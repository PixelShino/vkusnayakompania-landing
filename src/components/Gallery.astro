---
/**
 * One long horizontal strip over the photos of every venue: the lead frame is
 * twice as wide, then three per screen on a desktop, two on a tablet, one and a
 * peek on a phone; swipe on touch, drag with the mouse, arrows and keys page by
 * frame. A frame with no photo yet becomes a filled plaque of the same ratio.
 * Одна длинная горизонтальная лента по фото всех точек: первый кадр вдвое шире,
 * дальше три на десктопе, два на планшете, кадр с краешком следующего на
 * телефоне; свайп, перетаскивание мышью, стрелки и клавиши листают по кадру.
 * Кадр без фото становится залитой плашкой той же пропорции.
 */
import Photo from './Photo.astro';
import { isPlaceholder, type Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

const { places } = Astro.props.content;

// ширина кадра = ширина ленты по колонкам: треть с 1200, половина с 768, 78 % на телефоне
// frame width = strip width per column: a third from 1200, a half from 768, 78 % on a phone
const SIZES = [
  '(min-width: 1440px) 419px',
  '(min-width: 1200px) calc((100vw - 184px) / 3)',
  '(min-width: 834px) 373px',
  '(min-width: 768px) calc((100vw - 88px) / 2)',
  '78vw',
].join(', ');

// первый кадр шире прочих — источник ему нужен крупнее
// the lead frame is wider than the rest and needs a larger source
const SIZES_LEAD = [
  '(min-width: 1440px) 858px',
  '(min-width: 1200px) calc((100vw - 184px) / 3 * 2 + 20px)',
  '(min-width: 834px) 507px',
  '(min-width: 768px) calc((100vw - 88px) * 0.68)',
  '88vw',
].join(', ');

// The admin marks a stand-in in the file title, but only `alt` reaches the
// strip: both wordings are checked so a real photo is never hidden by a plaque.
// В админке заглушка помечена в заголовке файла, до ленты доходит только `alt`:
// проверяются обе формулировки, чтобы плашка не закрыла настоящее фото.
const isStub = (alt: string) => isPlaceholder(alt) || alt.includes('фото появится позже');

const shots = places.flatMap((place) =>
  place.gallery.map((shot) => {
    const stub = isStub(shot.image.alt);
    return {
      photo: shot.image,
      n: place.n,
      title: shot.caption || place.name,
      // на плашке предмет кадра уже стоит крупно: под ней остаётся один адрес
      // the plaque already carries the subject: only the address stays below it
      caption: stub ? place.name : [place.name, shot.caption].filter(Boolean).join(' · '),
      stub,
    };
  }),
);

// числительное берётся из данных: с третьей точкой заголовок не должен врать
// the numeral comes from the data: with a third venue the heading must not lie
const COUNT = ['', 'Один зал', 'Два зала', 'Три зала', 'Четыре зала'];
const heading = `${COUNT[places.length] || 'Залы'} в Самаре`;

// один кадр листать некуда: стрелок нет
// nothing to page through with a single frame: no arrows
const many = shots.length > 1;
---

{
  shots.length > 0 && (
    <section class="section" id="gallery" aria-labelledby="gallery-title">
      <div class="container">
        <div class="section-head gl__head">
          <h2 id="gallery-title">{heading}</h2>
          <p class="lead gl__lead">
            Кафе на Садовой и ресторан на Советской Армии — кадры обеих точек идут подряд.
          </p>

          {many && (
            <div class="gl__nav">
              <button
                type="button"
                class="gl__arrow"
                data-slider-prev
                aria-disabled="true"
                aria-label="Предыдущее фото"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M14.5 5.5 8 12l6.5 6.5" />
                </svg>
              </button>
              <button
                type="button"
                class="gl__arrow"
                data-slider-next
                aria-label="Следующее фото"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M9.5 5.5 16 12l-6.5 6.5" />
                </svg>
              </button>
            </div>
          )}
        </div>

        <div
          class="gl__rail"
          data-slider-rail
          tabindex="0"
          role="group"
          aria-label="Фотографии залов"
        >
          {shots.map((shot, i) => (
            <div class="gl__slide">
              {shot.stub ? (
                <div class:list={['gl__stub', i % 2 ? 'gl__stub--warm' : 'gl__stub--ink']}>
                  <span class="card-mark card-mark--sm" aria-hidden="true">
                    {shot.n}
                  </span>
                  <span class="gl__stub-text">
                    <span class="gl__stub-title display">{shot.title}</span>
                    <span class="gl__stub-meta">заглушка · заменяется в админке</span>
                  </span>
                </div>
              ) : (
                <Photo
                  photo={shot.photo}
                  ratio="4 / 3"
                  radius="var(--r-lg)"
                  sizes={i === 0 ? SIZES_LEAD : SIZES}
                  class="gl__media"
                  eager={i < 2}
                  priority="low"
                />
              )}
              <p class="gl__caption">{shot.caption}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  /* заголовок слева, лид справа: столбик оставлял пустой всю правую половину
     heading left, lead right: the stacked pair left the whole right half empty */
  .gl__head h2,
  .gl__lead {
    flex: 1 1 100%;
  }

  .gl__nav {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
  }

  .gl__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    /* перечислено поимённо: `all` тянул бы за собой и рамку, и размеры */
    transition-property: scale, background-color, border-color, opacity;
    transition-duration: 120ms, 0.16s, 0.16s, 0.16s;
    transition-timing-function: var(--ease-out), ease, ease, ease;
  }

  .gl__arrow:not([aria-disabled='true']):active {
    scale: 0.96;
  }

  .gl__arrow svg {
    width: 20px;
    height: 20px;
  }

  .gl__arrow[aria-disabled='true'] {
    opacity: 0.35;
    cursor: default;
  }

  /* лента выходит за поля до края контейнера, кадры снапятся к левому полю
     the strip bleeds past the padding to the container edge, frames snap to the left padding */
  .gl__rail {
    --slide: 78%;
    --slide-lead: 88%;
    display: flex;
    gap: var(--gap);
    margin-top: 22px;
    margin-inline: calc(-1 * var(--pad));
    padding-inline: var(--pad);
    scroll-padding-inline: var(--pad);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }

  .gl__rail.is-dragging {
    scroll-snap-type: none;
    cursor: grabbing;
  }

  .gl__rail :global(img) {
    -webkit-user-drag: none;
    user-select: none;
  }

  .gl__rail::-webkit-scrollbar {
    display: none;
  }

  .gl__slide {
    flex: 0 0 var(--slide);
    min-width: 0;
    scroll-snap-align: start;
  }

  /* доминанта: лента из одинаковых прямоугольников читается как заглушка целиком
     the dominant frame: a strip of equal rectangles reads as one big placeholder */
  .gl__slide:first-child {
    flex-basis: var(--slide-lead);
  }

  /* Wider, never taller: a taller lead breaks the row and leaves a dead band
     under its neighbours. The lead keeps the ordinary frame's height, so its
     ratio is (lead width / ordinary width) x 4/3 — recomputed per breakpoint,
     because those widths are percentages of the rail, not fixed pixels.
     Шире, но не выше: высокая доминанта рвёт ряд и оставляет под соседними
     кадрами пустую полосу. Доминанта держит высоту обычного кадра, поэтому её
     соотношение — (ширина доминанты / ширина обычного) x 4/3, и оно своё на
     каждом брейкпоинте: ширины заданы процентами ленты, а не пикселями. */
  .gl__slide:first-child .gl__stub,
  .gl__slide:first-child :global(.gl__media) {
    /* телефон: 88 / 78 x 4/3 */
    aspect-ratio: 3 / 2;
  }

  .gl__slide:first-child :global(.gl__media img) {
    height: 100%;
    object-fit: cover;
  }

  /* `:global` — кадр рисует `Photo.astro`, метки области у него нет */
  .gl__rail :global(.gl__media img) {
    outline: 1px solid rgb(0 0 0 / 0.08);
    outline-offset: -1px;
  }

  /* Plaque instead of a frame: a fill, not a dashed outline. The ratio repeats
     the `ratio` prop of <Photo>, so a real shot drops in without shifting a pixel.
     Плашка вместо кадра: заливка, а не пунктирная рамка. Пропорция повторяет
     проп `ratio` у <Photo> — настоящий кадр встанет на место без сдвига. */
  .gl__stub {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    aspect-ratio: 4 / 3;
    padding: 14px;
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  /* через одну: сплошная лента чернил монотонна не меньше сплошного крема
     every other one: a solid ink strip is as monotone as a solid cream one */
  .gl__stub--ink {
    background-color: var(--ink);
    background-image: var(--hatch-ink);
  }

  .gl__stub--warm {
    background-color: var(--surface-warm);
    background-image: var(--hatch);
    border: 1px solid var(--line-warm);
  }

  .gl__stub-text {
    display: block;
  }

  .gl__stub-title {
    display: block;
    font-size: clamp(20px, 4.6vw, 23px);
    text-wrap: balance;
  }

  .gl__slide:first-child .gl__stub-title {
    font-size: clamp(22px, 5vw, 26px);
  }

  .gl__stub--ink .gl__stub-title {
    color: var(--on-ink);
  }

  .gl__stub--warm .gl__stub-title {
    color: var(--text);
  }

  .gl__stub-meta {
    display: block;
    margin-top: 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .gl__stub--ink .gl__stub-meta {
    color: var(--on-ink-2);
  }

  .gl__stub--warm .gl__stub-meta {
    color: var(--text-4);
  }

  .gl__caption {
    margin-top: 10px;
    font-size: 12.5px;
    color: var(--text-4);
  }

  @media (hover: hover) and (pointer: fine) {
    .gl__arrow:not([aria-disabled='true']):hover {
      background: color-mix(in srgb, var(--text) 6%, transparent);
      border-color: var(--line-4);
    }

    .gl__rail {
      cursor: grab;
    }
  }

  @media (min-width: 768px) {
    .gl__head h2 {
      flex: 0 1 auto;
    }

    .gl__lead {
      flex: 1 1 20rem;
      max-width: 34rem;
      margin-top: 0;
    }

    .gl__rail {
      --slide: calc((100% - var(--gap)) / 2);
      --slide-lead: calc((100% - var(--gap)) * 0.68);
    }

    /* 0,68 ленты против половины: 1,36 x 4/3 */
    .gl__slide:first-child .gl__stub,
    .gl__slide:first-child :global(.gl__media) {
      aspect-ratio: 16 / 9;
      margin-top: 26px;
    }

    .gl__stub {
      padding: 18px;
    }

    .gl__caption {
      margin-top: 12px;
      font-size: 13px;
    }
  }

  @media (min-width: 1200px) {
    .gl__rail {
      --slide: calc((100% - 2 * var(--gap)) / 3);
      --slide-lead: calc((100% - 2 * var(--gap)) * 2 / 3 + var(--gap));
    }

    /* две колонки с зазором против одной: 2,05 x 4/3 */
    .gl__slide:first-child .gl__stub,
    .gl__slide:first-child :global(.gl__media) {
      aspect-ratio: 2.73;
    }

    .gl__stub {
      padding: 20px;
    }
  }
</style>

<script>
  /**
   * Arrows, keys and mouse drag for the venue strip. Edges are marked with
   * `aria-disabled` rather than `disabled`: a native disabled button drops the
   * keyboard focus to `<body>` mid-scroll.
   * Стрелки, клавиши и перетаскивание мышью для ленты залов. Край помечается
   * `aria-disabled`, а не `disabled`: нативно погашенная кнопка роняет фокус
   * на `<body>` прямо во время прокрутки.
   */
  const rail = document.querySelector<HTMLElement>('[data-slider-rail]');
  const prev = document.querySelector<HTMLButtonElement>('[data-slider-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-slider-next]');
  const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;

  const off = (button: HTMLButtonElement | null) =>
    button?.getAttribute('aria-disabled') === 'true';

  if (rail) {
    const sync = () => {
      // пока секцию пропускает `content-visibility`, кадры не разложены и обе
      // ширины равны: по ним обе стрелки погасли бы навсегда
      // while `content-visibility` skips the section the frames are not laid
      // out and both widths match: judging by them would kill both arrows
      if (rail.scrollWidth <= rail.clientWidth) return;
      const max = rail.scrollWidth - rail.clientWidth - 1;
      prev?.setAttribute('aria-disabled', String(rail.scrollLeft <= 0));
      next?.setAttribute('aria-disabled', String(rail.scrollLeft >= max));
    };

    // The step is measured against the neighbouring frame, not one fixed width:
    // the lead frame is wider, so a single constant would overshoot after it.
    // Шаг считается по соседнему кадру, а не по одной ширине: первый кадр шире,
    // и одна константа промахивалась бы после него.
    const go = (direction: number) => {
      if (direction < 0 ? off(prev) : off(next)) return;
      const snap =
        rail.getBoundingClientRect().left +
        rail.clientLeft +
        (parseFloat(getComputedStyle(rail).paddingLeft) || 0);
      const frames = Array.from(rail.children) as HTMLElement[];
      if (direction < 0) frames.reverse();
      const target = frames.find((frame) => {
        const shift = frame.getBoundingClientRect().left - snap;
        return direction > 0 ? shift > 1 : shift < -1;
      });
      const left = target ? target.getBoundingClientRect().left - snap : direction * rail.clientWidth;
      rail.scrollBy({ left, behavior: smooth ? 'smooth' : 'auto' });
    };

    prev?.addEventListener('click', () => go(-1));
    next?.addEventListener('click', () => go(1));
    rail.addEventListener('scroll', sync, { passive: true });

    // снап отбирает нативную прокрутку стрелками, поэтому листаем кадрами сами
    // snap fights the native arrow-key scroll, so we page by frame ourselves
    rail.addEventListener('keydown', (event) => {
      const direction = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
      if (!direction) return;
      event.preventDefault();
      go(direction);
    });

    // мышью ленту тянут как пальцем: на время захвата снап выключен, после
    // отпускания лента сама доснапится к ближайшему кадру
    // the mouse drags the strip like a finger: snap is off while captured and
    // the strip settles on the nearest frame once released
    let dragX = 0;
    let dragLeft = 0;
    rail.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return;
      dragX = event.clientX;
      dragLeft = rail.scrollLeft;
      rail.classList.add('is-dragging');
      rail.setPointerCapture(event.pointerId);
    });
    rail.addEventListener('pointermove', (event) => {
      if (!rail.classList.contains('is-dragging')) return;
      rail.scrollLeft = dragLeft - (event.clientX - dragX);
    });
    const release = () => rail.classList.remove('is-dragging');
    rail.addEventListener('pointerup', release);
    rail.addEventListener('pointercancel', release);

    // ResizeObserver ловит момент, когда секция наконец получила размеры
    // ResizeObserver catches the moment the section finally gets its size
    new ResizeObserver(sync).observe(rail);
  }
</script>
