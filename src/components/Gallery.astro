---
/**
 * Film strip over the photos of every venue: one large frame on the central
 * axis, the neighbours peek in cropped by the viewport edge (Green Park,
 * Levantine). Cream circle arrows sit on the frames, a progress line below; swipe on
 * touch, drag with the mouse, arrows and keys page by frame. A frame with no
 * photo yet is a hatched plate of the same ratio that says so.
 * Кинолента по фото всех точек: один крупный кадр по центральной оси, соседние
 * подглядывают, обрезанные краем окна (Green Park, Levantine). Кремовые круглые
 * стрелки лежат на кадрах, прогресс-линия под лентой; свайп, перетаскивание мышью,
 * стрелки и клавиши листают по кадру. Кадр без фото — штрихованная плашка той
 * же пропорции, которая об этом говорит.
 */
import Photo from './Photo.astro';
import { isPlaceholder, type Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

const { places } = Astro.props.content;

// ширина кадра = ширина центрального слота: 60 % окна с 1200 (до 860 px),
// 72 % с 768, 86 % на телефоне
// frame width = the central slot: 60 % of the viewport from 1200 (up to 860 px),
// 72 % from 768, 86 % on a phone
const SIZES = ['(min-width: 1200px) min(860px, 60vw)', '(min-width: 768px) 72vw', '86vw'].join(
  ', ',
);

// The admin marks a stand-in in the file title, but only `alt` reaches the
// strip: both wordings are checked so a real photo is never hidden by a plaque.
// В админке заглушка помечена в заголовке файла, до ленты доходит только `alt`:
// проверяются обе формулировки, чтобы плашка не закрыла настоящее фото.
const isStub = (alt: string) => isPlaceholder(alt) || alt.includes('фото появится позже');

const shots = places.flatMap((place) =>
  place.gallery.map((shot) => {
    const stub = isStub(shot.image.alt);
    return {
      photo: shot.image,
      title: shot.caption || place.name,
      // на плашке предмет кадра уже стоит крупно: под ней остаётся один адрес
      // the plaque already carries the subject: only the address stays below it
      caption: stub ? place.name : [place.name, shot.caption].filter(Boolean).join(' · '),
      stub,
    };
  }),
);

// a general photo gallery, not a tour of the halls: the client asked for the
// plain name so any shot — a dish, the showcase, the entrance — fits under it
// общая фотогалерея, а не обход залов: заказчица попросила простое имя, чтобы
// под ним помещался любой кадр — блюдо, витрина, вход
const heading = 'Фотогалерея';

// один кадр листать некуда: ни стрелок, ни точек
// nothing to page through with a single frame: no arrows, no progress line
const many = shots.length > 1;
---

{
  shots.length > 0 && (
    <section class="section gl" id="gallery" aria-labelledby="gallery-title" data-slider>
      <div class="container head" data-reveal>
        <span class="mark" aria-hidden="true" />
        <h2 id="gallery-title" class="display-caps">
          {heading}
        </h2>
      </div>

      <div class="gl__strip">
        <div
          class="gl__rail"
          data-slider-rail
          tabindex="0"
          role="group"
          aria-label="Фотографии залов"
        >
          {shots.map((shot, i) => (
            <div class="gl__slide">
              {shot.stub ? (
                <div class:list={['stub', 'gl__stub', i % 2 === 0 && 'stub--ink']}>
                  <span class="stub__title">{shot.title}</span>
                  <span class="stub__meta">заглушка · заменяется в админке</span>
                </div>
              ) : (
                <Photo
                  photo={shot.photo}
                  ratio="16 / 10"
                  radius="var(--r-sq)"
                  sizes={SIZES}
                  class="gl__media"
                  eager={i < 2}
                  priority="low"
                />
              )}
              <p class="tag gl__caption">{shot.caption}</p>
            </div>
          ))}
        </div>

        {many && (
          <>
            <button
              type="button"
              class="slider-arrow gl__arrow gl__arrow--prev"
              data-slider-prev
              aria-disabled="true"
              aria-label="Предыдущее фото"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M14.5 5.5 8 12l6.5 6.5" />
              </svg>
            </button>
            <button
              type="button"
              class="slider-arrow gl__arrow gl__arrow--next"
              data-slider-next
              aria-label="Следующее фото"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M9.5 5.5 16 12l-6.5 6.5" />
              </svg>
            </button>
          </>
        )}
      </div>

      {many && (
        /* a progress line and a counter under the strip instead of seven dots
           (Pulso, Explora): the filled segment slides to the current frame
           прогресс-линия и счётчик под лентой вместо семи точек (Pulso, Explora):
           залитый отрезок едет к текущему кадру */
        <div class="gl__progress" aria-hidden="true">
          <span class="gl__count tnum">
            <span data-slider-now>01</span> / {String(shots.length).padStart(2, '0')}
          </span>
          <span class="gl__bar">
            <span class="gl__bar-fill" data-slider-fill style={`--n:${shots.length}`} />
          </span>
        </div>
      )}
    </section>
  )
}

<style>
  /* Frame width per breakpoint. `vw`, not `%`: the arrows sit on the frame's
     edges and need the same length for their offset from the strip's centre.
     Ширина кадра по брейкпоинтам. `vw`, а не `%`: стрелки лежат на краях
     кадра, и им нужна та же длина для отступа от центра ленты. */
  .gl {
    --frame: 86vw;
  }

  /* the strip runs edge to edge under the centred heading
     лента идёт от края до края под заголовком по центру */
  .gl__strip {
    position: relative;
    margin-top: 26px;
  }

  /* The rail is the full viewport; side padding parks the first and last frame
     in the centre, every frame snaps to the centre. No scrollbar: the arrows,
     the progress line and the peeking neighbours already say that the strip moves.
     Рельс на всё окно; боковые поля ставят первый и последний кадр в центр,
     каждый кадр снапится к центру. Без скроллбара: стрелки, прогресс и торчащие
     соседи и так говорят, что лента едет. */
  .gl__rail {
    display: flex;
    gap: var(--gap);
    padding-inline: calc((100% - var(--frame)) / 2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }

  .gl__rail.is-dragging {
    scroll-snap-type: none;
    cursor: grabbing;
  }

  .gl__rail :global(img) {
    -webkit-user-drag: none;
    user-select: none;
  }

  .gl__rail::-webkit-scrollbar {
    display: none;
  }

  .gl__slide {
    flex: 0 0 var(--frame);
    min-width: 0;
    scroll-snap-align: center;
  }

  /* `:global` — кадр рисует `Photo.astro`, метки области у него нет */
  .gl__rail :global(.gl__media img) {
    outline: 1px solid rgb(0 0 0 / 0.08);
    outline-offset: -1px;
  }

  /* the plate repeats the `ratio` of <Photo>: a real shot drops in without a shift
     плашка повторяет `ratio` у <Photo>: настоящий кадр встанет без сдвига */
  .gl__stub {
    aspect-ratio: 16 / 10;
  }

  .gl__caption {
    margin-top: 12px;
    text-align: center;
  }

  /* On the frame's edge, vertically centred on the frame (the caption below
     is not counted): the frame is 10/16 of its width high. The circle itself
     is the shared `.slider-arrow`.
     На краю кадра, по вертикали — в центре кадра (подпись под ним не
     считается): высота кадра — 10/16 его ширины. Сам круг — общий
     `.slider-arrow`. */
  .gl__arrow {
    position: absolute;
    top: calc(var(--frame) * 10 / 16 / 2);
    z-index: 1;
    translate: 0 -50%;
  }

  .gl__arrow--prev {
    left: calc((100% - var(--frame)) / 2 + 10px);
  }

  .gl__arrow--next {
    right: calc((100% - var(--frame)) / 2 + 10px);
  }

  /* Progress under the strip: a hairline with one olive segment of 1/n width
     that slides to the current frame — `transform` only. The counter beside it.
     Прогресс под лентой: волосяная линия с одним оливковым отрезком шириной 1/n,
     который едет к текущему кадру — только `transform`. Рядом счётчик. */
  .gl__progress {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 20px;
  }

  .gl__count {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-4);
  }

  .gl__bar {
    position: relative;
    width: 160px;
    height: 1px;
    background: var(--line-4);
  }

  .gl__bar-fill {
    position: absolute;
    top: -1px;
    left: 0;
    width: calc(100% / var(--n, 1));
    height: 3px;
    background: var(--olive-dark);
    transform: translateX(calc(var(--i, 0) * 100%));
    transition: transform 0.4s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    /* кружок делает шаг в ту сторону, куда листает: подсказка направления
       раньше, чем взгляд дойдёт до значка внутри
       the circle steps the way it scrolls: the direction is read before the
       eye reaches the glyph inside it */
    .gl__arrow--prev:not([aria-disabled='true']):hover {
      translate: -3px -50%;
    }

    .gl__arrow--next:not([aria-disabled='true']):hover {
      translate: 3px -50%;
    }

    .gl__rail {
      cursor: grab;
    }
  }

  @media (min-width: 768px) {
    .gl {
      --frame: 72vw;
    }

    .gl__strip {
      margin-top: 32px;
    }

    .gl__arrow {
      width: 44px;
      height: 44px;
    }

    /* inside the frame here too: a circle straddling the edge left half of
       itself on bare cream and read as a smudge when disabled
       и здесь внутри кадра: круг верхом на краю оставлял половину себя на
       голом креме и в выключенном виде читался пятном */
    .gl__arrow--prev {
      left: calc((100% - var(--frame)) / 2 + 14px);
    }

    .gl__arrow--next {
      right: calc((100% - var(--frame)) / 2 + 14px);
    }
  }

  @media (min-width: 1200px) {
    .gl {
      --frame: min(860px, 60vw);
    }

    .gl__caption {
      margin-top: 14px;
    }
  }
</style>

<script>
  import '../scripts/slider.ts';
</script>
