---
/**
 * Live promos as an even grid of squared panels with centred text (Everest):
 * the first carries the discount figure in display type on ink, the rest sit
 * on paper. A panel is a caps heading, one condition and the venue as a label.
 * Живые акции ровной сеткой квадратных панелей с текстом по центру (Everest):
 * первая несёт размер скидки антиквой на чернилах, остальные стоят на бумаге.
 * Панель — заголовок прописными, одно условие и точка подписью.
 */
import { groupByPlace } from '../lib/select';
import { typo, type Place, type Promo } from '../lib/content';

interface Props {
  promos: Promo[];
  places: Place[];
}

const { promos, places } = Astro.props;

// groups keep the «both venues» bucket first; the rest follow the venue order
// группировка ставит «обе точки» первыми, остальные идут в порядке точек
const groups = groupByPlace(promos.map((promo) => ({ promo, place: promo.place?.id ?? null })));
const ordered = [null, ...places.map((place) => place.id)]
  .flatMap((key) => groups.get(key) ?? [])
  .map((row) => row.promo);

// panel copy is cut to the first sentence: nothing is added, only trimmed
// текст режется до первого предложения: ничего не дописываем, только убираем
const oneSentence = (text: string) => text.match(/^[^.!?]*[.!?]/)?.[0] ?? text;

// the ink panel takes the discount figure out of its own title, e.g. «20 %»
// чернильная панель вынимает размер скидки из своего же заголовка, например «20 %»
const [hero, ...rest] = ordered;
const figure = hero?.title.match(/\d+\s*%/)?.[0] ?? null;
const heroTitle = figure
  ? hero.title.replace(figure, ' ').replace(/\s{2,}/g, ' ').replace(/[\s—–-]+$/, '').trim()
  : (hero?.title ?? '');

// address label: the venue name, or «обе точки» for a network-wide promo
// подпись адреса: имя точки, у общей акции — «обе точки»
const addr = (promo: Promo) => promo.place?.name ?? 'Обе точки';
---

{
  ordered.length > 0 && (
    <section class="section" id="promos">
      <div class="container">
        <div class="head">
          <span class="mark" aria-hidden="true" />
          <h2 class="display-caps">Акции</h2>
        </div>

        <div class="pr__grid">
          <article class="pr pr--ink">
            {figure && <p class="pr__figure display">{figure}</p>}
            <h3 class="pr__title">{heroTitle}</h3>
            <p class="pr__text">{typo(oneSentence(hero.text))}</p>
            <p class="tag pr__addr">{addr(hero)}</p>
          </article>

          {rest.map((promo) => (
            <article class="pr">
              <h3 class="pr__title">{typo(promo.title)}</h3>
              <p class="pr__text">{typo(oneSentence(promo.text))}</p>
              <p class="tag pr__addr">{addr(promo)}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  /* equal panels: the grid stretches every row to its tallest panel
     ровные панели: сетка тянет каждый ряд до самой высокой панели */
  .pr__grid {
    display: grid;
    gap: var(--gap);
    margin-top: 30px;
  }

  /* text on the central axis of the panel, the label pushed to the bottom
     текст по центральной оси панели, подпись прижата к низу */
  .pr {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 30px 24px 26px;
    border: 1px solid var(--line);
    border-radius: var(--r-sq);
    background: var(--surface);
    text-align: center;
  }

  /* ink is set here, not via `.strip-ink`: the scoped `.pr` background would
     win over the global class and leave cream text on cream
     чернила заданы здесь, а не через `.strip-ink`: скоуповый фон `.pr`
     перебил бы глобальный класс и оставил бы кремовый текст на креме */
  .pr--ink {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--on-ink);
  }

  .pr--ink .pr__text {
    color: var(--on-ink-2);
  }

  .pr--ink .pr__addr {
    color: var(--on-ink-2);
  }

  /* the figure leads the panel and stays on one line at any width
     цифра ведёт панель и не переносится ни на какой ширине */
  .pr__figure {
    margin-bottom: 8px;
    font-size: clamp(56px, 12vw, 64px);
    line-height: 1;
    color: var(--terracotta-on-ink);
    white-space: nowrap;
  }

  /* caps grotesque with tracking, one weight: the title is a label, the
     antiqua is kept for the figure and the section heading
     гротеск прописными вразрядку, один вес: заголовок — подпись, антиква
     остаётся цифре и заголовку секции */
  .pr__title {
    max-width: 24ch;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .pr__text {
    max-width: 38ch;
    margin-top: 10px;
    font-size: var(--fs-body);
    color: var(--text-2);
  }

  .pr__addr {
    margin-top: auto;
    padding-top: 18px;
  }

  @media (min-width: 768px) {
    .pr__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 36px;
    }

    .pr {
      padding: 40px 32px 32px;
    }

    .pr__title {
      font-size: 15px;
    }
  }

  @media (min-width: 1200px) {
    .pr {
      padding: 48px 40px 36px;
    }
  }
</style>
