---
/**
 * Footer: legal line and documents come from the admin panel, so an unfilled
 * field simply does not render.
 * Подвал: юрстрока и документы приходят из админки — незаполненное поле просто
 * не рисуется, заглушек «ИНН —» не бывает.
 */
import { BRAND } from '../data/site';
import { footerLinksFor } from '../lib/nav.ts';
import type { Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { settings } = content;

const footerLinks = footerLinksFor(content);
const year = new Date().getFullYear();

const legal = [
  settings.legal_name,
  settings.inn && `ИНН ${settings.inn}`,
  settings.ogrn && `ОГРН ${settings.ogrn}`,
  settings.legal_address,
]
  .filter(Boolean)
  .join(' · ');

const docs = [
  { label: 'Политика', href: settings.policy?.href },
  { label: 'Оферта', href: settings.offer?.href },
].filter((doc) => Boolean(doc.href)) as { label: string; href: string }[];
---

<footer class="footer">
  <div class="container footer__in">
    <div class="footer__col">
      <p class="footer__brand">{BRAND.name}</p>
      <p class="footer__legal">© {year} · {BRAND.city}</p>
      {legal && <p class="footer__legal">{legal}</p>}

      {
        docs.length > 0 && (
          <nav class="footer__docs" aria-label="Документы">
            {docs.map((doc) => (
              <a href={doc.href} target="_blank" rel="noopener">
                {doc.label}
              </a>
            ))}
          </nav>
        )
      }
    </div>

    <nav class="footer__links" aria-label="Дополнительные ссылки">
      {footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</footer>

<style>
  .footer {
    margin-top: 20px;
    padding-block: calc(var(--sec-pad) * 0.6);
    background: var(--surface);
  }

  .footer__in {
    display: flex;
    flex-direction: column;
    gap: 20px;
    justify-content: space-between;
    align-items: flex-start;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 46ch;
  }

  .footer__brand {
    margin-bottom: 2px;
    font-weight: var(--fw-heading);
    font-size: 19px;
    letter-spacing: var(--ls-heading);
  }

  .footer__legal {
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-4);
  }

  .footer__docs {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 4px;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .footer__docs a,
  .footer__links a {
    font-size: 12.5px;
    text-decoration: none;
    border-bottom: 1px solid var(--line-4);
  }

  .footer__docs a:hover,
  .footer__links a:hover {
    border-bottom-color: var(--text);
  }

  .footer__docs a {
    color: var(--text-4);
  }

  @media (min-width: 1200px) {
    .footer__in {
      flex-direction: row;
      align-items: flex-end;
    }
  }
</style>
