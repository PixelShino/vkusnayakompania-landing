---
import montserratCyrillic from '@fontsource-variable/montserrat/files/montserrat-cyrillic-wght-normal.woff2?url';
import montserratLatin from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import '../styles/global.css';

// `@font-face` объявлены руками вместо импорта всего пакета: тот тянет ещё
// `latin-ext`, `cyrillic-ext` и `vietnamese` — 100+ КБ, которые страница
// подтягивала на старте и которых на ней нет ни одного символа.
// `unicode-range` скопированы из `unicode.json` пакета.
const fontFaces = `
@font-face {
  font-family: 'Montserrat Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url(${montserratCyrillic}) format('woff2');
  unicode-range: U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116;
}
@font-face {
  font-family: 'Montserrat Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url(${montserratLatin}) format('woff2');
  unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
`;
import { site, places, yandexOrgUrl, schemaHours } from '../data/site';
import { getImage } from 'astro:assets';
import { heroPhotos, photoSrcset, PHOTO_WIDTHS } from '../data/catalog';

// снимок первого экрана — он же LCP; браузер узнаёт о нём из preload, не дожидаясь
// разбора страницы, а `sizes` повторяет то, что стоит в `Hero.astro`
const heroSizes = '(min-width: 1200px) 520px, (min-width: 768px) 45vw, 100vw';
const heroSrcset = heroPhotos.tall.file
  ? (
      await getImage({
        src: heroPhotos.tall.file,
        widths: PHOTO_WIDTHS,
        format: 'avif',
        quality: 52,
      })
    ).srcSet.attribute
  : photoSrcset(heroPhotos.tall.id);

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com');
const ogImage = new URL('/og.jpg', canonical);

// Разметка организации: две точки одной кондитерской. Адреса, координаты,
// часы и оценки — с карточек организации на Яндекс.Картах (см. `data/site.ts`).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': places.map((place) => ({
    '@type': 'Bakery',
    '@id': `${canonical.origin}/#place-${place.n}`,
    name: `${site.name} — ${place.addr}`,
    description: site.description,
    telephone: site.phone,
    url: canonical.origin,
    sameAs: [yandexOrgUrl(place.yandexOrg)],
    priceRange: '₽₽',
    servesCuisine: ['Кондитерская', 'Завтраки', 'Кофе'],
    address: {
      '@type': 'PostalAddress',
      streetAddress: place.addr,
      addressLocality: site.city,
      addressCountry: 'RU',
    },
    geo: { '@type': 'GeoCoordinates', latitude: place.lat, longitude: place.lng },
    hasMap: yandexOrgUrl(place.yandexOrg),
    image: ogImage.href,
    openingHours: schemaHours(place.schedule),
    // aggregateRating сознательно нет: оценки собраны Яндексом, а Google
    // запрещает переносить в разметку рейтинги с чужих площадок. На странице
    // цифры остаются — со ссылкой на источник.
  })),
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#FFFAED" />

    <style is:global set:html={fontFaces}></style>
    <link rel="preload" as="font" type="font/woff2" href={montserratCyrillic} crossorigin />

    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link
      rel="preload"
      as="image"
      imagesrcset={heroSrcset}
      imagesizes={heroSizes}
      fetchpriority="high"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <a class="skip-link" href="#main">К основному содержимому</a>
    <slot />

    <style is:global>
      .skip-link {
        position: absolute;
        left: 50%;
        top: 8px;
        z-index: 100;
        translate: -50% -200%;
        padding: 10px 18px;
        border-radius: var(--r-pill);
        background: var(--text);
        color: var(--bg);
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: translate 0.18s ease;
      }
      .skip-link:focus-visible {
        translate: -50% 0;
      }
    </style>
  </body>
</html>
