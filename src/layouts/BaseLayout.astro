---
import montserratCyrillic from '@fontsource-variable/montserrat/files/montserrat-cyrillic-wght-normal.woff2?url';
import montserratLatin from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import prataCyrillic from '@fontsource/prata/files/prata-cyrillic-400-normal.woff2?url';
import prataLatin from '@fontsource/prata/files/prata-latin-400-normal.woff2?url';
import '../styles/global.css';

// `@font-face` вручную вместо импорта пакета: он объявляет ещё `latin-ext`,
// `cyrillic-ext` и `vietnamese` — 100+ КБ подмножеств, которых тут нет.
// `unicode-range` — из `unicode.json` пакета.
const fontFaces = `
@font-face {
  font-family: 'Montserrat Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url(${montserratCyrillic}) format('woff2');
  unicode-range: U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116;
}
@font-face {
  font-family: 'Montserrat Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url(${montserratLatin}) format('woff2');
  unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
@font-face {
  font-family: 'Prata';
  font-style: normal;
  font-display: swap;
  font-weight: 400;
  src: url(${prataCyrillic}) format('woff2');
  unicode-range: U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116;
}
@font-face {
  font-family: 'Prata';
  font-style: normal;
  font-display: swap;
  font-weight: 400;
  src: url(${prataLatin}) format('woff2');
  unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
/* Metric-matched stand-ins for the swap window: Georgia and Arial are scaled
   to Prata's and Montserrat's average advance width, so the fallback takes the
   same space and the layout does not jump when the web font lands. Values are
   measured from the font files (fontTools): size-adjust = avg width ratio over
   a Russian-frequency sample, ascent/descent = the web font's, divided by the
   size-adjust. Without this the wider fallback pushed the «образец» tag onto
   the menu name for the first second of every visit.
   Запасные начертания под метрики: Georgia и Arial масштабированы к средней
   ширине знака Prata и Montserrat, поэтому занимают то же место, и раскладка
   не прыгает, когда веб-шрифт долетает. Значения сняты с файлов шрифтов
   (fontTools): size-adjust — отношение средних ширин по частотам русских букв,
   ascent/descent — метрики веб-шрифта, поделённые на size-adjust. Без этого
   более широкий запасной шрифт наезжал ярлыком «образец» на название меню
   первую секунду каждого визита. */
@font-face {
  font-family: 'Prata Fallback';
  src: local('Georgia');
  size-adjust: 108.7%;
  ascent-override: 91.4%;
  descent-override: 33.3%;
  line-gap-override: 0%;
}
@font-face {
  font-family: 'Montserrat Fallback';
  src: local('Arial');
  size-adjust: 109.6%;
  ascent-override: 88.3%;
  descent-override: 22.9%;
  line-gap-override: 0%;
}
`;
import { getImage, Image } from 'astro:assets';
import logo from '../assets/logo.png';
import BookingDialog from '../components/BookingDialog.astro';
import StickyBar from '../components/StickyBar.astro';
import { BRAND, schemaHours, yandexOrgUrl } from '../data/site';
import { HERO_SIZES, widthsFor } from '../lib/hero.ts';
import type { Content } from '../lib/content.ts';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { home, settings, places } = content;

const title = home.seo_title;
const description = home.seo_description;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com');

// на превью-сборке сайт лежит в подкаталоге, поэтому файлы из `public` — через `base`
const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path}`;

// превью не должно попасть в поиск и конкурировать с боевым доменом
const isPreview = canonical.hostname !== 'vkus-com.ru';
const noindex = isPreview || !home.robots_index;

// preload снимка первого экрана; `sizes` общий с `Hero.astro`
const heroSrcset = (
  await getImage({
    src: home.hero_image.src,
    width: home.hero_image.width,
    height: home.hero_image.height,
    widths: widthsFor(home.hero_image.width),
    format: 'avif',
    quality: 52,
  })
).srcSet.attribute;

// OG-картинка режется под 1200×630; без неё остаётся статичная из `public`
const ogImage = home.og_image
  ? new URL(
      (
        await getImage({
          src: home.og_image.src,
          width: 1200,
          height: 630,
          fit: 'cover',
          format: 'jpeg',
        })
      ).src,
      canonical,
    )
  : new URL(asset('og.jpg'), canonical);

// Разметка организации: две точки одной компании.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': places.map((place) => ({
    // кондитерская печёт, ресторан кормит: рубрика у точек разная
    '@type': place.kind.toLowerCase().includes('ресторан') ? 'Restaurant' : 'Bakery',
    '@id': `${canonical.origin}/#place-${place.n}`,
    name: `${BRAND.name} — ${place.name}`,
    description,
    telephone: place.phone,
    url: canonical.origin,
    sameAs: [yandexOrgUrl(place.yandex_org)],
    priceRange: '₽₽',
    servesCuisine: place.kind.toLowerCase().includes('ресторан')
      ? ['Европейская', 'Завтраки', 'Десерты']
      : ['Кондитерская', 'Завтраки', 'Кофе'],
    address: {
      '@type': 'PostalAddress',
      streetAddress: place.name,
      addressLocality: BRAND.city,
      addressCountry: 'RU',
    },
    geo: { '@type': 'GeoCoordinates', latitude: place.lat, longitude: place.lng },
    hasMap: yandexOrgUrl(place.yandex_org),
    image: ogImage.href,
    openingHours: schemaHours(place.schedule),
    // без aggregateRating: Google запрещает переносить в разметку оценки
    // с чужих площадок, а собственных отзывов у сайта нет
  })),
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#FFFAED" />

    {/* `js` unlocks the scroll reveals (without it every block stays visible);
        the opening curtain runs once per tab — a repeat load skips it.
        `js` включает появление при прокрутке (без него всё видно сразу);
        занавес идёт один раз на вкладку — повторная загрузка его пропускает */}
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (sessionStorage.getItem('vk-opened')) document.documentElement.classList.add('no-curtain');
        else sessionStorage.setItem('vk-opened', '1');
      } catch {}
    </script>
    <style is:global set:html={fontFaces}></style>
    <link rel="preload" as="font" type="font/woff2" href={montserratCyrillic} crossorigin />
    <link rel="preload" href={prataCyrillic} as="font" type="font/woff2" crossorigin />

    <link
      rel="preload"
      as="image"
      imagesrcset={heroSrcset}
      imagesizes={HERO_SIZES}
      fetchpriority="high"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    {
      settings.metrika_id && (
        <script is:inline define:vars={{ metrikaId: settings.metrika_id }}>
          {`(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
          m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
          (window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');
          ym(Number(metrikaId),'init',{clickmap:true,trackLinks:true,accurateTrackBounce:true});`}
        </script>
      )
    }
  </head>
  <body>
    {/* Opening curtain: ink with the logo, lifts on its own — never waits for
        anything, so it costs the first paint nothing (CSS only, see global.css).
        Занавес открытия: чернила с логотипом, поднимается сам — ничего не ждёт,
        поэтому первой отрисовке ничего не стоит (только CSS, см. global.css) */}
    <div class="curtain" aria-hidden="true">
      <Image src={logo} alt="" width={440} height={192} class="curtain__logo" loading="eager" />
    </div>
    <a class="skip-link" href="#main">К основному содержимому</a>
    <slot />

    {
      settings.metrika_id && (
        <noscript>
    <style is:inline>
      /* без JS час не посчитать: пустая рамка вместо плашки хуже её отсутствия */
      .open-pill {
        display: none !important;
      }
    </style>
          <div>
            <img
              src={`https://mc.yandex.ru/watch/${settings.metrika_id}`}
              style="position:absolute;left:-9999px"
              alt=""
            />
          </div>
        </noscript>
      )
    }

    <StickyBar settings={settings} />
    <script>
      import '../scripts/reveal';
    </script>
    <BookingDialog settings={settings} places={places} note={home.contacts_note} />
  </body>
</html>
